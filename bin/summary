#!/usr/bin/env bash
#
# Summarise benchmark results into pass-rate and aggregate tables.
# All arguments are passed through to benchmark/summary.py.
#
# Usage:
#   bin/summary                                    # default tables
#   bin/summary --checks                           # per-check pass rates
#   bin/summary --phase                            # per-phase pass rates
#   bin/summary --checks --category bugs           # check detail for bugs
#   bin/summary --format ape,markdown              # compare two formats
#   bin/summary --checks --scenario dry_run_mode   # checks for one scenario
#
# Run bin/summary -h for full option list.

set -euo pipefail
REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
exec python3 "$REPO_ROOT/benchmark/summary.py" "$@"
