<?xml version="1.0" encoding="UTF-8"?>
<xs:schema
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:ape="https://ape-lang.dev/schema/0"
  targetNamespace="https://ape-lang.dev/schema/0"
  elementFormDefault="qualified">

  <!-- ============================================================
       APE Schema

       This schema validates SHAPE, not semantics.
       Use the APE validator for: required children, reference
       resolution, scope rules, mutual exclusivity, ordering,
       global ID uniqueness, and flow-control attribute rules.
       ============================================================ -->

  <!-- ====================
       Simple Types
       ==================== -->

  <xs:simpleType name="identifierType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[a-z][a-z0-9_-]*" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="variableTypeEnum">
    <xs:restriction base="xs:string">
      <xs:enumeration value="string" />
      <xs:enumeration value="number" />
      <xs:enumeration value="boolean" />
      <xs:enumeration value="list" />
    </xs:restriction>
  </xs:simpleType>


  <xs:simpleType name="askType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="text" />
      <xs:enumeration value="confirm" />
      <xs:enumeration value="choice" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="writeModeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="create" />
      <xs:enumeration value="append" />
      <xs:enumeration value="overwrite" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="outputPositionType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="append" />
      <xs:enumeration value="prepend" />
      <xs:enumeration value="replace" />
    </xs:restriction>
  </xs:simpleType>

  <!-- ====================
       Reusable Groups

       These groups define what categories of elements
       can appear inside various containers.
       ==================== -->

  <!-- Declarations: can appear in meta, root, steps, or any block.
       All declarations are standalone elements; proximity handles grouping. -->
  <xs:group name="declarationGroup">
    <xs:choice>
      <xs:element name="var" type="ape:varType" />
      <xs:element name="param" type="ape:paramType" />
      <xs:element name="resource" type="ape:resourceDeclType" />
      <xs:element name="command" type="ape:commandType" />
      <xs:element name="template" type="ape:templateType" />
    </xs:choice>
  </xs:group>

  <!-- Decorators: structural guidance that can appear inside any block.
       Singular forms are standalone; proximity handles grouping.
       <note> is NOT in this group — it is a prose element and only
       allowed in prose/mixed contexts (instruction, step, root). -->
  <xs:group name="decoratorGroup">
    <xs:choice>
      <xs:element name="constraint" type="xs:string" />
      <xs:element name="rule" type="xs:string" />
      <xs:element name="anti-pattern" type="xs:string" />
      <xs:element name="principle" type="ape:principleType" />
    </xs:choice>
  </xs:group>

  <!-- Tool tags: map to specific LLM tools -->
  <xs:group name="toolTagGroup">
    <xs:choice>
      <xs:element name="read" type="ape:readType" />
      <xs:element name="write" type="ape:writeType" />
      <xs:element name="edit" type="ape:editType" />
      <xs:element name="glob" type="ape:globType" />
      <xs:element name="grep" type="ape:grepType" />
      <xs:element name="web-search" type="ape:webSearchType" />
      <xs:element name="web-fetch" type="ape:webFetchType" />
      <xs:element name="ask-user-question" type="ape:askUserQuestionType" />
    </xs:choice>
  </xs:group>

  <!-- Behavioral tags: invoke execution patterns -->
  <xs:group name="behaviorTagGroup">
    <xs:choice>
      <xs:element name="interview-mode" type="ape:interviewModeType" />
      <xs:element name="plan-mode" type="ape:planModeType" />
      <xs:element name="agents-in-parallel" type="ape:agentsInParallelType" />
      <xs:element name="stop" type="ape:stopType" />
      <xs:element name="subagent-stop" type="ape:subagentStopType" />
    </xs:choice>
  </xs:group>

  <!-- Action children: executable elements that live inside <action> -->
  <xs:group name="actionChildGroup">
    <xs:choice>
      <xs:element name="command" type="ape:commandType" />
      <xs:element name="resource" type="ape:resourceDeclType" />
      <xs:element name="output" type="ape:outputType" />
      <xs:group ref="ape:toolTagGroup" />
      <xs:group ref="ape:behaviorTagGroup" />
    </xs:choice>
  </xs:group>

  <!-- Step-level executable content: things that produce work inside a step -->
  <xs:group name="stepContentGroup">
    <xs:choice>
      <xs:element name="action" type="ape:actionType" />
      <xs:element name="conditional" type="ape:conditionalType" />
      <xs:element name="each" type="ape:eachType" />
      <xs:element name="sequence" type="ape:sequenceType" />
      <xs:group ref="ape:toolTagGroup" />
      <xs:group ref="ape:behaviorTagGroup" />
    </xs:choice>
  </xs:group>

  <!-- ====================
       Preamble

       Executor-facing orientation. Teaches the LLM runtime
       what APE elements mean before it encounters them.
       Allowed only as the first child of <ape>. At most one.
       ==================== -->

  <xs:complexType name="preambleType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="id" type="ape:identifierType" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- ====================
       Root Element
       ==================== -->

  <xs:element name="ape">
    <xs:complexType>
      <xs:choice maxOccurs="unbounded">
        <xs:element name="preamble" type="ape:preambleType" />
        <xs:element name="meta" type="ape:metaType" />
        <xs:element name="steps" type="ape:stepsType" />
        <xs:element name="note" type="xs:string" />
        <xs:element name="reference" type="ape:referenceType" />
        <xs:group ref="ape:declarationGroup" />
        <xs:group ref="ape:decoratorGroup" />
        <xs:group ref="ape:toolTagGroup" />
        <xs:group ref="ape:behaviorTagGroup" />
      </xs:choice>
      <xs:attribute name="version" type="xs:string" use="required" />
    </xs:complexType>
  </xs:element>

  <!-- ====================
       Meta

       Configuration and declarations only.
       No tool tags, no instructions.
       ==================== -->

  <xs:complexType name="metaType">
    <xs:choice maxOccurs="unbounded">
      <xs:element name="name" type="xs:string" />
      <xs:element name="description" type="xs:string" />
      <xs:element name="reference" type="ape:referenceType" />
      <xs:group ref="ape:declarationGroup" />
    </xs:choice>
    <xs:attribute name="id" type="ape:identifierType" />
  </xs:complexType>

  <!-- ====================
       Variables
       ==================== -->

  <!-- var: mixed content. Can contain text, <command>, and <resource> children.
       A command child computes the variable's value.
       A resource child declares a resource dependency for the value. -->
  <xs:complexType name="varType" mixed="true">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="command" type="ape:commandType" />
      <xs:element name="resource" type="ape:resourceDeclType" />
      <xs:element name="reference" type="ape:referenceType" />
    </xs:choice>
    <xs:attribute name="id" type="ape:identifierType" />
    <xs:attribute name="name" type="ape:identifierType" use="required" />
    <xs:attribute name="type" type="ape:variableTypeEnum" default="string" />
    <xs:attribute name="value" type="xs:string" />
    <xs:attribute name="default" type="xs:string" />
  </xs:complexType>

  <!-- ====================
       Parameters
       ==================== -->

  <xs:complexType name="paramType">
    <xs:attribute name="id" type="ape:identifierType" />
    <xs:attribute name="ref" type="ape:identifierType" use="required" />
    <xs:attribute name="default" type="xs:string" />
    <xs:attribute name="required" type="xs:boolean" default="true" />
  </xs:complexType>

  <!-- ====================
       Resources
       ==================== -->

  <xs:complexType name="resourceDeclType">
    <xs:attribute name="id" type="ape:identifierType" use="required" />
    <xs:attribute name="type" type="xs:string" use="required" />
    <xs:attribute name="path" type="xs:string" />
    <xs:attribute name="access" type="xs:string" />
    <xs:attribute name="required" type="xs:boolean" default="true" />
  </xs:complexType>

  <!-- ====================
       Commands
       ==================== -->

  <xs:complexType name="commandType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="id" type="ape:identifierType" />
        <xs:attribute name="ref" type="ape:identifierType" />
        <xs:attribute name="set" type="ape:identifierType" />
        <xs:attribute name="tool" type="xs:string" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- ====================
       Tool Tags
       ==================== -->

  <xs:complexType name="readType">
    <xs:attribute name="id" type="ape:identifierType" />
    <xs:attribute name="path" type="xs:string" use="required" />
    <xs:attribute name="var" type="ape:identifierType" />
  </xs:complexType>

  <xs:complexType name="writeType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="id" type="ape:identifierType" />
        <xs:attribute name="path" type="xs:string" />
        <xs:attribute name="ref" type="ape:identifierType" />
        <xs:attribute name="mode" type="ape:writeModeType" default="create" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="editType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="id" type="ape:identifierType" />
        <xs:attribute name="path" type="xs:string" use="required" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="globType">
    <xs:attribute name="id" type="ape:identifierType" />
    <xs:attribute name="pattern" type="xs:string" use="required" />
    <xs:attribute name="var" type="ape:identifierType" />
    <xs:attribute name="path" type="xs:string" />
  </xs:complexType>

  <xs:complexType name="grepType">
    <xs:attribute name="id" type="ape:identifierType" />
    <xs:attribute name="pattern" type="xs:string" use="required" />
    <xs:attribute name="var" type="ape:identifierType" />
    <xs:attribute name="path" type="xs:string" />
  </xs:complexType>

  <xs:complexType name="webSearchType">
    <xs:attribute name="id" type="ape:identifierType" />
    <xs:attribute name="query" type="xs:string" use="required" />
    <xs:attribute name="var" type="ape:identifierType" />
  </xs:complexType>

  <xs:complexType name="webFetchType">
    <xs:attribute name="id" type="ape:identifierType" />
    <xs:attribute name="url" type="xs:string" use="required" />
    <xs:attribute name="var" type="ape:identifierType" />
  </xs:complexType>

  <xs:complexType name="askUserQuestionType" mixed="true">
    <xs:sequence>
      <xs:element name="option" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:simpleContent>
            <xs:extension base="xs:string">
              <xs:attribute name="value" type="xs:string" use="required" />
            </xs:extension>
          </xs:simpleContent>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="id" type="ape:identifierType" />
    <xs:attribute name="var" type="ape:identifierType" />
    <xs:attribute name="type" type="ape:askType" default="text" />
  </xs:complexType>

  <!-- Behavioral tag types -->

  <xs:complexType name="interviewModeType">
    <xs:sequence>
      <xs:element name="ask-user-question" type="ape:askUserQuestionType" maxOccurs="unbounded" />
    </xs:sequence>
    <xs:attribute name="id" type="ape:identifierType" />
    <xs:attribute name="target" type="ape:identifierType" />
  </xs:complexType>

  <xs:complexType name="planModeType" mixed="true">
    <xs:attribute name="id" type="ape:identifierType" />
  </xs:complexType>

  <xs:complexType name="agentsInParallelType">
    <xs:sequence>
      <xs:element name="action" type="ape:actionType" maxOccurs="unbounded" />
    </xs:sequence>
    <xs:attribute name="id" type="ape:identifierType" />
  </xs:complexType>

  <xs:complexType name="stopType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="id" type="ape:identifierType" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="subagentStopType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="id" type="ape:identifierType" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- ====================
       Steps
       ==================== -->

  <!-- stepsType: contains steps plus optional guidance decorators.
       <rule>, <principle>, <anti-pattern>, <constraint> can appear
       as children alongside <step> elements. -->
  <xs:complexType name="stepsType">
    <xs:choice maxOccurs="unbounded">
      <xs:element name="step" type="ape:stepType" />
      <xs:element name="reference" type="ape:referenceType" />
      <xs:group ref="ape:decoratorGroup" />
    </xs:choice>
    <xs:attribute name="id" type="ape:identifierType" />
    <xs:attribute name="ref" type="ape:identifierType" />
  </xs:complexType>

  <!-- Step: uses xs:choice to allow interleaving of prose guidance,
       executable content, gates, declarations, and decorators.
       <instruction> is mixed content (prose + guidance decorators).
       <action> is pure structure (executable directives).
       They are siblings, not parent-child. -->
  <xs:complexType name="stepType">
    <xs:choice maxOccurs="unbounded">
      <xs:element name="title" type="xs:string" />
      <xs:element name="prerequisite" type="ape:prerequisiteType" />
      <xs:element name="prerequisites" type="ape:prerequisitesType" />
      <xs:element name="instruction" type="ape:instructionType" />
      <xs:element name="instructions" type="ape:instructionsType" />
      <xs:element name="description" type="xs:string" />
      <xs:element name="gate" type="ape:gateType" />
      <xs:element name="note" type="xs:string" />
      <xs:element name="reference" type="ape:referenceType" />
      <xs:group ref="ape:stepContentGroup" />
      <xs:group ref="ape:declarationGroup" />
      <xs:group ref="ape:decoratorGroup" />
    </xs:choice>
    <xs:attribute name="id" type="ape:identifierType" use="required" />
    <xs:attribute name="ref" type="ape:identifierType" />
    <xs:attribute name="number" type="xs:positiveInteger" />
    <xs:attribute name="uses" type="xs:string" />
  </xs:complexType>

  <!-- ====================
       Prerequisites
       ==================== -->

  <xs:complexType name="prerequisitesType">
    <xs:sequence>
      <xs:element name="prerequisite" type="ape:prerequisiteType" maxOccurs="unbounded" />
    </xs:sequence>
    <xs:attribute name="id" type="ape:identifierType" />
  </xs:complexType>

  <xs:complexType name="prerequisiteType" mixed="true">
    <xs:sequence>
      <xs:element name="check" type="ape:checkType" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="id" type="ape:identifierType" />
    <xs:attribute name="ref" type="ape:identifierType" />
    <xs:attribute name="goto" type="ape:identifierType" />
    <xs:attribute name="halt" type="xs:boolean" />
  </xs:complexType>

  <xs:complexType name="checkType">
    <xs:sequence>
      <xs:element name="command" type="ape:commandType" />
    </xs:sequence>
    <xs:attribute name="id" type="ape:identifierType" />
    <xs:attribute name="ref" type="ape:identifierType" />
  </xs:complexType>

  <!-- ====================
       Instruction / Instructions

       <instruction> is mixed content — prose with optional
       guidance decorators (rule, principle, anti-pattern, reference,
       constraint). It provides interpretive context but is NOT executable.
       It cannot contain <command>, <action>, <output>, <note>,
       or any tool/behavioral tags. <note> is only allowed at
       step level and root level, not inside instruction.

       <instructions> is an optional wrapper for 2+ instructions.
       ==================== -->

  <xs:complexType name="instructionType" mixed="true">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="rule" type="xs:string" />
      <xs:element name="principle" type="ape:principleType" />
      <xs:element name="anti-pattern" type="xs:string" />
      <xs:element name="reference" type="ape:referenceType" />
      <xs:element name="constraint" type="xs:string" />
    </xs:choice>
    <xs:attribute name="id" type="ape:identifierType" />
  </xs:complexType>

  <xs:complexType name="instructionsType">
    <xs:sequence>
      <xs:element name="instruction" type="ape:instructionType" minOccurs="2" maxOccurs="unbounded" />
    </xs:sequence>
    <xs:attribute name="id" type="ape:identifierType" />
  </xs:complexType>

  <!-- ====================
       Gate

       Pure structure. Contains either <criteria> or a single <criterion>
       (not both), plus <on-fail> (required) and optional <on-pass>.
       <criterion> can appear directly in <gate> as shorthand for a
       single-condition gate (no <criteria> wrapper needed).
       <goto> is a structural navigation element.
       <on-fail> and <on-pass> use attributes for flow control
       and may contain <action> and <goto> children — no prose.
       ==================== -->

  <xs:complexType name="gateType">
    <xs:choice maxOccurs="unbounded">
      <xs:element name="criteria" type="ape:criteriaType" />
      <xs:element name="criterion" type="ape:criterionType" />
      <xs:element name="on-pass" type="ape:onPassType" />
      <xs:element name="on-fail" type="ape:onFailType" />
      <xs:element name="goto" type="ape:gotoType" />
      <xs:element name="reference" type="ape:referenceType" />
      <xs:group ref="ape:decoratorGroup" />
    </xs:choice>
    <xs:attribute name="id" type="ape:identifierType" />
    <xs:attribute name="ref" type="ape:identifierType" />
  </xs:complexType>

  <!-- criteria: compound form or reference form.
       Compound form: <criteria operator="and"><criterion ... /></criteria>
         The operator attribute specifies how criteria combine (and/or).
       Named criteria: <criteria id="name" operator="and">...</criteria>
         can be reused via <criteria ref="name" /> from other gates.
       Reference form: <criteria ref="criteria-id" />
         ref resolves to a named <criteria> or <criterion> element. -->
  <xs:complexType name="criteriaType">
    <xs:sequence>
      <xs:element name="criterion" type="ape:criterionType" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
    <xs:attribute name="id" type="ape:identifierType" />
    <xs:attribute name="ref" type="ape:identifierType" />
    <xs:attribute name="operator" type="xs:string" />
  </xs:complexType>

  <!-- criterion: single evaluable condition.
       check: boolean expression using {{ }} syntax with comparison operators.
       ref: resolves to a named <criteria> or <criterion> id.
       ref and check are mutually exclusive. Exactly one must be present.
       Can appear as child of <criteria> or directly in <gate> (shorthand). -->
  <xs:complexType name="criterionType">
    <xs:attribute name="id" type="ape:identifierType" />
    <xs:attribute name="ref" type="ape:identifierType" />
    <xs:attribute name="check" type="xs:string" />
  </xs:complexType>

  <!-- goto: structural navigation element. Points to a step id.
       Can appear in gates, handlers, cases, and iteration. -->
  <xs:complexType name="gotoType">
    <xs:attribute name="id" type="ape:identifierType" />
    <xs:attribute name="ref" type="ape:identifierType" use="required" />
  </xs:complexType>

  <!-- on-pass: flow control attributes + optional action/goto children -->
  <xs:complexType name="onPassType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="action" type="ape:actionType" />
      <xs:element name="goto" type="ape:gotoType" />
      <xs:element name="reference" type="ape:referenceType" />
    </xs:choice>
    <xs:attribute name="id" type="ape:identifierType" />
    <xs:attribute name="ref" type="ape:identifierType" />
    <xs:attribute name="goto" type="ape:identifierType" />
    <xs:attribute name="proceed" type="xs:boolean" />
  </xs:complexType>

  <!-- on-fail: flow control attributes + optional action/goto children -->
  <xs:complexType name="onFailType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="action" type="ape:actionType" />
      <xs:element name="goto" type="ape:gotoType" />
      <xs:element name="reference" type="ape:referenceType" />
    </xs:choice>
    <xs:attribute name="id" type="ape:identifierType" />
    <xs:attribute name="ref" type="ape:identifierType" />
    <xs:attribute name="goto" type="ape:identifierType" />
    <xs:attribute name="retry" type="xs:boolean" />
    <xs:attribute name="max" type="xs:positiveInteger" />
    <xs:attribute name="then" type="xs:string" />
    <xs:attribute name="halt" type="xs:boolean" />
    <xs:attribute name="proceed" type="xs:boolean" />
  </xs:complexType>

  <!-- action: pure-structure executable directive.
       Contains only executable child tags. No bare prose.
       Flow-control attributes belong on the handler, not on action.
       Used inside steps as work to execute, and inside gate
       handlers as recovery actions. -->
  <xs:complexType name="actionType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="ape:actionChildGroup" />
      <xs:group ref="ape:decoratorGroup" />
      <xs:element name="reference" type="ape:referenceType" />
    </xs:choice>
    <xs:attribute name="id" type="ape:identifierType" />
    <xs:attribute name="ref" type="ape:identifierType" />
  </xs:complexType>

  <!-- ====================
       Conditionals
       ==================== -->

  <xs:complexType name="conditionalType">
    <xs:sequence>
      <xs:element name="case" type="ape:caseType" maxOccurs="unbounded" />
      <xs:element name="default" type="ape:defaultCaseType" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="id" type="ape:identifierType" />
    <xs:attribute name="ref" type="ape:identifierType" />
    <xs:attribute name="on" type="xs:string" use="required" />
    <xs:attribute name="default" type="xs:string" />
  </xs:complexType>

  <xs:complexType name="caseType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="ape:actionChildGroup" />
      <xs:element name="action" type="ape:actionType" />
      <xs:element name="goto" type="ape:gotoType" />
      <xs:element name="reference" type="ape:referenceType" />
    </xs:choice>
    <xs:attribute name="id" type="ape:identifierType" />
    <xs:attribute name="ref" type="ape:identifierType" />
    <xs:attribute name="value" type="xs:string" use="required" />
    <xs:attribute name="goto" type="ape:identifierType" />
    <xs:attribute name="halt" type="xs:boolean" />
  </xs:complexType>

  <xs:complexType name="defaultCaseType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="ape:actionChildGroup" />
      <xs:element name="action" type="ape:actionType" />
      <xs:element name="goto" type="ape:gotoType" />
      <xs:element name="reference" type="ape:referenceType" />
    </xs:choice>
    <xs:attribute name="id" type="ape:identifierType" />
    <xs:attribute name="ref" type="ape:identifierType" />
    <xs:attribute name="goto" type="ape:identifierType" />
    <xs:attribute name="halt" type="xs:boolean" />
  </xs:complexType>

  <!-- ====================
       Iteration
       ==================== -->

  <xs:complexType name="eachType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="ape:actionChildGroup" />
      <xs:element name="action" type="ape:actionType" />
      <xs:element name="goto" type="ape:gotoType" />
      <xs:element name="reference" type="ape:referenceType" />
    </xs:choice>
    <xs:attribute name="id" type="ape:identifierType" />
    <xs:attribute name="ref" type="ape:identifierType" />
    <xs:attribute name="item" type="ape:identifierType" use="required" />
    <xs:attribute name="in" type="xs:string" use="required" />
  </xs:complexType>

  <!-- ====================
       Sequence
       ==================== -->

  <xs:complexType name="sequenceType">
    <xs:sequence>
      <xs:element name="command" type="ape:commandType" maxOccurs="unbounded" />
    </xs:sequence>
    <xs:attribute name="id" type="ape:identifierType" />
    <xs:attribute name="ref" type="ape:identifierType" />
  </xs:complexType>

  <!-- ====================
       Decorators

       All decorators are standalone elements (no plural wrappers).
       Proximity handles grouping, matching the <constraint> pattern.
       ==================== -->

  <!-- principle: has a required name attribute. All other decorators
       (constraint, rule, anti-pattern) are plain xs:string. -->
  <xs:complexType name="principleType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="id" type="ape:identifierType" />
        <xs:attribute name="name" type="xs:string" use="required" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- ====================
       Reference

       A pointer to any element with an id.
       Requires ref_id attribute. Cannot have an id attribute.
       Can be a child of any container element.
       ==================== -->

  <xs:complexType name="referenceType">
    <xs:attribute name="ref_id" type="ape:identifierType" use="required" />
  </xs:complexType>

  <!-- ====================
       Template
       ==================== -->

  <xs:complexType name="templateType" mixed="true">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="ape:decoratorGroup" />
    </xs:choice>
    <xs:attribute name="id" type="ape:identifierType" use="required" />
    <xs:attribute name="format" type="xs:string" />
    <xs:attribute name="ref" type="ape:identifierType" />
  </xs:complexType>

  <!-- ====================
       Output
       ==================== -->

  <xs:complexType name="outputType" mixed="true">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="command" type="ape:commandType" />
      <xs:element name="reference" type="ape:referenceType" />
      <xs:group ref="ape:toolTagGroup" />
      <xs:group ref="ape:behaviorTagGroup" />
    </xs:choice>
    <xs:attribute name="id" type="ape:identifierType" />
    <xs:attribute name="ref" type="ape:identifierType" />
    <xs:attribute name="template" type="ape:identifierType" />
    <xs:attribute name="to" type="xs:string" />
    <xs:attribute name="target" type="xs:string" />
    <xs:attribute name="format" type="xs:string" />
    <xs:attribute name="anchor" type="xs:string" />
    <xs:attribute name="position" type="ape:outputPositionType" default="append" />
  </xs:complexType>

</xs:schema>
