);\\n    45\u2192\\n    46\u2192    assert_eq!(command, \\\"echo hello\\\");\\n    47\u2192}\\n    48\u2192\\n    49\u2192#[test]\\n    50\u2192fn config_merge_workflow() {\\n    51\u2192    let temp = TempDir::new().unwrap();\\n    52\u2192    let bivvy_dir = temp.path().join(\\\".bivvy\\\");\\n    53\u2192    fs::create_dir_all(&bivvy_dir).unwrap();\\n    54\u2192\\n    55\u2192    // Base config\\n    56\u2192    fs::write(\\n    57\u2192        bivvy_dir.join(\\\"config.yml\\\"),\\n    58\u2192        r#\\\"\\n    59\u2192app_name: BaseApp\\n    60\u2192settings:\\n    61\u2192  default_output: verbose\\n    62\u2192steps:\\n    63\u2192  deps:\\n    64\u2192    command: \\\"yarn install\\\"\\n    65\u2192\\\"#,\\n    66\u2192    )\\n    67\u2192    .unwrap();\\n    68\u2192\\n    69\u2192    // Local override\\n    70\u2192    fs::write(\\n    71\u2192        bivvy_dir.join(\\\"config.local.yml\\\"),\\n    72\u2192        r#\\\"\\n    73\u2192settings:\\n    74\u2192  default_output: quiet\\n    75\u2192steps:\\n    76\u2192  deps:\\n    77\u2192    command: \\\"yarn install --frozen-lockfile\\\"\\n    78\u2192\\\"#,\\n    79\u2192    )\\n    80\u2192    .unwrap();\\n    81\u2192\\n    82\u2192    let config = load_merged_config(temp.path()).unwrap();\\n    83\u2192\\n    84\u2192    // App name from base\\n    85\u2192    assert_eq!(config.app_name, Some(\\\"BaseApp\\\".to_string()));\\n    86\u2192\\n    87\u2192    // Setting overridden by local\\n    88\u2192    assert_eq!(config.settings.default_output, OutputMode::Quiet);\\n    89\u2192\\n    90\u2192    // Step command overridden by local\\n    91\u2192    assert_eq!(\\n    92\u2192        config.steps[\\\"deps\\\"].command,\\n    93\u2192        Some(\\\"yarn install --frozen-lockfile\\\".to_string())\\n    94\u2192    );\\n    95\u2192}\\n    96\u2192\\n    97\u2192#[test]\\n    98\u2192fn interpolation_context_workflow() {\\n    99\u2192    let ctx = InterpolationContext::new()\\n   100\u2192        .