192    /// Literal text\\n    24\u2192    Literal(String),\\n    25\u2192    /// Variable reference: ${name}\\n    26\u2192    Variable(String),\\n    27\u2192}\\n    28\u2192\\n    29\u2192/// Parse a string containing ${var} interpolations.\\n    30\u2192///\\n    31\u2192/// Supports:\\n    32\u2192/// - `${variable_name}` - variable interpolation\\n    33\u2192/// - `$${escaped}` - literal `${escaped}` in output\\n    34\u2192///\\n    35\u2192/// # Returns\\n    36\u2192///\\n    37\u2192/// Vec of segments representing the parsed string\\n    38\u2192pub fn parse_interpolation(input: &str) -> Vec<Segment> {\\n    39\u2192    let mut segments = Vec::new();\\n    40\u2192    let mut chars = input.chars().peekable();\\n    41\u2192    let mut current_literal = String::new();\\n    42\u2192\\n    43\u2192    while let Some(c) = chars.next() {\\n    44\u2192        if c == '$' {\\n    45\u2192            match chars.peek() {\\n    46\u2192                Some('$') => {\\n    47\u2192                    // Escaped: $$ becomes $\\n    48\u2192                    chars.next();\\n    49\u2192                    if chars.peek() == Some(&'{') {\\n    50\u2192                        // $${...} -> literal ${...}\\n    51\u2192                        chars.next(); // consume {\\n    52\u2192                        current_literal.push('$');\\n    53\u2192                        current_literal.push('{');\\n    54\u2192                        // Read until closing brace\\n    55\u2192                        while let Some(&c) = chars.peek() {\\n    56\u2192                            chars.next();\\n    57\u2192                            current_literal.push(c);\\n    58\u2192                            if c == '}' {\\n    59\u2192                                break;\\n    60\u2192                            }\\n    61\u2192                        }\\n    62\u2192                    } else {\\n    63\u2192                        current_literal.push('$');\\n    64\u2192                    }\\n    65\u2192                }\\n    66\u2192                Some('{') => {\\n    67\u2192                    // Start of variable\\n    68\u2192                    chars.next(); // consume {\\n    69\u2192\\n    70\u2192                    // Flush current literal\\n    71\u2192                    if !current_literal.is_empty() {\\n    72\u2192                        segments.push(Segment::Literal(std::mem::take(&mut current_literal)));\\n    73\u2192                    }\\n    74\u2192\\n    75\u2192                    // Read variable name until }\\n    76\u2192                    let mut var_name = String::new();\\n    77\u2192                    while let Some(&c) = chars.peek() {\\n    78\u2192                        if c == '}' {\\n    79\u2192                            chars.next();\\n    80\u2192                            break;\\n    81\u2192                        }\\n    82\u2192                        var_name.push(chars.next().unwrap());\\n    83\u2192                    }\\n    84\u2192\\n    85\u2192                    segments.push(Segment::Variable(var_name));\\n    86\u2192                }\\n    87\u2192                _ => {\\n    88\u2192                    current_literal.push(c);\\n    89\u2192                }\\n    90\u2192            }\\n    91\u2192        } else {\\n    92\u2192            current_literal.push(c);\\n    93\u2192        }\\n    94\u2192    }\\n    95\u2192\\n    96\u2192    // Flush remaining literal\\n    97\u2192    if !current_literal.is_empty() {\\n    98\u2192        segments.push(Segment::Literal(current_literal));\\n    99\u2192    }\\n   100\u2192\"}]},\"parent_tool_use_id\":\"toolu_01MGJbeQUiXKwiNzj6iBEcHL\",\"session_id\":\"71626d50-8e30-42b0-86de-6cafbf80e23f\",\"uuid\":\"e1cafe8a-aee4-4f3b-893c-f3bac7177a99\"}\n{\"type\":\"assistant\",\"message\":{\"model\":\"claude-haiku-4-5-20251001\",\"id\":\"msg_01Uq22wtdthpFgzGTWBHY53z\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"ty