ssage: String,\\n    20\u2192    /// Step name if error is step-specific\\n    21\u2192    pub step: Option<String>,\\n    22\u2192    /// Workflow name if error is workflow-specific\\n    23\u2192    pub workflow: Option<String>,\\n    24\u2192}\\n    25\u2192\\n    26\u2192/// Validate a configuration and return all errors.\\n    27\u2192///\\n    28\u2192/// This function collects all validation errors rather than stopping\\n    29\u2192/// at the first one, allowing users to fix multiple issues at once.\\n    30\u2192pub fn validate_config(config: &BivvyConfig) -> Vec<ValidationError> {\\n    31\u2192    let mut errors = Vec::new();\\n    32\u2192\\n    33\u2192    errors.extend(validate_steps(config));\\n    34\u2192    errors.extend(validate_workflows(config));\\n    35\u2192    errors.extend(validate_dependencies(config));\\n    36\u2192\\n    37\u2192    errors\\n    38\u2192}\\n    39\u2192\\n    40\u2192/// Validate step definitions.\\n    41\u2192fn validate_steps(config: &BivvyConfig) -> Vec<ValidationError> {\\n    42\u2192    let mut errors = Vec::new();\\n    43\u2192\\n    44\u2192    for (name, step) in &config.steps {\\n    45\u2192        // Step must have either template or command\\n    46\u2192        if step.template.is_none() && step.command.is_none() {\\n    47\u2192            errors.push(ValidationError {\\n    48\u2192                rule: \\\"missing-command\\\".to_string(),\\n    49\u2192                message: format!(\\\"Step '{}' must have either 'template' or 'command'\\\", name),\\n    50\u2192                step: Some(name.clone()),\\n    51\u2192                workflow: None,\\n    52\u2192            });\\n    53\u2192        }\\n    54\u2192\\n    55\u2192        // Validate depends_on references\\n    56\u2192        for dep in &step.depends_on {\\n    57\u2192            if !config.steps.contains_key(dep) {\\n    58\u2192                errors.push(ValidationError {\\n    59\u2192                    rule: \\\"unknown-step\\\".to_string(),\\n    60\u2192                    message: format!(\\\"Step '{}' depends on '{}' which does not exist\\\", name, dep),\\n    61\u2192                    step: Some(name.clone()),\\n    62\u2192                    workflow: None,\\n    63\u2192                });\\n    64\u2192            }\\n    65\u2192        }\\n    66\u2192    }\\n    67\u2192\\n    68\u2192    errors\\n    69\u2192}\\n    70\u2192\\n    71\u2192/// Validate workflow definitions.\\n    72\u2192fn validate_workflows(config: &BivvyConfig) -> Vec<ValidationError> {\\n    73\u2192    let mut errors = Vec::new();\\n    74\u2192\\n    75\u2192    for (name, workflow) in &config.workflows {\\n    76\u2192        // Validate step references\\n    77\u2192        for step_name in &workflow.steps {\\n    78\u2192            if !config.steps.contains_key(step_name) {\\n    79\u2192                errors.push(ValidationError {\\n    80\u2192                    rule: \\\"unknown-workflow-step\\\".to_string(),\\n    81\u2192                    message: format!(\\n    82\u2192                        \\\"Workflow '{}' references step '{}' which does not exist\\\",\\n    83\u2192                        name, step_name\\n    84\u2192                    ),\\n    85\u2192                    step: None,\\n    86\u2192                    workflow: Some(name.clone()),\\n    87\u2192                });\\n    88\u2192            }\\n    89\u2192        }\\n    90\u2192\\n    91\u2192        // Validate override references\\n    92\u2192        for step_name in workflow.overrides.keys() {\\n    93\u2192            if !workflow.steps.contains(step_name) {\\n    94\u2192                errors.push(ValidationError {\\n    95\u2192                    rule: \\\"unknown-override-step\\\".to_string(),\\n    96\u2192                    message: format!(\\n    97\u2192                        \\\"Workflow '{}' has override for '{}' which is not in the workflow\\\",\\n    98\u2192                        name, step_name\\n    99\u2192                    ),\\n   100\u2192                    step: None,\\n   101\u2192                    workflow: Some(name.clone()),\\n   102\u2192                });\\n   103\u2192            }\\n   104\u2192        }\\n   105\u2192    }\\n   106\u2192\\n   107\u2192    errors\\n   108\u2192}\\n   109\u2192\\n   110\u2192/// Validate step dependencies for cycles.\\n   111\u2192fn validate_dependencies(config: &BivvyConfig) -> Vec<ValidationError> {\\n   112\u2192    let mut errors = Vec::new();\\n   113\u2192    let mut visited = HashSet::new();\\n   114\u2192    let mut rec_stack = HashSet::new();\\n   115\u2192    let mut path = Vec::new();\\n   116\u2192\\n   117\u2192    for step_name in config.steps.keys() {\\n   118\u2192        if let Some(cycle) =\\n   119\u2192            detect_cycle(step_name, config, &mut visited, &mut rec_stack, &mut path)\\n   120\u2192        {\\n   121\u2192            errors.push(ValidationError {\\n   122\u2192                rule: \\\"circular-dependency\\\".to_string(),\\n   123\u2192                message: format!(\\\"Circular dependency detected: {}\\\", cycle),\\n   124\u2192                step: Some(step_name.clone()),\\n   125\u2192                workflow: None,\\n   126\u2192            });\\n   127\u2192            break; // Only report one cycle\\n   128\u2192        }\\n   129\u2192    }\\n   130\u2192\\n   131\u2192    errors\\n   132\u2192}\\n   133\u2192\\n   134\u2192fn detect_cycle(\\n   135\u2192    step: &str,\\n   136\u2192    config: &BivvyConfig,\\n   137\u2192    visited: &mut HashSet<String>,\\n   138\u2192    rec_stack: &mut HashSet<String>,\\n   139\u2192    path: &mut Vec<String>,\\n   140\u2192) -> Option<String> {\\n   141\u2192    if rec_stack.contains(step) {\\n   142\u2192        // Found cycle - format it\\n   143\u2192        let cycle_start = path.iter().position(|s| s == step).unwrap();\\n   144\u2192        let cycle: Vec<_> = path[cycle_start..].to_vec();\\n   145\u2192        return Some(format!(\\\"{} -> {}\\\", cycle.join(\\\" -> \\\"), step));\\n   146\u2192    }\\n   147\u2192\\n   148\u2192    if visited.contains(step) {\\n   149\u2192        return None;\\n   150\u2192    }\\n   151\u2192\\n   152\u2192    visited.insert(step.to_string());\\n   153\u2192    rec_stack.insert(step.to_string());\\n   154\u2192    path.push(step.to_string());\\n   155\u2192\\n   156\u2192    if let Some(step_config) = config.steps.get(step) {\\n   157\u2192        for dep in &step_config.depends_on {\\n   158\u2192            if let Some(cycle) = detect_cycle(dep, config, visited, rec_stack, path) {\\n   159\u2192                return Some(cycle);\\n   160\u2192            }\\n   161\u2192        }\\n   162\u2192    }\\n   163\u2192\\n   164\u2192    path.pop();\\n   165\u2192    rec_stack.remove(step);\\n   166\u2192    None\\n   167\u2192}\\n   168\u2192\\n   169\u2192/// Validate and return Result (for convenience).\\n   170\u2192///\\n   171\u2192/// # Errors\\n   172\u2192///\\n   173\u2192/// Returns `ConfigValidationError` if any validation rules fail.\\n   174\u2192pub fn validate(config: &BivvyConfig) -> Result<()> {\\n   175\u2192    let errors = validate_config(config);\\n   176\u2192\\n   177\u2192    if errors.is_empty() {\\n   178\u2192        Ok(())\\n   179\u2192    } else {\\n   180\u2192        let messages: Vec<_> = errors.iter().map(|e| e.message.clone()).collect();\\n   181\u2192        Err(BivvyError::ConfigValidationError {\\n   182\u2192            message: messages.join(\\\"; \\\"),\\n   183\u2192        })\\n   184\u2192    }\\n   185\u2192}\\n   186\u2192\\n   187\u2192#[cfg(test)]\\n   188\u2192mod tests {\\n   189\u2192    use super::*;\\n   190\u2192    use crate::config::schema::{StepConfig, StepOverride, WorkflowConfig};\\n   191\u2192\\n   192\u2192    #[test]\\n   193\u2192    fn validates_step_has_command_or_template() {\\n   194\u2192        let mut config = BivvyConfig::default();\\n   195\u2192        config\\n   196\u2192            .steps\\n   197\u2192            .insert(\\\"empty\\\".to_string(), StepConfig::default());\\n   198\u2192\\n   199\u2192        let errors = validate_config(&config);\\n   200\u2192        assert!(errors.iter().any(|e| e.rule == \\\"missing-command\\\"));\\n   201\u2192    }\\n   202\u2192\\n   203\u2192    #[test]\\n   204\u2192    fn validates_depends_on_exists() {\\n   205\u2192        let mut config = BivvyConfig::default();\\n   206\u2192        let step = StepConfig {\\n   207\u2192            command: Some(\\\"echo test\\\".to_string()),\\n   208\u2192            depends_on: vec![\\\"nonexistent\\\".to_string()],\\n   209\u2192            ..Default::default()\\n   210\u2192        };\\n   211\u2192        config.steps.insert(\\\"test\\\".to_string(), step);\\n   212\u2192\\n   213\u2192        let errors = validate_config(&config);\\n   214\u2192        assert!(errors.iter().any(|e| e.rule == \\\"unknown-step\\\"));\\n   215\u2192    }\\n   216\u2192\\n   217\u2192    #[test]\\n   218\u2192    fn validates_workflow_step_exists() {\\n   219\u2192        let mut config = BivvyConfig::default();\\n   220\u2192        let workflow = WorkflowConfig {\\n   221\u2192            steps: vec![\\\"nonexistent\\\".to_string()],\\n   222\u2192            ..Default::default()\\n   223\u2192        };\\n   224\u2192        config.workflows.insert(\\\"default\\\".to_string(), workflow);\\n   225\u2192\\n   226\u2192        let errors = validate_config(&config);\\n   227\u2192        assert!(errors.iter().any(|e| e.rule == \\\"unknown-workflow-step\\\"));\\n   228\u2192    }\\n   229\u2192\\n   230\u2192    #[test]\\n   231\u2192    fn detects_circular_dependency() {\\n   232\u2192        let mut config = BivvyConfig::default();\\n   233\u2192\\n   234\u2192        let step_a = StepConfig {\\n   235\u2192            command: Some(\\\"a\\\".to_string()),\\n   236\u2192            depends_on: vec![\\\"b\\\".to_string()],\\n   237\u2192            ..Default::default()\\n   238\u2192        };\\n   239\u2192\\n   240\u2192        let step_b = StepConfig {\\n   241\u2192            command: Some(\\\"b\\\".to_string()),\\n   242\u2192            depends_on: vec![\\\"a\\\".to_string()],\\n   243\u2192            ..Default::default()\\n   244\u2192        };\\n   245\u2192\\n   246\u2192        config.steps.insert(\\\"a\\\".to_string(), step_a);\\n   247\u2192        config.steps.insert(\\\"b\\\".to_string(), step_b);\\n   248\u2192\\n   249\u2192        let errors = validate_config(&config);\\n   250\u2192        assert!(errors.iter().any(|e| e.rule == \\\"circular-dependency\\\"));\\n   251\u2192    }\\n   252\u2192\\n   253\u2192    #[test]\\n   254\u2192    fn valid_config_returns_no_errors() {\\n   255\u2192        let mut config = BivvyConfig::default();\\n   256\u2192\\n   257\u2192        let step_a = StepConfig {\\n   258\u2192            command: Some(\\\"a\\\".to_string()),\\n   259\u2192            ..Default::default()\\n   260\u2192        };\\n   261\u2192\\n   262\u2192        let step_b = StepConfig {\\n   263\u2192            command: Some(\\\"b\\\".to_string()),\\n   264\u2192            depends_on: vec![\\\"a\\\".to_string()],\\n   265\u2192            ..Default::default()\\n   266\u2192        };\\n   267\u2192\\n   268\u2192        config.steps.insert(\\\"a\\\".to_string(), step_a);\\n   269\u2192        config.steps.insert(\\\"b\\\".to_string(), step_b);\\n   270\u2192\\n   271\u2192        let workflow = WorkflowConfig {\\n   272\u2192            steps: vec![\\\"a\\\".to_string(), \\\"b\\\".to_string()],\\n   273\u2192            ..Default::default()\\n   274\u2192        };\\n   275\u2192        config.workflows.insert(\\\"default\\\".to_string(), workflow);\\n   276\u2192\\n   277\u2192        let errors = validate_config(&config);\\n   278\u2192        assert!(errors.is_empty());\\n   279\u2192    }\\n   280\u2192\\n   281\u2192    #[test]\\n   282\u2192    fn validates_workflow_override_in_workflow() {\\n   283\u2192        let mut config = BivvyConfig::default();\\n   284\u2192\\n   285\u2192        let step = StepConfig {\\n   286\u2192            command: Some(\\\"test\\\".to_string()),\\n   287\u2192            ..Default::default()\\n   288\u2192        };\\n   289\u2192        config.steps.insert(\\\"test\\\".to_string(), step);\\n   290\u2192\\n   291\u2192        let mut overrides = std::collections::HashMap::new();\\n   292\u2192        overrides.insert(\\\"other\\\".to_string(), StepOverride::default());\\n   293\u2192\\n   294\u2192        let workflow = WorkflowConfig {\\n   295\u2192            steps: vec![\\\"test\\\".to_string()],\\n   296\u2192            overrides,\\n   297\u2192            ..Default::default()\\n   298\u2192        };\\n   299\u2192        config.workflows.insert(\\\"default\\\".to_string(), workflow);\\n   300\u2192\\n   301\u2192        let errors = validate_config(&config);\\n   302\u2192        assert!(errors.iter().any(|e| e.rule == \\\"unknown-override-step\\\"));\\n   303\u2192    }\\n   304\u2192\\n   305\u2192    #[test]\\n   306\u2192    fn validate_returns_result() {\\n   307\u2192        let config = BivvyConfig::default();\\n   308\u2192        assert!(validate(&config).is_ok());\\n   309\u2192\\n   310\u2192        let mut bad_config = BivvyConfig::default();\\n   311\u2192        bad_config\\n   312\u2192            .steps\\n   313\u2192            .insert(\\\"empty\\\".to_string(), StepConfig::default());\\n   314\u2192        assert!(validate(&bad_config).is_err());\\n   315\u2192    }\\n   316\u2192}\\n   317\u2192\"}]},\"parent_tool_use_id\":\"toolu_01MGJbeQUiXKwiNzj6iBEcHL\",\"session_id\":\"71626d50-8e30-42b0-86de-6cafbf80e23f\",\"uuid\":\"0720a66c-b84e-43df-8c56-7ba17b9d3eaa\"}\n{\"type\":\"assistant\",\"message\":{\"model\":\"claude-haiku-4-5-20251001\",\"id\":\"msg_01Ter9zjQJFj2SKtZPgRsGoG\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01JyeyUwpn