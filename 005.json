ize)]\\n    12\u2192#[serde(default)]\\n    13\u2192pub struct BivvyConfig {\\n    14\u2192    /// Application name (for display purposes)\\n    15\u2192    #[serde(skip_serializing_if = \\\"Option::is_none\\\")]\\n    16\u2192    pub app_name: Option<String>,\\n    17\u2192\\n    18\u2192    /// Global settings\\n    19\u2192    pub settings: Settings,\\n    20\u2192\\n    21\u2192    /// Remote template sources\\n    22\u2192    #[serde(default, skip_serializing_if = \\\"Vec::is_empty\\\")]\\n    23\u2192    pub template_sources: Vec<TemplateSource>,\\n    24\u2192\\n    25\u2192    /// Step definitions\\n    26\u2192    #[serde(default)]\\n    27\u2192    pub steps: HashMap<String, StepConfig>,\\n    28\u2192\\n    29\u2192    /// Workflow definitions\\n    30\u2192    #[serde(default)]\\n    31\u2192    pub workflows: HashMap<String, WorkflowConfig>,\\n    32\u2192\\n    33\u2192    /// Secrets configuration\\n    34\u2192    #[serde(default, skip_serializing_if = \\\"HashMap::is_empty\\\")]\\n    35\u2192    pub secrets: HashMap<String, SecretConfig>,\\n    36\u2192\\n    37\u2192    /// Config inheritance\\n    38\u2192    #[serde(skip_serializing_if = \\\"Option::is_none\\\")]\\n    39\u2192    pub extends: Option<Vec<ExtendsConfig>>,\\n    40\u2192\\n    41\u2192    /// Custom requirement definitions\\n    42\u2192    #[serde(default, skip_serializing_if = \\\"HashMap::is_empty\\\")]\\n    43\u2192    pub requirements: HashMap<String, CustomRequirement>,\\n    44\u2192\\n    45\u2192    /// User-defined variables for interpolation.\\n    46\u2192    #[serde(default, skip_serializing_if = \\\"HashMap::is_empty\\\")]\\n    47\u2192    pub vars: HashMap<String, VarDefinition>,\\n    48\u2192}\\n    49\u2192\\n    50\u2192/// Global settings that apply to all workflows and steps\\n    51\u2192#[derive(Debug, Clone, Serialize, Deserialize)]\\n...\\n</persisted-output>\"}]},\"parent_tool_use_id\":\"toolu_01MGJbeQUiXKwiNzj6iBEcHL\",\"session_id\":\"71626d50-8e30-42