environment.\\n   582\u2192    /// These skip gap detection checks when this environment is active.\\n   583\u2192    #[serde(default, skip_serializing_if = \\\"Vec::is_empty\\\")]\\n   584\u2192    pub provided_requirements: Vec<String>,\\n   585\u2192}\\n   586\u2192\\n   587\u2192/// A rule for auto-detecting an environment.\\n   588\u2192#[derive(Debug, Clone, Serialize, Deserialize)]\\n   589\u2192pub struct EnvironmentDetectRule {\\n   590\u2192    /// Environment variable name to check.\\n   591\u2192    pub env: String,\\n   592\u2192\\n   593\u2192    /// If set, the variable must equal this value. If absent, just checks presence.\\n   594\u2192    #[serde(skip_serializing_if = \\\"Option::is_none\\\")]\\n   595\u2192    pub value: Option<String>,\\n   596\u2192}\\n   597\u2192\\n   598\u2192/// Per-environment overrides for a step.\\n   599\u2192///\\n   600\u2192/// All fields are `Option` \u2014 only specified fields override the base step.\\n   601\u2192/// The `env` field uses `HashMap<String, Option<String>>`:\\n   602\u2192/// `Some(val)` = set/override, `None` = remove the key from the base env.\\n   603\u2192#[derive(Debug, Clone, Default, Serialize, Deserialize)]\\n   604\u2192#[serde(default)]\\n   605\u2192pub struct StepEnvironmentOverride {\\n   606\u2192    /// Override step title\\n   607\u2192    #[serde(skip_serializing_if = \\\"Option::is_none\\\")]\\n   608\u2192    pub title: Option<String>,\\n   609\u2192\\n   610\u2192    /// Override step description\\n   611\u2192    #[serde(skip_serializing_if = \\\"Option::is_none\\\")]\\n   612\u2192    pub description: Option<String>,\\n   613\u2192\\n   614\u2192    /// Override step command\\n   615\u2192    #[serde(skip_serializing_if = \\\"Option::is_none\\\")]\\n   616\u2192    pub command: Option<String>,\\n   617\u2192\\n   618\u2192    /// Override/remove env vars (None value = remove key)\\n   619\u2192    #[serde(default, skip_serializing_if = \\\"HashMap::is_empty\\\")]\\n   620\u2192    pub env: HashMap<String, Option<String>>,\\n   621\u2192\\n   622\u2192    /// Override completed check\\n   623\u2192    #[serde(skip_serializing_if = \\\"Option::is_none\\\")]\\n   624\u2192    pub completed_check: Option<CompletedCheck>,\\n   625\u2192\\n   626\u2192    /// Override precondition\\n   627\u2192    #[serde(skip_serializing_if = \\\"Option::is_none\\\")]\\n   628\u2192    pub precondition: Option<CompletedCheck>,\\n   629\u2192\\n   630\u2192    /// Override skippable\\n   631\u2192    #[serde(skip_serializing_if = \\\"Option::is_none\\\")]\\n   632\u2192    pub skippable: Option<bool>,\\n   633\u2192\\n   634\u2192    /// Override allow_failure\\n   635\u2192    #[serde(skip_serializing_if = \\\"Option::is_none\\\")]\\n   636\u2192    pub allow_failure: Option<bool>,\\n   637\u2192\\n   638\u2192    /// Override requires_sudo\\n   639\u2192    #[serde(skip_serializing_if = \\\"Option::is_none\\\")]\\n   640\u2192    pub requires_sudo: Option<bool>,\\n   641\u2192\\n   642\u2192    /// Override sensitive\\n   643\u2192    #[serde(skip_serializing_if = \\\"Option::is_none\\\")]\\n   644\u2192    pub sensitive: Option<bool>,\\n   645\u2192\\n   646\u2192    /// Override before hooks\\n   647\u2192    #[serde(skip_serializing_if = \\\"Option::is_none\\\")]\\n   648\u2192    pub before: Option<Vec<String>>,\\n   649\u2192\\n   650\u2192    /// Override after hooks\\n   651\u2192    #[serde(skip_serializing_if = \\\"Option::is_none\\\")]\\n   652\u2192    pub after: Option<Vec<String>>,\\n   653\u2192\\n   654\u2192    /// Override dependencies\\n   655\u2192    #[serde(skip_serializing_if = \\\"Option::is_none\\\")]\\n   656\u2192    pub depends_on: Option<Vec<String>>,\\n   657\u2192\\n   658\u2192    /// Override requirements\\n   659\u2192    #[serde(skip_serializing_if = \\\"Option::is_none\\\")]\\n   660\u2192    pub requires: Option<Vec<String>>,\\n   661\u2192\\n   662\u2192    /// Override watches\\n   663\u2192    #[serde(skip_serializing_if = \\\"Option::is_none\\\")]\\n   664\u2192    pub watches: Option<Vec<String>>,\\n   665\u2192\\n   666\u2192    /// Override retry count\\n   667\u2192    #[serde(skip_serializing_if = \\\"Option::is_none\\\")]\\n   668\u2192    pub retry: Option<u32>,\\n   669\u2192}\\n   670\u2192\\n   671\u2192#[cfg(test)]\\n   672\u2192mod tests {\\n   673\u2192    use super::*;\\n   674\u2192\\n   675\u2192    #[test]\\n   676\u2192    fn empty_config_has_defaults() {\\n   677\u2192        let config: BivvyConfig = serde_yaml::from_str(\\\"\\\").unwrap();\\n   678\u2192        assert_eq!(config.settings.default_output, OutputMode::Verbose);\\n   679\u2192        assert_eq!(config.settings.max_parallel, 4);\\n   680\u2192        assert_eq!(config.settings.history_retention, 50);\\n   681\u2192        assert!(config.steps.is_empty());\\n   682\u2192        assert!(config.workflows.is_empty());\\n   683\u2192    }\\n   684\u2192\\n   685\u2192    #[test]\\n   686\u2192    fn parses_minimal_config() {\\n   687\u2192        let yaml = r#\\\"\\n   688\u2192app_name: \\\"MyApp\\\"\\n   689\u2192settings:\\n   690\u2192  default_output: quiet\\n   691\u2192\\\"#;\\n   692\u2192        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n   693\u2192        assert_eq!(config.app_name, Some(\\\"MyApp\\\".to_string()));\\n   694\u2192        assert_eq!(config.settings.default_output, OutputMode::Quiet);\\n   695\u2192    }\\n   696\u2192\\n   697\u2192    #[test]\\n   698\u2192    fn parses_template_sources() {\\n   699\u2192        let yaml = r#\\\"\\n   700\u2192template_sources:\\n   701\u2192  - url: \\\"https://example.com/templates\\\"\\n   702\u2192    priority: 10\\n   703\u2192    timeout: 60\\n   704\u2192\\\"#;\\n   705\u2192        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n   706\u2192        assert_eq!(config.template_sources.len(), 1);\\n   707\u2192        assert_eq!(config.template_sources[0].priority, 10);\\n   708\u2192        assert_eq!(config.template_sources[0].timeout, 60);\\n   709\u2192    }\\n   710\u2192\\n   711\u2192    #[test]\\n   712\u2192    fn parses_settings_with_env() {\\n   713\u2192        let yaml = r#\\\"\\n   714\u2192settings:\\n   715\u2192  logging: true\\n   716\u2192  log_path: \\\"logs/bivvy.log\\\"\\n   717\u2192  env:\\n   718\u2192    RAILS_ENV: development\\n   719\u2192    DEBUG: \\\"true\\\"\\n   720\u2192  parallel: true\\n   721\u2192  max_parallel: 8\\n   722\u2192\\\"#;\\n   723\u2192        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n   724\u2192        assert!(config.settings.logging);\\n   725\u2192        assert_eq!(\\n   726\u2192            config.settings.log_path,\\n   727\u2192            Some(PathBuf::from(\\\"logs/bivvy.log\\\"))\\n   728\u2192        );\\n   729\u2192        assert_eq!(\\n   730\u2192            config.settings.env.get(\\\"RAILS_ENV\\\"),\\n   731\u2192            Some(&\\\"development\\\".to_string())\\n   732\u2192        );\\n   733\u2192        assert!(config.settings.parallel);\\n   734\u2192        assert_eq!(config.settings.max_parallel, 8);\\n   735\u2192    }\\n   736\u2192\\n   737\u2192    #[test]\\n   738\u2192    fn parses_extends_config() {\\n   739\u2192        let yaml = r#\\\"\\n   740\u2192extends:\\n   741\u2192  - url: \\\"https://example.com/base-config.yml\\\"\\n   742\u2192\\\"#;\\n   743\u2192        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n   744\u2192        assert!(config.extends.is_some());\\n   745\u2192        assert_eq!(config.extends.as_ref().unwrap().len(), 1);\\n   746\u2192    }\\n   747\u2192\\n   748\u2192    #[test]\\n   749\u2192    fn parses_secrets_config() {\\n   750\u2192        let yaml = r#\\\"\\n   751\u2192secrets:\\n   752\u2192  db_password:\\n   753\u2192    command: \\\"op read op://vault/database/password\\\"\\n   754\u2192\\\"#;\\n   755\u2192        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n   756\u2192        assert!(config.secrets.contains_key(\\\"db_password\\\"));\\n   757\u2192    }\\n   758\u2192\\n   759\u2192    #[test]\\n   760\u2192    fn parses_step_with_template() {\\n   761\u2192        let yaml = r#\\\"\\n   762\u2192steps:\\n   763\u2192  node_deps:\\n   764\u2192    template: yarn\\n   765\u2192    inputs:\\n   766\u2192      frozen: true\\n   767\u2192\\\"#;\\n   768\u2192        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n   769\u2192        let step = &config.steps[\\\"node_deps\\\"];\\n   770\u2192        assert_eq!(step.template, Some(\\\"yarn\\\".to_string()));\\n   771\u2192    }\\n   772\u2192\\n   773\u2192    #[test]\\n   774\u2192    fn parses_step_with_inline_config() {\\n   775\u2192        let yaml = r#\\\"\\n   776\u2192steps:\\n   777\u2192  custom:\\n   778\u2192    title: \\\"Custom Step\\\"\\n   779\u2192    command: \\\"echo hello\\\"\\n   780\u2192    depends_on: [other]\\n   781\u2192    env:\\n   782\u2192      MY_VAR: \\\"value\\\"\\n   783\u2192\\\"#;\\n   784\u2192        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n   785\u2192        let step = &config.steps[\\\"custom\\\"];\\n   786\u2192        assert_eq!(step.title, Some(\\\"Custom Step\\\".to_string()));\\n   787\u2192        assert_eq!(step.command, Some(\\\"echo hello\\\".to_string()));\\n   788\u2192        assert_eq!(step.depends_on, vec![\\\"other\\\"]);\\n   789\u2192    }\\n   790\u2192\\n   791\u2192    #[test]\\n   792\u2192    fn step_defaults_are_correct() {\\n   793\u2192        let yaml = r#\\\"\\n   794\u2192steps:\\n   795\u2192  minimal:\\n   796\u2192    command: \\\"echo test\\\"\\n   797\u2192\\\"#;\\n   798\u2192        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n   799\u2192        let step = &config.steps[\\\"minimal\\\"];\\n   800\u2192        assert!(step.skippable);\\n   801\u2192        assert!(!step.required);\\n   802\u2192        assert!(step.prompt_if_complete);\\n   803\u2192        assert!(!step.allow_failure);\\n   804\u2192        assert_eq!(step.retry, 0);\\n   805\u2192    }\\n   806\u2192\\n   807\u2192    #[test]\\n   808\u2192    fn parses_step_with_prompts() {\\n   809\u2192        let yaml = r#\\\"\\n   810\u2192steps:\\n   811\u2192  interactive:\\n   812\u2192    command: \\\"yarn ${install_mode}\\\"\\n   813\u2192    prompts:\\n   814\u2192      - key: install_mode\\n   815\u2192        question: \\\"How to install?\\\"\\n   816\u2192        type: select\\n   817\u2192        options:\\n   818\u2192          - label: \\\"Normal\\\"\\n   819\u2192            value: \\\"install\\\"\\n   820\u2192          - label: \\\"Frozen\\\"\\n   821\u2192            value: \\\"install --frozen-lockfile\\\"\\n   822\u2192\\\"#;\\n   823\u2192        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n   824\u2192        let step = &config.steps[\\\"interactive\\\"];\\n   825\u2192        assert_eq!(step.prompts.len(), 1);\\n   826\u2192        assert_eq!(step.prompts[0].key, \\\"install_mode\\\");\\n   827\u2192        assert_eq!(step.prompts[0].options.len(), 2);\\n   828\u2192    }\\n   829\u2192\\n   830\u2192    #[test]\\n   831\u2192    fn parses_step_with_hooks() {\\n   832\u2192        let yaml = r#\\\"\\n   833\u2192steps:\\n   834\u2192  database:\\n   835\u2192    command: \\\"rails db:setup\\\"\\n   836\u2192    before:\\n   837\u2192      - echo \\\"Starting...\\\"\\n   838\u2192    after:\\n   839\u2192      - echo \\\"Done!\\\"\\n   840\u2192\\\"#;\\n   841\u2192        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n   842\u2192        let step = &config.steps[\\\"database\\\"];\\n   843\u2192        assert_eq!(step.before.len(), 1);\\n   844\u2192        assert_eq!(step.after.len(), 1);\\n   845\u2192    }\\n   846\u2192\\n   847\u2192    #[test]\\n   848\u2192    fn step_config_defaults_to_empty_hooks() {\\n   849\u2192        let yaml = r#\\\"\\n   850\u2192            command: \\\"echo hello\\\"\\n   851\u2192        \\\"#;\\n   852\u2192        let config: StepConfig = serde_yaml::from_str(yaml).unwrap();\\n   853\u2192\\n   854\u2192        assert!(config.before.is_empty());\\n   855\u2192        assert!(config.after.is_empty());\\n   856\u2192    }\\n   857\u2192\\n   858\u2192    #[test]\\n   859\u2192    fn step_config_parses_before_hooks() {\\n   860\u2192        let yaml = r#\\\"\\n   861\u2192            command: \\\"echo main\\\"\\n   862\u2192            before:\\n   863\u2192              - \\\"echo pre-1\\\"\\n   864\u2192              - \\\"echo pre-2\\\"\\n   865\u2192        \\\"#;\\n   866\u2192        let config: StepConfig = serde_yaml::from_str(yaml).unwrap();\\n   867\u2192\\n   868\u2192        assert_eq!(config.before.len(), 2);\\n   869\u2192        assert_eq!(config.before[0], \\\"echo pre-1\\\");\\n   870\u2192    }\\n   871\u2192\\n   872\u2192    #[test]\\n   873\u2192    fn step_config_parses_after_hooks() {\\n   874\u2192        let yaml = r#\\\"\\n   875\u2192            command: \\\"echo main\\\"\\n   876\u2192            after:\\n   877\u2192              - \\\"echo post-1\\\"\\n   878\u2192        \\\"#;\\n   879\u2192        let config: StepConfig = serde_yaml::from_str(yaml).unwrap();\\n   880\u2192\\n   881\u2192        assert_eq!(config.after.len(), 1);\\n   882\u2192    }\\n   883\u2192\\n   884\u2192    #[test]\\n   885\u2192    fn step_config_parses_both_hooks() {\\n   886\u2192        let yaml = r#\\\"\\n   887\u2192            command: \\\"bin/rails db:setup\\\"\\n   888\u2192            before:\\n   889\u2192              - \\\"echo Starting database setup...\\\"\\n   890\u2192              - \\\"./scripts/pre-db-check.sh\\\"\\n   891\u2192            after:\\n   892\u2192              - \\\"echo Database setup complete\\\"\\n   893\u2192        \\\"#;\\n   894\u2192        let config: StepConfig = serde_yaml::from_str(yaml).unwrap();\\n   895\u2192\\n   896\u2192        assert_eq!(config.before.len(), 2);\\n   897\u2192        assert_eq!(config.after.len(), 1);\\n   898\u2192    }\\n   899\u2192\\n   900\u2192    #[test]\\n   901\u2192    fn parses_step_with_watches() {\\n   902\u2192        let yaml = r#\\\"\\n   903\u2192steps:\\n   904\u2192  deps:\\n   905\u2192    command: \\\"bundle install\\\"\\n   906\u2192    watches:\\n   907\u2192      - Gemfile\\n   908\u2192      - Gemfile.lock\\n   909\u2192\\\"#;\\n   910\u2192        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n   911\u2192        let step = &config.steps[\\\"deps\\\"];\\n   912\u2192        assert_eq!(step.watches, vec![\\\"Gemfile\\\", \\\"Gemfile.lock\\\"]);\\n   913\u2192    }\\n   914\u2192\\n   915\u2192    #[test]\\n   916\u2192    fn parses_workflow_definition() {\\n   917\u2192        let yaml = r#\\\"\\n   918\u2192workflows:\\n   919\u2192  default:\\n   920\u2192    description: \\\"Full development setup\\\"\\n   921\u2192    steps: [brew, deps, database]\\n   922\u2192\\\"#;\\n   923\u2192        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n   924\u2192        let workflow = &config.workflows[\\\"default\\\"];\\n   925\u2192        assert_eq!(\\n   926\u2192            workflow.description,\\n   927\u2192            Some(\\\"Full development setup\\\".to_string())\\n   928\u2192        );\\n   929\u2192        assert_eq!(workflow.steps, vec![\\\"brew\\\", \\\"deps\\\", \\\"database\\\"]);\\n   930\u2192    }\\n   931\u2192\\n   932\u2192    #[test]\\n   933\u2192    fn parses_workflow_with_overrides() {\\n   934\u2192        let yaml = r#\\\"\\n   935\u2192workflows:\\n   936\u2192  onboarding:\\n   937\u2192    steps: [deps, database, seeds]\\n   938\u2192    overrides:\\n   939\u2192      seeds:\\n   940\u2192        required: true\\n   941\u2192        skip_prompt: true\\n   942\u2192\\\"#;\\n   943\u2192        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n   944\u2192        let workflow = &config.workflows[\\\"onboarding\\\"];\\n   945\u2192        let override_ = &workflow.overrides[\\\"seeds\\\"];\\n   946\u2192        assert_eq!(override_.required, Some(true));\\n   947\u2192        assert!(override_.skip_prompt);\\n   948\u2192    }\\n   949\u2192\\n   950\u2192    #[test]\\n   951\u2192    fn parses_workflow_with_env() {\\n   952\u2192        let yaml = r#\\\"\\n   953\u2192workflows:\\n   954\u2192  ci:\\n   955\u2192    steps: [deps, test]\\n   956\u2192    env:\\n   957\u2192      CI: \\\"true\\\"\\n   958\u2192      RAILS_ENV: test\\n   959\u2192    settings:\\n   960\u2192      non_interactive: true\\n   961\u2192\\\"#;\\n   962\u2192        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n   963\u2192        let workflow = &config.workflows[\\\"ci\\\"];\\n   964\u2192        assert_eq!(workflow.env.get(\\\"CI\\\"), Some(&\\\"true\\\".to_string()));\\n   965\u2192        assert!(workflow.settings.as_ref().unwrap().non_interactive);\\n   966\u2192    }\\n   967\u2192\\n   968\u2192    #[test]\\n   969\u2192    fn parses_multiple_workflows() {\\n   970\u2192        let yaml = r#\\\"\\n   971\u2192workflows:\\n   972\u2192  default:\\n   973\u2192    steps: [deps, database]\\n   974\u2192  ci:\\n   975\u2192    steps: [deps, test]\\n   976\u2192  reset:\\n   977\u2192    description: \\\"Clean slate\\\"\\n   978\u2192    steps: [clean, deps, database, seeds]\\n   979\u2192\\\"#;\\n   980\u2192        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n   981\u2192        assert_eq!(config.workflows.len(), 3);\\n   982\u2192        assert!(config.workflows.contains_key(\\\"default\\\"));\\n   983\u2192        assert!(config.workflows.contains_key(\\\"ci\\\"));\\n   984\u2192        assert!(config.workflows.contains_key(\\\"reset\\\"));\\n   985\u2192    }\\n   986\u2192\\n   987\u2192    #[test]\\n   988\u2192    fn parses_file_exists_check() {\\n   989\u2192        let yaml = r#\\\"\\n   990\u2192steps:\\n   991\u2192  deps:\\n   992\u2192    command: \\\"yarn install\\\"\\n   993\u2192    completed_check:\\n   994\u2192      type: file_exists\\n   995\u2192      path: \\\"node_modules\\\"\\n   996\u2192\\\"#;\\n   997\u2192        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n   998\u2192        let check = config.steps[\\\"deps\\\"].completed_check.as_ref().unwrap();\\n   999\u2192        assert!(matches!(\\n  1000\u2192            check,\\n  1001\u2192            CompletedCheck::FileExists { path } if path == \\\"node_modules\\\"\\n  1002\u2192        ));\\n  1003\u2192    }\\n  1004\u2192\\n  1005\u2192    #[test]\\n  1006\u2192    fn parses_command_succeeds_check() {\\n  1007\u2192        let yaml = r#\\\"\\n  1008\u2192steps:\\n  1009\u2192  deps:\\n  1010\u2192    command: \\\"bundle install\\\"\\n  1011\u2192    completed_check:\\n  1012\u2192      type: command_succeeds\\n  1013\u2192      command: \\\"bundle check\\\"\\n  1014\u2192\\\"#;\\n  1015\u2192        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n  1016\u2192        let check = config.steps[\\\"deps\\\"].completed_check.as_ref().unwrap();\\n  1017\u2192        assert!(matches!(\\n  1018\u2192            check,\\n  1019\u2192            CompletedCheck::CommandSucceeds { command } if command == \\\"bundle check\\\"\\n  1020\u2192        ));\\n  1021\u2192    }\\n  1022\u2192\\n  1023\u2192    #[test]\\n  1024\u2192    fn parses_all_check() {\\n  1025\u2192        let yaml = r#\\\"\\n  1026\u2192steps:\\n  1027\u2192  deps:\\n  1028\u2192    command: \\\"yarn install\\\"\\n  1029\u2192    completed_check:\\n  1030\u2192      type: all\\n  1031\u2192      checks:\\n  1032\u2192        - type: file_exists\\n  1033\u2192          path: \\\"node_modules\\\"\\n  1034\u2192        - type: command_succeeds\\n  1035\u2192          command: \\\"yarn check\\\"\\n  1036\u2192\\\"#;\\n  1037\u2192        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n  1038\u2192        let check = config.steps[\\\"deps\\\"].completed_check.as_ref().unwrap();\\n  1039\u2192        if let CompletedCheck::All { checks } = check {\\n  1040\u2192            assert_eq!(checks.len(), 2);\\n  1041\u2192        } else {\\n  1042\u2192            panic!(\\\"Expected All check\\\");\\n  1043\u2192        }\\n  1044\u2192    }\\n  1045\u2192\\n  1046\u2192    #[test]\\n  1047\u2192    fn parses_any_check() {\\n  1048\u2192        let yaml = r#\\\"\\n  1049\u2192steps:\\n  1050\u2192  env:\\n  1051\u2192    command: \\\"cp .env.example .env\\\"\\n  1052\u2192    completed_check:\\n  1053\u2192      type: any\\n  1054\u2192      checks:\\n  1055\u2192        - type: file_exists\\n  1056\u2192          path: \\\".env\\\"\\n  1057\u2192        - type: file_exists\\n  1058\u2192          path: \\\".env.local\\\"\\n  1059\u2192\\\"#;\\n  1060\u2192        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n  1061\u2192        let check = config.steps[\\\"env\\\"].completed_check.as_ref().unwrap();\\n  1062\u2192        assert!(matches!(check, CompletedCheck::Any { .. }));\\n  1063\u2192    }\\n  1064\u2192\\n  1065\u2192    #[test]\\n  1066\u2192    fn parses_marker_check() {\\n  1067\u2192        let yaml = r#\\\"\\n  1068\u2192steps:\\n  1069\u2192  setup:\\n  1070\u2192    command: \\\"./setup.sh\\\"\\n  1071\u2192    completed_check:\\n  1072\u2192      type: marker\\n  1073\u2192\\\"#;\\n  1074\u2192        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n  1075\u2192        let check = config.steps[\\\"setup\\\"].completed_check.as_ref().unwrap();\\n  1076\u2192        assert!(matches!(check, CompletedCheck::Marker));\\n  1077\u2192    }\\n  1078\u2192\\n  1079\u2192    #[test]\\n  1080\u2192    fn serialize_omits_default_values() {\\n  1081\u2192        let config: BivvyConfig = serde_yaml::from_str(\\n  1082\u2192            r#\\\"\\n  1083\u2192app_name: \\\"TestApp\\\"\\n  1084\u2192steps:\\n  1085\u2192  hello:\\n  1086\u2192    command: \\\"echo hello\\\"\\n  1087\u2192workflows:\\n  1088\u2192  default:\\n  1089\u2192    steps: [hello]\\n  1090\u2192\\\"#,\\n  1091\u2192        )\\n  1092\u2192        .unwrap();\\n  1093\u2192\\n  1094\u2192        let yaml = serde_yaml::to_string(&config).unwrap();\\n  1095\u2192\\n  1096\u2192        // Should include explicitly set fields\\n  1097\u2192        assert!(yaml.contains(\\\"app_name\\\"));\\n  1098\u2192        assert!(yaml.contains(\\\"command\\\"));\\n  1099\u2192\\n  1100\u2192        // Should NOT include default/empty fields\\n  1101\u2192        assert!(\\n  1102\u2192            !yaml.contains(\\\"template_sources\\\"),\\n  1103\u2192            \\\"empty template_sources should be omitted\\\"\\n  1104\u2192        );\\n  1105\u2192        assert!(!yaml.contains(\\\"secrets\\\"), \\\"empty secrets should be omitted\\\");\\n  1106\u2192        assert!(\\n  1107\u2192            !yaml.contains(\\\"requirements\\\"),\\n  1108\u2192            \\\"empty requirements should be omitted\\\"\\n  1109\u2192        );\\n  1110\u2192        assert!(!yaml.contains(\\\"extends\\\"), \\\"None extends should be omitted\\\");\\n  1111\u2192        assert!(\\n  1112\u2192            !yaml.contains(\\\"log_path\\\"),\\n  1113\u2192            \\\"None log_path should be omitted\\\"\\n  1114\u2192        );\\n  1115\u2192        assert!(!yaml.contains(\\\"logging\\\"), \\\"false logging should be omitted\\\");\\n  1116\u2192        assert!(\\n  1117\u2192            !yaml.contains(\\\"parallel\\\"),\\n  1118\u2192            \\\"false parallel should be omitted\\\"\\n  1119\u2192        );\\n  1120\u2192        assert!(\\n  1121\u2192            !yaml.contains(\\\"max_parallel\\\"),\\n  1122\u2192            \\\"default max_parallel should be omitted\\\"\\n  1123\u2192        );\\n  1124\u2192        assert!(\\n  1125\u2192            !yaml.contains(\\\"history_retention\\\"),\\n  1126\u2192            \\\"default history_retention should be omitted\\\"\\n  1127\u2192        );\\n  1128\u2192        assert!(\\n  1129\u2192            !yaml.contains(\\\"secret_env\\\"),\\n  1130\u2192            \\\"empty secret_env should be omitted\\\"\\n  1131\u2192        );\\n  1132\u2192        assert!(\\n  1133\u2192            !yaml.contains(\\\"depends_on\\\"),\\n  1134\u2192            \\\"empty depends_on should be omitted\\\"\\n  1135\u2192        );\\n  1136\u2192        assert!(!yaml.contains(\\\"watches\\\"), \\\"empty watches should be omitted\\\");\\n  1137\u2192        assert!(\\n  1138\u2192            !yaml.contains(\\\"skippable\\\"),\\n  1139\u2192            \\\"default true skippable should be omitted\\\"\\n  1140\u2192        );\\n  1141\u2192        assert!(\\n  1142\u2192            !yaml.contains(\\\"prompt_if_complete\\\"),\\n  1143\u2192            \\\"default true prompt_if_complete should be omitted\\\"\\n  1144\u2192        );\\n  1145\u2192        assert!(\\n  1146\u2192            !yaml.contains(\\\"required\\\"),\\n  1147\u2192            \\\"false required should be omitted\\\"\\n  1148\u2192        );\\n  1149\u2192        assert!(\\n  1150\u2192            !yaml.contains(\\\"allow_failure\\\"),\\n  1151\u2192            \\\"false allow_failure should be omitted\\\"\\n  1152\u2192        );\\n  1153\u2192        assert!(!yaml.contains(\\\"retry\\\"), \\\"zero retry should be omitted\\\");\\n  1154\u2192        assert!(\\n  1155\u2192            !yaml.contains(\\\"sensitive\\\"),\\n  1156\u2192            \\\"false sensitive should be omitted\\\"\\n  1157\u2192        );\\n  1158\u2192        assert!(\\n  1159\u2192            !yaml.contains(\\\"requires_sudo\\\"),\\n  1160\u2192            \\\"false requires_sudo should be omitted\\\"\\n  1161\u2192        );\\n  1162\u2192        assert!(!yaml.contains(\\\"before\\\"), \\\"empty before should be omitted\\\");\\n  1163\u2192        assert!(!yaml.contains(\\\"after\\\"), \\\"empty after should be omitted\\\");\\n  1164\u2192        assert!(!yaml.contains(\\\"prompts\\\"), \\\"empty prompts should be omitted\\\");\\n  1165\u2192        assert!(\\n  1166\u2192            !yaml.contains(\\\"requires\\\"),\\n  1167\u2192            \\\"empty requires should be omitted\\\"\\n  1168\u2192        );\\n  1169\u2192        assert!(\\n  1170\u2192            !yaml.contains(\\\"environments\\\"),\\n  1171\u2192            \\\"empty environments should be omitted\\\"\\n  1172\u2192        );\\n  1173\u2192        assert!(\\n  1174\u2192            !yaml.contains(\\\"only_environments\\\"),\\n  1175\u2192            \\\"empty only_environments should be omitted\\\"\\n  1176\u2192        );\\n  1177\u2192        assert!(\\n  1178\u2192            !yaml.contains(\\\"default_environment\\\"),\\n  1179\u2192            \\\"None default_environment should be omitted\\\"\\n  1180\u2192        );\\n  1181\u2192        assert!(\\n  1182\u2192            !yaml.contains(\\\"overrides\\\"),\\n  1183\u2192            \\\"empty overrides should be omitted\\\"\\n  1184\u2192        );\\n  1185\u2192    }\\n  1186\u2192\\n  1187\u2192    #[test]\\n  1188\u2192    fn serialize_includes_non_default_values() {\\n  1189\u2192        let config: BivvyConfig = serde_yaml::from_str(\\n  1190\u2192            r#\\\"\\n  1191\u2192steps:\\n  1192\u2192  test:\\n  1193\u2192    command: \\\"echo test\\\"\\n  1194\u2192    required: true\\n  1195\u2192    skippable: false\\n  1196\u2192    retry: 3\\n  1197\u2192    allow_failure: true\\n  1198\u2192    sensitive: true\\n  1199\u2192    watches: [Gemfile]\\n  1200\u2192    depends_on: [other]\\n  1201\u2192    before: [\\\"echo pre\\\"]\\n  1202\u2192    after: [\\\"echo post\\\"]\\n  1203\u2192settings:\\n  1204\u2192  logging: true\\n  1205\u2192  parallel: true\\n  1206\u2192  max_parallel: 8\\n  1207\u2192\\\"#,\\n  1208\u2192        )\\n  1209\u2192        .unwrap();\\n  1210\u2192\\n  1211\u2192        let yaml = serde_yaml::to_string(&config).unwrap();\\n  1212\u2192\\n  1213\u2192        assert!(\\n  1214\u2192            yaml.contains(\\\"required\\\"),\\n  1215\u2192            \\\"non-default required should be present\\\"\\n  1216\u2192        );\\n  1217\u2192        assert!(\\n  1218\u2192            yaml.contains(\\\"skippable\\\"),\\n  1219\u2192            \\\"non-default skippable should be present\\\"\\n  1220\u2192        );\\n  1221\u2192        assert!(yaml.contains(\\\"retry\\\"), \\\"non-zero retry should be present\\\");\\n  1222\u2192        assert!(\\n  1223\u2192            yaml.contains(\\\"allow_failure\\\"),\\n  1224\u2192            \\\"true allow_failure should be present\\\"\\n  1225\u2192        );\\n  1226\u2192        assert!(\\n  1227\u2192            yaml.contains(\\\"sensitive\\\"),\\n  1228\u2192            \\\"true sensitive should be present\\\"\\n  1229\u2192        );\\n  1230\u2192        assert!(\\n  1231\u2192            yaml.contains(\\\"watches\\\"),\\n  1232\u2192            \\\"non-empty watches should be present\\\"\\n  1233\u2192        );\\n  1234\u2192        assert!(\\n  1235\u2192            yaml.contains(\\\"depends_on\\\"),\\n  1236\u2192            \\\"non-empty depends_on should be present\\\"\\n  1237\u2192        );\\n  1238\u2192        assert!(\\n  1239\u2192            yaml.contains(\\\"before\\\"),\\n  1240\u2192            \\\"non-empty before should be present\\\"\\n  1241\u2192        );\\n  1242\u2192        assert!(yaml.contains(\\\"after\\\"), \\\"non-empty after should be present\\\");\\n  1243\u2192        assert!(yaml.contains(\\\"logging\\\"), \\\"true logging should be present\\\");\\n  1244\u2192        assert!(yaml.contains(\\\"parallel\\\"), \\\"true parallel should be present\\\");\\n  1245\u2192        assert!(\\n  1246\u2192            yaml.contains(\\\"max_parallel\\\"),\\n  1247\u2192            \\\"non-default max_parallel should be present\\\"\\n  1248\u2192        );\\n  1249\u2192    }\\n  1250\u2192\\n  1251\u2192    #[test]\\n  1252\u2192    fn step_config_requires_defaults_empty() {\\n  1253\u2192        let yaml = r#\\\"\\n  1254\u2192            command: \\\"echo hello\\\"\\n  1255\u2192        \\\"#;\\n  1256\u2192        let config: StepConfig = serde_yaml::from_str(yaml).unwrap();\\n  1257\u2192        assert!(config.requires.is_empty());\\n  1258\u2192    }\\n  1259\u2192\\n  1260\u2192    #[test]\\n  1261\u2192    fn step_config_requires_parses() {\\n  1262\u2192        let yaml = r#\\\"\\n  1263\u2192            command: \\\"bundle install\\\"\\n  1264\u2192            requires:\\n  1265\u2192              - ruby\\n  1266\u2192              - postgres-server\\n  1267\u2192        \\\"#;\\n  1268\u2192        let config: StepConfig = serde_yaml::from_str(yaml).unwrap();\\n  1269\u2192        assert_eq!(config.requires, vec![\\\"ruby\\\", \\\"postgres-server\\\"]);\\n  1270\u2192    }\\n  1271\u2192\\n  1272\u2192    #[test]\\n  1273\u2192    fn custom_requirement_parses() {\\n  1274\u2192        let yaml = r#\\\"\\n  1275\u2192requirements:\\n  1276\u2192  internal-cli:\\n  1277\u2192    check:\\n  1278\u2192      type: command_succeeds\\n  1279\u2192      command: \\\"internal-cli --version\\\"\\n  1280\u2192    install_hint: \\\"Download from https://internal.company.com/cli\\\"\\n  1281\u2192\\\"#;\\n  1282\u2192        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n  1283\u2192        assert!(config.requirements.contains_key(\\\"internal-cli\\\"));\\n  1284\u2192        let req = &config.requirements[\\\"internal-cli\\\"];\\n  1285\u2192        assert!(matches!(\\n  1286\u2192            &req.check,\\n  1287\u2192            CustomRequirementCheck::CommandSucceeds { command } if command == \\\"internal-cli --version\\\"\\n  1288\u2192        ));\\n  1289\u2192        assert_eq!(\\n  1290\u2192            req.install_hint,\\n  1291\u2192            Some(\\\"Download from https://internal.company.com/cli\\\".to_string())\\n  1292\u2192        );\\n  1293\u2192        assert!(req.install_template.is_none());\\n  1294\u2192    }\\n  1295\u2192\\n  1296\u2192    #[test]\\n  1297\u2192    fn custom_requirement_service_check_parses() {\\n  1298\u2192        let yaml = r#\\\"\\n  1299\u2192requirements:\\n  1300\u2192  minio:\\n  1301\u2192    check:\\n  1302\u2192      type: service_reachable\\n  1303\u2192      command: \\\"curl -sf http://localhost:9000/minio/health/live\\\"\\n  1304\u2192    install_hint: \\\"Run: docker compose up -d minio\\\"\\n  1305\u2192\\\"#;\\n  1306\u2192        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n  1307\u2192        let req = &config.requirements[\\\"minio\\\"];\\n  1308\u2192        assert!(matches!(\\n  1309\u2192            &req.check,\\n  1310\u2192            CustomRequirementCheck::ServiceReachable { command } if command.contains(\\\"curl\\\")\\n  1311\u2192        ));\\n  1312\u2192    }\\n  1313\u2192\\n  1314\u2192    #[test]\\n  1315\u2192    fn custom_requirement_with_install_template() {\\n  1316\u2192        let yaml = r#\\\"\\n  1317\u2192requirements:\\n  1318\u2192  libvips:\\n  1319\u2192    check:\\n  1320\u2192      type: command_succeeds\\n  1321\u2192      command: \\\"vips --version\\\"\\n  1322\u2192    install_template: libvips\\n  1323\u2192\\\"#;\\n  1324\u2192        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n  1325\u2192        let req = &config.requirements[\\\"libvips\\\"];\\n  1326\u2192        assert_eq!(req.install_template, Some(\\\"libvips\\\".to_string()));\\n  1327\u2192    }\\n  1328\u2192\\n  1329\u2192    #[test]\\n  1330\u2192    fn custom_requirement_file_exists_check() {\\n  1331\u2192        let yaml = r#\\\"\\n  1332\u2192requirements:\\n  1333\u2192  local-config:\\n  1334\u2192    check:\\n  1335\u2192      type: file_exists\\n  1336\u2192      path: \\\"/etc/myapp/config.yml\\\"\\n  1337\u2192\\\"#;\\n  1338\u2192        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n  1339\u2192        let req = &config.requirements[\\\"local-config\\\"];\\n  1340\u2192        assert!(matches!(\\n  1341\u2192            &req.check,\\n  1342\u2192            CustomRequirementCheck::FileExists { path } if path == \\\"/etc/myapp/config.yml\\\"\\n  1343\u2192        ));\\n  1344\u2192    }\\n  1345\u2192\\n  1346\u2192    #[test]\\n  1347\u2192    fn empty_requirements_defaults() {\\n  1348\u2192        let yaml = r#\\\"\\n  1349\u2192app_name: \\\"TestApp\\\"\\n  1350\u2192\\\"#;\\n  1351\u2192        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n  1352\u2192        assert!(config.requirements.is_empty());\\n  1353\u2192    }\\n  1354\u2192\\n  1355\u2192    #[test]\\n  1356\u2192    fn settings_default_environment_defaults_none() {\\n  1357\u2192        let config: BivvyConfig = serde_yaml::from_str(\\\"\\\").unwrap();\\n  1358\u2192        assert!(config.settings.default_environment.is_none());\\n  1359\u2192        assert!(config.settings.environments.is_empty());\\n  1360\u2192    }\\n  1361\u2192\\n  1362\u2192    #[test]\\n  1363\u2192    fn parses_default_environment() {\\n  1364\u2192        let yaml = r#\\\"\\n  1365\u2192settings:\\n  1366\u2192  default_environment: staging\\n  1367\u2192\\\"#;\\n  1368\u2192        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n  1369\u2192        assert_eq!(\\n  1370\u2192            config.settings.default_environment,\\n  1371\u2192            Some(\\\"staging\\\".to_string())\\n  1372\u2192        );\\n  1373\u2192    }\\n  1374\u2192\\n  1375\u2192    #[test]\\n  1376\u2192    fn parses_environment_config() {\\n  1377\u2192        let yaml = r#\\\"\\n  1378\u2192settings:\\n  1379\u2192  environments:\\n  1380\u2192    ci:\\n  1381\u2192      detect:\\n  1382\u2192        - env: CI\\n  1383\u2192        - env: GITHUB_ACTIONS\\n  1384\u2192      default_workflow: ci\\n  1385\u2192      provided_requirements:\\n  1386\u2192        - docker\\n  1387\u2192        - node\\n  1388\u2192    staging:\\n  1389\u2192      detect:\\n  1390\u2192        - env: DEPLOY_ENV\\n  1391\u2192          value: staging\\n  1392\u2192\\\"#;\\n  1393\u2192        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n  1394\u2192        assert_eq!(config.settings.environments.len(), 2);\\n  1395\u2192\\n  1396\u2192        let ci = &config.settings.environments[\\\"ci\\\"];\\n  1397\u2192        assert_eq!(ci.detect.len(), 2);\\n  1398\u2192        assert_eq!(ci.detect[0].env, \\\"CI\\\");\\n  1399\u2192        assert!(ci.detect[0].value.is_none());\\n  1400\u2192        assert_eq!(ci.default_workflow, Some(\\\"ci\\\".to_string()));\\n  1401\u2192        assert_eq!(ci.provided_requirements, vec![\\\"docker\\\", \\\"node\\\"]);\\n  1402\u2192\\n  1403\u2192        let staging = &config.settings.environments[\\\"staging\\\"];\\n  1404\u2192        assert_eq!(staging.detect.len(), 1);\\n  1405\u2192        assert_eq!(staging.detect[0].env, \\\"DEPLOY_ENV\\\");\\n  1406\u2192        assert_eq!(staging.detect[0].value, Some(\\\"staging\\\".to_string()));\\n  1407\u2192        assert!(staging.default_workflow.is_none());\\n  1408\u2192        assert!(staging.provided_requirements.is_empty());\\n  1409\u2192    }\\n  1410\u2192\\n  1411\u2192    #[test]\\n  1412\u2192    fn parses_step_environments_override() {\\n  1413\u2192        let yaml = r#\\\"\\n  1414\u2192steps:\\n  1415\u2192  database:\\n  1416\u2192    command: \\\"rails db:setup\\\"\\n  1417\u2192    environments:\\n  1418\u2192      ci:\\n  1419\u2192        command: \\\"rails db:schema:load\\\"\\n  1420\u2192        env:\\n  1421\u2192          RAILS_ENV: test\\n  1422\u2192\\\"#;\\n  1423\u2192        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n  1424\u2192        let step = &config.steps[\\\"database\\\"];\\n  1425\u2192        assert_eq!(step.environments.len(), 1);\\n  1426\u2192\\n  1427\u2192        let ci_override = &step.environments[\\\"ci\\\"];\\n  1428\u2192        assert_eq!(\\n  1429\u2192            ci_override.command,\\n  1430\u2192            Some(\\\"rails db:schema:load\\\".to_string())\\n  1431\u2192        );\\n  1432\u2192        assert_eq!(\\n  1433\u2192            ci_override.env.get(\\\"RAILS_ENV\\\"),\\n  1434\u2192            Some(&Some(\\\"test\\\".to_string()))\\n  1435\u2192        );\\n  1436\u2192    }\\n  1437\u2192\\n  1438\u2192    #[test]\\n  1439\u2192    fn parses_step_only_environments() {\\n  1440\u2192        let yaml = r#\\\"\\n  1441\u2192steps:\\n  1442\u2192  seeds:\\n  1443\u2192    command: \\\"rails db:seed\\\"\\n  1444\u2192    only_environments:\\n  1445\u2192      - development\\n  1446\u2192      - staging\\n  1447\u2192\\\"#;\\n  1448\u2192        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n  1449\u2192        let step = &config.steps[\\\"seeds\\\"];\\n  1450\u2192        assert_eq!(step.only_environments, vec![\\\"development\\\", \\\"staging\\\"]);\\n  1451\u2192    }\\n  1452\u2192\\n  1453\u2192    #[test]\\n  1454\u2192    fn step_only_environments_defaults_empty() {\\n  1455\u2192        let yaml = r#\\\"\\n  1456\u2192            command: \\\"echo hello\\\"\\n  1457\u2192        \\\"#;\\n  1458\u2192        let config: StepConfig = serde_yaml::from_str(yaml).unwrap();\\n  1459\u2192        // Empty means \\\"run in all environments\\\"\\n  1460\u2192        assert!(config.only_environments.is_empty());\\n  1461\u2192    }\\n  1462\u2192\\n  1463\u2192    #[test]\\n  1464\u2192    fn step_environments_defaults_empty() {\\n  1465\u2192        let yaml = r#\\\"\\n  1466\u2192            command: \\\"echo hello\\\"\\n  1467\u2192        \\\"#;\\n  1468\u2192        let config: StepConfig = serde_yaml::from_str(yaml).unwrap();\\n  1469\u2192        assert!(config.environments.is_empty());\\n  1470\u2192    }\\n  1471\u2192\\n  1472\u2192    #[test]\\n  1473\u2192    fn environment_config_defaults() {\\n  1474\u2192        let config: EnvironmentConfig = serde_yaml::from_str(\\\"\\\").unwrap();\\n  1475\u2192        assert!(config.detect.is_empty());\\n  1476\u2192        assert!(config.default_workflow.is_none());\\n  1477\u2192        assert!(config.provided_requirements.is_empty());\\n  1478\u2192    }\\n  1479\u2192\\n  1480\u2192    #[test]\\n  1481\u2192    fn parses_nested_composite_checks() {\\n  1482\u2192        let yaml = r#\\\"\\n  1483\u2192steps:\\n  1484\u2192  complex:\\n  1485\u2192    command: \\\"echo complex\\\"\\n  1486\u2192    completed_check:\\n  1487\u2192      type: all\\n  1488\u2192      checks:\\n  1489\u2192        - type: file_exists\\n  1490\u2192          path: \\\"required.txt\\\"\\n  1491\u2192        - type: any\\n  1492\u2192          checks:\\n  1493\u2192            - type: file_exists\\n  1494\u2192              path: \\\"option_a.txt\\\"\\n  1495\u2192            - type: file_exists\\n  1496\u2192              path: \\\"option_b.txt\\\"\\n  1497\u2192\\\"#;\\n  1498\u2192        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n  1499\u2192        let check = config.steps[\\\"complex\\\"].completed_check.as_ref().unwrap();\\n  1500\u2192        if let CompletedCheck::All { checks } = check {\\n  1501\u2192            assert_eq!(checks.len(), 2);\\n  1502\u2192            assert!(matches!(&checks[1], CompletedCheck::Any { .. }));\\n  1503\u2192        } else {\\n  1504\u2192            panic!(\\\"Expected All check\\\");\\n  1505\u2192        }\\n  1506\u2192    }\\n  1507\u2192\\n  1508\u2192    // --- 7A: Schema override parsing tests ---\\n  1509\u2192\\n  1510\u2192    #[test]\\n  1511\u2192    fn environment_override_depends_on_parses() {\\n  1512\u2192        let yaml = r#\\\"\\n  1513\u2192            depends_on: [a, b]\\n  1514\u2192        \\\"#;\\n  1515\u2192        let o: StepEnvironmentOverride = serde_yaml::from_str(yaml).unwrap();\\n  1516\u2192        assert_eq!(o.depends_on, Some(vec![\\\"a\\\".to_string(), \\\"b\\\".to_string()]));\\n  1517\u2192    }\\n  1518\u2192\\n  1519\u2192    #[test]\\n  1520\u2192    fn environment_override_watches_parses() {\\n  1521\u2192        let yaml = r#\\\"\\n  1522\u2192            watches: []\\n  1523\u2192        \\\"#;\\n  1524\u2192        let o: StepEnvironmentOverride = serde_yaml::from_str(yaml).unwrap();\\n  1525\u2192        assert_eq!(o.watches, Some(vec![]));\\n  1526\u2192    }\\n  1527\u2192\\n  1528\u2192    #[test]\\n  1529\u2192    fn environment_override_title_parses() {\\n  1530\u2192        let yaml = r#\\\"\\n  1531\u2192            title: \\\"CI Title\\\"\\n  1532\u2192        \\\"#;\\n  1533\u2192        let o: StepEnvironmentOverride = serde_yaml::from_str(yaml).unwrap();\\n  1534\u2192        assert_eq!(o.title, Some(\\\"CI Title\\\".to_string()));\\n  1535\u2192    }\\n  1536\u2192\\n  1537\u2192    // --- Vars parsing tests ---\\n  1538\u2192\\n  1539\u2192    #[test]\\n  1540\u2192    fn parses_static_var() {\\n  1541\u2192        let yaml = r#\\\"\\n  1542\u2192vars:\\n  1543\u2192  name: \\\"bivvy\\\"\\n  1544\u2192\\\"#;\\n  1545\u2192        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n  1546\u2192        assert!(matches!(\\n  1547\u2192            config.vars.get(\\\"name\\\"),\\n  1548\u2192            Some(VarDefinition::Static(v)) if v == \\\"bivvy\\\"\\n  1549\u2192        ));\\n  1550\u2192    }\\n  1551\u2192\\n  1552\u2192    #[test]\\n  1553\u2192    fn parses_computed_var() {\\n  1554\u2192        let yaml = r#\\\"\\n  1555\u2192vars:\\n  1556\u2192  v:\\n  1557\u2192    command: \\\"echo 1\\\"\\n  1558\u2192\\\"#;\\n  1559\u2192        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n  1560\u2192        assert!(matches!(\\n  1561\u2192            config.vars.get(\\\"v\\\"),\\n  1562\u2192            Some(VarDefinition::Computed { command }) if command == \\\"echo 1\\\"\\n  1563\u2192        ));\\n  1564\u2192    }\\n  1565\u2192\\n  1566\u2192    #[test]\\n  1567\u2192    fn parses_mixed_vars() {\\n  1568\u2192        let yaml = r#\\\"\\n  1569\u2192vars:\\n  1570\u2192  app_name: \\\"bivvy\\\"\\n  1571\u2192  version:\\n  1572\u2192    command: \\\"echo 1.0.0\\\"\\n  1573\u2192\\\"#;\\n  1574\u2192        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n  1575\u2192        assert_eq!(config.vars.len(), 2);\\n  1576\u2192        assert!(matches!(\\n  1577\u2192            config.vars.get(\\\"app_name\\\"),\\n  1578\u2192            Some(VarDefinition::Static(_))\\n  1579\u2192        ));\\n  1580\u2192        assert!(matches!(\\n  1581\u2192            config.vars.get(\\\"version\\\"),\\n  1582\u2192            Some(VarDefinition::Computed { .. })\\n  1583\u2192        ));\\n  1584\u2192    }\\n  1585\u2192\\n  1586\u2192    #[test]\\n  1587\u2192    fn empty_vars_defaults() {\\n  1588\u2192        let config: BivvyConfig = serde_yaml::from_str(\\\"\\\").unwrap();\\n  1589\u2192        assert!(config.vars.is_empty());\\n  1590\u2192    }\\n  1591\u2192\\n  1592\u2192    #[test]\\n  1593\u2192    fn serialize_omits_empty_vars() {\\n  1594\u2192        let config: BivvyConfig = serde_yaml::from_str(\\\"app_name: test\\\").unwrap();\\n  1595\u2192        let yaml = serde_yaml::to_string(&config).unwrap();\\n  1596\u2192        assert!(!yaml.contains(\\\"vars\\\"), \\\"empty vars should be omitted\\\");\\n  1597\u2192    }\\n  1598\u2192\\n  1599\u2192    // --- Precondition parsing tests ---\\n  1600\u2192\\n  1601\u2192    #[test]\\n  1602\u2192    fn parses_precondition_command_succeeds() {\\n  1603\u2192        let yaml = r#\\\"\\n  1604\u2192steps:\\n  1605\u2192  release:\\n  1606\u2192    command: \\\"git tag v1\\\"\\n  1607\u2192    precondition:\\n  1608\u2192      type: command_succeeds\\n  1609\u2192      command: \\\"test $(git branch --show-current) = main\\\"\\n  1610\u2192\\\"#;\\n  1611\u2192        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n  1612\u2192        let step = &config.steps[\\\"release\\\"];\\n  1613\u2192        assert!(matches!(\\n  1614\u2192            step.precondition,\\n  1615\u2192            Some(CompletedCheck::CommandSucceeds { .. })\\n  1616\u2192        ));\\n  1617\u2192    }\\n  1618\u2192\\n  1619\u2192    #[test]\\n  1620\u2192    fn parses_precondition_all() {\\n  1621\u2192        let yaml = r#\\\"\\n  1622\u2192steps:\\n  1623\u2192  release:\\n  1624\u2192    command: \\\"git tag v1\\\"\\n  1625\u2192    precondition:\\n  1626\u2192      type: all\\n  1627\u2192      checks:\\n  1628\u2192        - type: command_succeeds\\n  1629\u2192          command: \\\"test $(git branch --show-current) = main\\\"\\n  1630\u2192        - type: command_succeeds\\n  1631\u2192          command: \\\"git diff --quiet\\\"\\n  1632\u2192\\\"#;\\n  1633\u2192        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n  1634\u2192        let step = &config.steps[\\\"release\\\"];\\n  1635\u2192        if let Some(CompletedCheck::All { checks }) = &step.precondition {\\n  1636\u2192            assert_eq!(checks.len(), 2);\\n  1637\u2192        } else {\\n  1638\u2192            panic!(\\\"Expected All precondition\\\");\\n  1639\u2192        }\\n  1640\u2192    }\\n  1641\u2192\\n  1642\u2192    #[test]\\n  1643\u2192    fn precondition_defaults_none() {\\n  1644\u2192        let yaml = r#\\\"\\n  1645\u2192            command: \\\"echo hello\\\"\\n  1646\u2192        \\\"#;\\n  1647\u2192        let config: StepConfig = serde_yaml::from_str(yaml).unwrap();\\n  1648\u2192        assert!(config.precondition.is_none());\\n  1649\u2192    }\\n  1650\u2192\\n  1651\u2192    #[test]\\n  1652\u2192    fn serialize_omits_none_precondition() {\\n  1653\u2192        let config: BivvyConfig = serde_yaml::from_str(\\n  1654\u2192            r#\\\"\\n  1655\u2192steps:\\n  1656\u2192  hello:\\n  1657\u2192    command: \\\"echo hello\\\"\\n  1658\u2192\\\"#,\\n  1659\u2192        )\\n  1660\u2192        .unwrap();\\n  1661\u2192        let yaml = serde_yaml::to_string(&config).unwrap();\\n  1662\u2192        assert!(\\n  1663\u2192            !yaml.contains(\\\"precondition\\\"),\\n  1664\u2192            \\\"None precondition should be omitted\\\"\\n  1665\u2192        );\\n  1666\u2192    }\\n  1667\u2192\\n  1668\u2192    #[test]\\n  1669\u2192    fn environment_override_bare_null_parses_as_none() {\\n  1670\u2192        let yaml = \\\"command:\\\";\\n  1671\u2192        let o: StepEnvironmentOverride = serde_yaml::from_str(yaml).unwrap();\\n  1672\u2192        assert!(o.command.is_none());\\n  1673\u2192    }\\n  1674\u2192\\n  1675\u2192    #[test]\\n  1676\u2192    fn environment_override_empty_string_is_not_null() {\\n  1677\u2192        let yaml = r#\\\"command: \\\"\\\"\\\"#;\\n  1678\u2192        let o: StepEnvironmentOverride = serde_yaml::from_str(yaml).unwrap();\\n  1679\u2192        assert_eq!(o.command, Some(\\\"\\\".to_string()));\\n  1680\u2192    }\\n  1681\u2192}\\n  1682\u2192\"}]},\"parent_tool_use_id\":null,\"session_id\":\"71626d50-8e30-42b0-86de-6cafbf80e23f\",\"uuid\":\"c4ea80dd-8fd4-4674-8199-9643b89e01fe\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/private/var/folders/_q/qzh8_t6s15388qqf3p6n3d200000gp/T/bench-7okzbcvu/src/config/schema.rs\",\"content\":\"#[derive(Debug, Clone, Default, Serialize, Deserialize)]\\n#[serde(default)]\\npub struct EnvironmentConfig {\\n    /// Rules for auto-detecting this environment.\\n    #[serde(default, skip_serializing_if = \\\"Vec::is_empty\\\")]\\n    pub detect: Vec<EnvironmentDetectRule>,\\n\\n    /// Default workflow to run in this environment.\\n    #[serde(skip_serializing_if = \\\"Option::is_none\\\")]\\n    pub default_workflow: Option<String>,\\n\\n    /// Requirements that are assumed to be satisfied in this environment.\\n    /// These skip gap detection checks when this environment is active.\\n    #[serde(default, skip_serializing_if = \\\"Vec::is_empty\\\")]\\n    pub provided_requirements: Vec<String>,\\n}\\n\\n/// A rule for auto-detecting an environment.\\n#[derive(Debug, Clone, Serialize, Deserialize)]\\npub struct EnvironmentDetectRule {\\n    /// Environment variable name to check.\\n    pub env: String,\\n\\n    /// If set, the variable must equal this value. If absent, just checks presence.\\n    #[serde(skip_serializing_if = \\\"Option::is_none\\\")]\\n    pub value: Option<String>,\\n}\\n\\n/// Per-environment overrides for a step.\\n///\\n/// All fields are `Option` \u2014 only specified fields override the base step.\\n/// The `env` field uses `HashMap<String, Option<String>>`:\\n/// `Some(val)` = set/override, `None` = remove the key from the base env.\\n#[derive(Debug, Clone, Default, Serialize, Deserialize)]\\n#[serde(default)]\\npub struct StepEnvironmentOverride {\\n    /// Override step title\\n    #[serde(skip_serializing_if = \\\"Option::is_none\\\")]\\n    pub title: Option<String>,\\n\\n    /// Override step description\\n    #[serde(skip_serializing_if = \\\"Option::is_none\\\")]\\n    pub description: Option<String>,\\n\\n    /// Override step command\\n    #[serde(skip_serializing_if = \\\"Option::is_none\\\")]\\n    pub command: Option<String>,\\n\\n    /// Override/remove env vars (None value = remove key)\\n    #[serde(default, skip_serializing_if = \\\"HashMap::is_empty\\\")]\\n    pub env: HashMap<String, Option<String>>,\\n\\n    /// Override completed check\\n    #[serde(skip_serializing_if = \\\"Option::is_none\\\")]\\n    pub completed_check: Option<CompletedCheck>,\\n\\n    /// Override precondition\\n    #[serde(skip_serializing_if = \\\"Option::is_none\\\")]\\n    pub precondition: Option<CompletedCheck>,\\n\\n    /// Override skippable\\n    #[serde(skip_serializing_if = \\\"Option::is_none\\\")]\\n    pub skippable: Option<bool>,\\n\\n    /// Override allow_failure\\n    #[serde(skip_serializing_if = \\\"Option::is_none\\\")]\\n    pub allow_failure: Option<bool>,\\n\\n    /// Override requires_sudo\\n    #[serde(skip_serializing_if = \\\"Option::is_none\\\")]\\n    pub requires_sudo: Option<bool>,\\n\\n    /// Override sensitive\\n    #[serde(skip_serializing_if = \\\"Option::is_none\\\")]\\n    pub sensitive: Option<bool>,\\n\\n    /// Override before hooks\\n    #[serde(skip_serializing_if = \\\"Option::is_none\\\")]\\n    pub before: Option<Vec<String>>,\\n\\n    /// Override after hooks\\n    #[serde(skip_serializing_if = \\\"Option::is_none\\\")]\\n    pub after: Option<Vec<String>>,\\n\\n    /// Override dependencies\\n    #[serde(skip_serializing_if = \\\"Option::is_none\\\")]\\n    pub depends_on: Option<Vec<String>>,\\n\\n    /// Override requirements\\n    #[serde(skip_serializing_if = \\\"Option::is_none\\\")]\\n    pub requires: Option<Vec<String>>,\\n\\n    /// Override watches\\n    #[serde(skip_serializing_if = \\\"Option::is_none\\\")]\\n    pub watches: Option<Vec<String>>,\\n\\n    /// Override retry count\\n    #[serde(skip_serializing_if = \\\"Option::is_none\\\")]\\n    pub retry: Option<u32>,\\n}\\n\\n#[cfg(test)]\\nmod tests {\\n    use super::*;\\n\\n    #[test]\\n    fn empty_config_has_defaults() {\\n        let config: BivvyConfig = serde_yaml::from_str(\\\"\\\").unwrap();\\n        assert_eq!(config.settings.default_output, OutputMode::Verbose);\\n        assert_eq!(config.settings.max_parallel, 4);\\n        assert_eq!(config.settings.history_retention, 50);\\n        assert!(config.steps.is_empty());\\n        assert!(config.workflows.is_empty());\\n    }\\n\\n    #[test]\\n    fn parses_minimal_config() {\\n        let yaml = r#\\\"\\napp_name: \\\"MyApp\\\"\\nsettings:\\n  default_output: quiet\\n\\\"#;\\n        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n        assert_eq!(config.app_name, Some(\\\"MyApp\\\".to_string()));\\n        assert_eq!(config.settings.default_output, OutputMode::Quiet);\\n    }\\n\\n    #[test]\\n    fn parses_template_sources() {\\n        let yaml = r#\\\"\\ntemplate_sources:\\n  - url: \\\"https://example.com/templates\\\"\\n    priority: 10\\n    timeout: 60\\n\\\"#;\\n        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n        assert_eq!(config.template_sources.len(), 1);\\n        assert_eq!(config.template_sources[0].priority, 10);\\n        assert_eq!(config.template_sources[0].timeout, 60);\\n    }\\n\\n    #[test]\\n    fn parses_settings_with_env() {\\n        let yaml = r#\\\"\\nsettings:\\n  logging: true\\n  log_path: \\\"logs/bivvy.log\\\"\\n  env:\\n    RAILS_ENV: development\\n    DEBUG: \\\"true\\\"\\n  parallel: true\\n  max_parallel: 8\\n\\\"#;\\n        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n        assert!(config.settings.logging);\\n        assert_eq!(\\n            config.settings.log_path,\\n            Some(PathBuf::from(\\\"logs/bivvy.log\\\"))\\n        );\\n        assert_eq!(\\n            config.settings.env.get(\\\"RAILS_ENV\\\"),\\n            Some(&\\\"development\\\".to_string())\\n        );\\n        assert!(config.settings.parallel);\\n        assert_eq!(config.settings.max_parallel, 8);\\n    }\\n\\n    #[test]\\n    fn parses_extends_config() {\\n        let yaml = r#\\\"\\nextends:\\n  - url: \\\"https://example.com/base-config.yml\\\"\\n\\\"#;\\n        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n        assert!(config.extends.is_some());\\n        assert_eq!(config.extends.as_ref().unwrap().len(), 1);\\n    }\\n\\n    #[test]\\n    fn parses_secrets_config() {\\n        let yaml = r#\\\"\\nsecrets:\\n  db_password:\\n    command: \\\"op read op://vault/database/password\\\"\\n\\\"#;\\n        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n        assert!(config.secrets.contains_key(\\\"db_password\\\"));\\n    }\\n\\n    #[test]\\n    fn parses_step_with_template() {\\n        let yaml = r#\\\"\\nsteps:\\n  node_deps:\\n    template: yarn\\n    inputs:\\n      frozen: true\\n\\\"#;\\n        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n        let step = &config.steps[\\\"node_deps\\\"];\\n        assert_eq!(step.template, Some(\\\"yarn\\\".to_string()));\\n    }\\n\\n    #[test]\\n    fn parses_step_with_inline_config() {\\n        let yaml = r#\\\"\\nsteps:\\n  custom:\\n    title: \\\"Custom Step\\\"\\n    command: \\\"echo hello\\\"\\n    depends_on: [other]\\n    env:\\n      MY_VAR: \\\"value\\\"\\n\\\"#;\\n        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n        let step = &config.steps[\\\"custom\\\"];\\n        assert_eq!(step.title, Some(\\\"Custom Step\\\".to_string()));\\n        assert_eq!(step.command, Some(\\\"echo hello\\\".to_string()));\\n        assert_eq!(step.depends_on, vec![\\\"other\\\"]);\\n    }\\n\\n    #[test]\\n    fn step_defaults_are_correct() {\\n        let yaml = r#\\\"\\nsteps:\\n  minimal:\\n    command: \\\"echo test\\\"\\n\\\"#;\\n        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n        let step = &config.steps[\\\"minimal\\\"];\\n        assert!(step.skippable);\\n        assert!(!step.required);\\n        assert!(step.prompt_if_complete);\\n        assert!(!step.allow_failure);\\n        assert_eq!(step.retry, 0);\\n    }\\n\\n    #[test]\\n    fn parses_step_with_prompts() {\\n        let yaml = r#\\\"\\nsteps:\\n  interactive:\\n    command: \\\"yarn ${install_mode}\\\"\\n    prompts:\\n      - key: install_mode\\n        question: \\\"How to install?\\\"\\n        type: select\\n        options:\\n          - label: \\\"Normal\\\"\\n            value: \\\"install\\\"\\n          - label: \\\"Frozen\\\"\\n            value: \\\"install --frozen-lockfile\\\"\\n\\\"#;\\n        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n        let step = &config.steps[\\\"interactive\\\"];\\n        assert_eq!(step.prompts.len(), 1);\\n        assert_eq!(step.prompts[0].key, \\\"install_mode\\\");\\n        assert_eq!(step.prompts[0].options.len(), 2);\\n    }\\n\\n    #[test]\\n    fn parses_step_with_hooks() {\\n        let yaml = r#\\\"\\nsteps:\\n  database:\\n    command: \\\"rails db:setup\\\"\\n    before:\\n      - echo \\\"Starting...\\\"\\n    after:\\n      - echo \\\"Done!\\\"\\n\\\"#;\\n        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n        let step = &config.steps[\\\"database\\\"];\\n        assert_eq!(step.before.len(), 1);\\n        assert_eq!(step.after.len(), 1);\\n    }\\n\\n    #[test]\\n    fn step_config_defaults_to_empty_hooks() {\\n        let yaml = r#\\\"\\n            command: \\\"echo hello\\\"\\n        \\\"#;\\n        let config: StepConfig = serde_yaml::from_str(yaml).unwrap();\\n\\n        assert!(config.before.is_empty());\\n        assert!(config.after.is_empty());\\n    }\\n\\n    #[test]\\n    fn step_config_parses_before_hooks() {\\n        let yaml = r#\\\"\\n            command: \\\"echo main\\\"\\n            before:\\n              - \\\"echo pre-1\\\"\\n              - \\\"echo pre-2\\\"\\n        \\\"#;\\n        let config: StepConfig = serde_yaml::from_str(yaml).unwrap();\\n\\n        assert_eq!(config.before.len(), 2);\\n        assert_eq!(config.before[0], \\\"echo pre-1\\\");\\n    }\\n\\n    #[test]\\n    fn step_config_parses_after_hooks() {\\n        let yaml = r#\\\"\\n            command: \\\"echo main\\\"\\n            after:\\n              - \\\"echo post-1\\\"\\n        \\\"#;\\n        let config: StepConfig = serde_yaml::from_str(yaml).unwrap();\\n\\n        assert_eq!(config.after.len(), 1);\\n    }\\n\\n    #[test]\\n    fn step_config_parses_both_hooks() {\\n        let yaml = r#\\\"\\n            command: \\\"bin/rails db:setup\\\"\\n            before:\\n              - \\\"echo Starting database setup...\\\"\\n              - \\\"./scripts/pre-db-check.sh\\\"\\n            after:\\n              - \\\"echo Database setup complete\\\"\\n        \\\"#;\\n        let config: StepConfig = serde_yaml::from_str(yaml).unwrap();\\n\\n        assert_eq!(config.before.len(), 2);\\n        assert_eq!(config.after.len(), 1);\\n    }\\n\\n    #[test]\\n    fn parses_step_with_watches() {\\n        let yaml = r#\\\"\\nsteps:\\n  deps:\\n    command: \\\"bundle install\\\"\\n    watches:\\n      - Gemfile\\n      - Gemfile.lock\\n\\\"#;\\n        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n        let step = &config.steps[\\\"deps\\\"];\\n        assert_eq!(step.watches, vec![\\\"Gemfile\\\", \\\"Gemfile.lock\\\"]);\\n    }\\n\\n    #[test]\\n    fn parses_workflow_definition() {\\n        let yaml = r#\\\"\\nworkflows:\\n  default:\\n    description: \\\"Full development setup\\\"\\n    steps: [brew, deps, database]\\n\\\"#;\\n        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n        let workflow = &config.workflows[\\\"default\\\"];\\n        assert_eq!(\\n            workflow.description,\\n            Some(\\\"Full development setup\\\".to_string())\\n        );\\n        assert_eq!(workflow.steps, vec![\\\"brew\\\", \\\"deps\\\", \\\"database\\\"]);\\n    }\\n\\n    #[test]\\n    fn parses_workflow_with_overrides() {\\n        let yaml = r#\\\"\\nworkflows:\\n  onboarding:\\n    steps: [deps, database, seeds]\\n    overrides:\\n      seeds:\\n        required: true\\n        skip_prompt: true\\n\\\"#;\\n        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n        let workflow = &config.workflows[\\\"onboarding\\\"];\\n        let override_ = &workflow.overrides[\\\"seeds\\\"];\\n        assert_eq!(override_.required, Some(true));\\n        assert!(override_.skip_prompt);\\n    }\\n\\n    #[test]\\n    fn parses_workflow_with_env() {\\n        let yaml = r#\\\"\\nworkflows:\\n  ci:\\n    steps: [deps, test]\\n    env:\\n      CI: \\\"true\\\"\\n      RAILS_ENV: test\\n    settings:\\n      non_interactive: true\\n\\\"#;\\n        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n        let workflow = &config.workflows[\\\"ci\\\"];\\n        assert_eq!(workflow.env.get(\\\"CI\\\"), Some(&\\\"true\\\".to_string()));\\n        assert!(workflow.settings.as_ref().unwrap().non_interactive);\\n    }\\n\\n    #[test]\\n    fn parses_multiple_workflows() {\\n        let yaml = r#\\\"\\nworkflows:\\n  default:\\n    steps: [deps, database]\\n  ci:\\n    steps: [deps, test]\\n  reset:\\n    description: \\\"Clean slate\\\"\\n    steps: [clean, deps, database, seeds]\\n\\\"#;\\n        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n        assert_eq!(config.workflows.len(), 3);\\n        assert!(config.workflows.contains_key(\\\"default\\\"));\\n        assert!(config.workflows.contains_key(\\\"ci\\\"));\\n        assert!(config.workflows.contains_key(\\\"reset\\\"));\\n    }\\n\\n    #[test]\\n    fn parses_file_exists_check() {\\n        let yaml = r#\\\"\\nsteps:\\n  deps:\\n    command: \\\"yarn install\\\"\\n    completed_check:\\n      type: file_exists\\n      path: \\\"node_modules\\\"\\n\\\"#;\\n        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n        let check = config.steps[\\\"deps\\\"].completed_check.as_ref().unwrap();\\n        assert!(matches!(\\n            check,\\n            CompletedCheck::FileExists { path } if path == \\\"node_modules\\\"\\n        ));\\n    }\\n\\n    #[test]\\n    fn parses_command_succeeds_check() {\\n        let yaml = r#\\\"\\nsteps:\\n  deps:\\n    command: \\\"bundle install\\\"\\n    completed_check:\\n      type: command_succeeds\\n      command: \\\"bundle check\\\"\\n\\\"#;\\n        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n        let check = config.steps[\\\"deps\\\"].completed_check.as_ref().unwrap();\\n        assert!(matches!(\\n            check,\\n            CompletedCheck::CommandSucceeds { command } if command == \\\"bundle check\\\"\\n        ));\\n    }\\n\\n    #[test]\\n    fn parses_all_check() {\\n        let yaml = r#\\\"\\nsteps:\\n  deps:\\n    command: \\\"yarn install\\\"\\n    completed_check:\\n      type: all\\n      checks:\\n        - type: file_exists\\n          path: \\\"node_modules\\\"\\n        - type: command_succeeds\\n          command: \\\"yarn check\\\"\\n\\\"#;\\n        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n        let check = config.steps[\\\"deps\\\"].completed_check.as_ref().unwrap();\\n        if let CompletedCheck::All { checks } = check {\\n            assert_eq!(checks.len(), 2);\\n        } else {\\n            panic!(\\\"Expected All check\\\");\\n        }\\n    }\\n\\n    #[test]\\n    fn parses_any_check() {\\n        let yaml = r#\\\"\\nsteps:\\n  env:\\n    command: \\\"cp .env.example .env\\\"\\n    completed_check:\\n      type: any\\n      checks:\\n        - type: file_exists\\n          path: \\\".env\\\"\\n        - type: file_exists\\n          path: \\\".env.local\\\"\\n\\\"#;\\n        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n        let check = config.steps[\\\"env\\\"].completed_check.as_ref().unwrap();\\n        assert!(matches!(check, CompletedCheck::Any { .. }));\\n    }\\n\\n    #[test]\\n    fn parses_marker_check() {\\n        let yaml = r#\\\"\\nsteps:\\n  setup:\\n    command: \\\"./setup.sh\\\"\\n    completed_check:\\n      type: marker\\n\\\"#;\\n        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n        let check = config.steps[\\\"setup\\\"].completed_check.as_ref().unwrap();\\n        assert!(matches!(check, CompletedCheck::Marker));\\n    }\\n\\n    #[test]\\n    fn serialize_omits_default_values() {\\n        let config: BivvyConfig = serde_yaml::from_str(\\n            r#\\\"\\napp_name: \\\"TestApp\\\"\\nsteps:\\n  hello:\\n    command: \\\"echo hello\\\"\\nworkflows:\\n  default:\\n    steps: [hello]\\n\\\"#,\\n        )\\n        .unwrap();\\n\\n        let yaml = serde_yaml::to_string(&config).unwrap();\\n\\n        // Should include explicitly set fields\\n        assert!(yaml.contains(\\\"app_name\\\"));\\n        assert!(yaml.contains(\\\"command\\\"));\\n\\n        // Should NOT include default/empty fields\\n        assert!(\\n            !yaml.contains(\\\"template_sources\\\"),\\n            \\\"empty template_sources should be omitted\\\"\\n        );\\n        assert!(!yaml.contains(\\\"secrets\\\"), \\\"empty secrets should be omitted\\\");\\n        assert!(\\n            !yaml.contains(\\\"requirements\\\"),\\n            \\\"empty requirements should be omitted\\\"\\n        );\\n        assert!(!yaml.contains(\\\"extends\\\"), \\\"None extends should be omitted\\\");\\n        assert!(\\n            !yaml.contains(\\\"log_path\\\"),\\n            \\\"None log_path should be omitted\\\"\\n        );\\n        assert!(!yaml.contains(\\\"logging\\\"), \\\"false logging should be omitted\\\");\\n        assert!(\\n            !yaml.contains(\\\"parallel\\\"),\\n            \\\"false parallel should be omitted\\\"\\n        );\\n        assert!(\\n            !yaml.contains(\\\"max_parallel\\\"),\\n            \\\"default max_parallel should be omitted\\\"\\n        );\\n        assert!(\\n            !yaml.contains(\\\"history_retention\\\"),\\n            \\\"default history_retention should be omitted\\\"\\n        );\\n        assert!(\\n            !yaml.contains(\\\"secret_env\\\"),\\n            \\\"empty secret_env should be omitted\\\"\\n        );\\n        assert!(\\n            !yaml.contains(\\\"depends_on\\\"),\\n            \\\"empty depends_on should be omitted\\\"\\n        );\\n        assert!(!yaml.contains(\\\"watches\\\"), \\\"empty watches should be omitted\\\");\\n        assert!(\\n            !yaml.contains(\\\"skippable\\\"),\\n            \\\"default true skippable should be omitted\\\"\\n        );\\n        assert!(\\n            !yaml.contains(\\\"prompt_if_complete\\\"),\\n            \\\"default true prompt_if_complete should be omitted\\\"\\n        );\\n        assert!(\\n            !yaml.contains(\\\"required\\\"),\\n            \\\"false required should be omitted\\\"\\n        );\\n        assert!(\\n            !yaml.contains(\\\"allow_failure\\\"),\\n            \\\"false allow_failure should be omitted\\\"\\n        );\\n        assert!(!yaml.contains(\\\"retry\\\"), \\\"zero retry should be omitted\\\");\\n        assert!(\\n            !yaml.contains(\\\"sensitive\\\"),\\n            \\\"false sensitive should be omitted\\\"\\n        );\\n        assert!(\\n            !yaml.contains(\\\"requires_sudo\\\"),\\n            \\\"false requires_sudo should be omitted\\\"\\n        );\\n        assert!(!yaml.contains(\\\"before\\\"), \\\"empty before should be omitted\\\");\\n        assert!(!yaml.contains(\\\"after\\\"), \\\"empty after should be omitted\\\");\\n        assert!(!yaml.contains(\\\"prompts\\\"), \\\"empty prompts should be omitted\\\");\\n        assert!(\\n            !yaml.contains(\\\"requires\\\"),\\n            \\\"empty requires should be omitted\\\"\\n        );\\n        assert!(\\n            !yaml.contains(\\\"environments\\\"),\\n            \\\"empty environments should be omitted\\\"\\n        );\\n        assert!(\\n            !yaml.contains(\\\"only_environments\\\"),\\n            \\\"empty only_environments should be omitted\\\"\\n        );\\n        assert!(\\n            !yaml.contains(\\\"default_environment\\\"),\\n            \\\"None default_environment should be omitted\\\"\\n        );\\n        assert!(\\n            !yaml.contains(\\\"overrides\\\"),\\n            \\\"empty overrides should be omitted\\\"\\n        );\\n    }\\n\\n    #[test]\\n    fn serialize_includes_non_default_values() {\\n        let config: BivvyConfig = serde_yaml::from_str(\\n            r#\\\"\\nsteps:\\n  test:\\n    command: \\\"echo test\\\"\\n    required: true\\n    skippable: false\\n    retry: 3\\n    allow_failure: true\\n    sensitive: true\\n    watches: [Gemfile]\\n    depends_on: [other]\\n    before: [\\\"echo pre\\\"]\\n    after: [\\\"echo post\\\"]\\nsettings:\\n  logging: true\\n  parallel: true\\n  max_parallel: 8\\n\\\"#,\\n        )\\n        .unwrap();\\n\\n        let yaml = serde_yaml::to_string(&config).unwrap();\\n\\n        assert!(\\n            yaml.contains(\\\"required\\\"),\\n            \\\"non-default required should be present\\\"\\n        );\\n        assert!(\\n            yaml.contains(\\\"skippable\\\"),\\n            \\\"non-default skippable should be present\\\"\\n        );\\n        assert!(yaml.contains(\\\"retry\\\"), \\\"non-zero retry should be present\\\");\\n        assert!(\\n            yaml.contains(\\\"allow_failure\\\"),\\n            \\\"true allow_failure should be present\\\"\\n        );\\n        assert!(\\n            yaml.contains(\\\"sensitive\\\"),\\n            \\\"true sensitive should be present\\\"\\n        );\\n        assert!(\\n            yaml.contains(\\\"watches\\\"),\\n            \\\"non-empty watches should be present\\\"\\n        );\\n        assert!(\\n            yaml.contains(\\\"depends_on\\\"),\\n            \\\"non-empty depends_on should be present\\\"\\n        );\\n        assert!(\\n            yaml.contains(\\\"before\\\"),\\n            \\\"non-empty before should be present\\\"\\n        );\\n        assert!(yaml.contains(\\\"after\\\"), \\\"non-empty after should be present\\\");\\n        assert!(yaml.contains(\\\"logging\\\"), \\\"true logging should be present\\\");\\n        assert!(yaml.contains(\\\"parallel\\\"), \\\"true parallel should be present\\\");\\n        assert!(\\n            yaml.contains(\\\"max_parallel\\\"),\\n            \\\"non-default max_parallel should be present\\\"\\n        );\\n    }\\n\\n    #[test]\\n    fn step_config_requires_defaults_empty() {\\n        let yaml = r#\\\"\\n            command: \\\"echo hello\\\"\\n        \\\"#;\\n        let config: StepConfig = serde_yaml::from_str(yaml).unwrap();\\n        assert!(config.requires.is_empty());\\n    }\\n\\n    #[test]\\n    fn step_config_requires_parses() {\\n        let yaml = r#\\\"\\n            command: \\\"bundle install\\\"\\n            requires:\\n              - ruby\\n              - postgres-server\\n        \\\"#;\\n        let config: StepConfig = serde_yaml::from_str(yaml).unwrap();\\n        assert_eq!(config.requires, vec![\\\"ruby\\\", \\\"postgres-server\\\"]);\\n    }\\n\\n    #[test]\\n    fn custom_requirement_parses() {\\n        let yaml = r#\\\"\\nrequirements:\\n  internal-cli:\\n    check:\\n      type: command_succeeds\\n      command: \\\"internal-cli --version\\\"\\n    install_hint: \\\"Download from https://internal.company.com/cli\\\"\\n\\\"#;\\n        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n        assert!(config.requirements.contains_key(\\\"internal-cli\\\"));\\n        let req = &config.requirements[\\\"internal-cli\\\"];\\n        assert!(matches!(\\n            &req.check,\\n            CustomRequirementCheck::CommandSucceeds { command } if command == \\\"internal-cli --version\\\"\\n        ));\\n        assert_eq!(\\n            req.install_hint,\\n            Some(\\\"Download from https://internal.company.com/cli\\\".to_string())\\n        );\\n        assert!(req.install_template.is_none());\\n    }\\n\\n    #[test]\\n    fn custom_requirement_service_check_parses() {\\n        let yaml = r#\\\"\\nrequirements:\\n  minio:\\n    check:\\n      type: service_reachable\\n      command: \\\"curl -sf http://localhost:9000/minio/health/live\\\"\\n    install_hint: \\\"Run: docker compose up -d minio\\\"\\n\\\"#;\\n        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n        let req = &config.requirements[\\\"minio\\\"];\\n        assert!(matches!(\\n            &req.check,\\n            CustomRequirementCheck::ServiceReachable { command } if command.contains(\\\"curl\\\")\\n        ));\\n    }\\n\\n    #[test]\\n    fn custom_requirement_with_install_template() {\\n        let yaml = r#\\\"\\nrequirements:\\n  libvips:\\n    check:\\n      type: command_succeeds\\n      command: \\\"vips --version\\\"\\n    install_template: libvips\\n\\\"#;\\n        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n        let req = &config.requirements[\\\"libvips\\\"];\\n        assert_eq!(req.install_template, Some(\\\"libvips\\\".to_string()));\\n    }\\n\\n    #[test]\\n    fn custom_requirement_file_exists_check() {\\n        let yaml = r#\\\"\\nrequirements:\\n  local-config:\\n    check:\\n      type: file_exists\\n      path: \\\"/etc/myapp/config.yml\\\"\\n\\\"#;\\n        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n        let req = &config.requirements[\\\"local-config\\\"];\\n        assert!(matches!(\\n            &req.check,\\n            CustomRequirementCheck::FileExists { path } if path == \\\"/etc/myapp/config.yml\\\"\\n        ));\\n    }\\n\\n    #[test]\\n    fn empty_requirements_defaults() {\\n        let yaml = r#\\\"\\napp_name: \\\"TestApp\\\"\\n\\\"#;\\n        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n        assert!(config.requirements.is_empty());\\n    }\\n\\n    #[test]\\n    fn settings_default_environment_defaults_none() {\\n        let config: BivvyConfig = serde_yaml::from_str(\\\"\\\").unwrap();\\n        assert!(config.settings.default_environment.is_none());\\n        assert!(config.settings.environments.is_empty());\\n    }\\n\\n    #[test]\\n    fn parses_default_environment() {\\n        let yaml = r#\\\"\\nsettings:\\n  default_environment: staging\\n\\\"#;\\n        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n        assert_eq!(\\n            config.settings.default_environment,\\n            Some(\\\"staging\\\".to_string())\\n        );\\n    }\\n\\n    #[test]\\n    fn parses_environment_config() {\\n        let yaml = r#\\\"\\nsettings:\\n  environments:\\n    ci:\\n      detect:\\n        - env: CI\\n        - env: GITHUB_ACTIONS\\n      default_workflow: ci\\n      provided_requirements:\\n        - docker\\n        - node\\n    staging:\\n      detect:\\n        - env: DEPLOY_ENV\\n          value: staging\\n\\\"#;\\n        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n        assert_eq!(config.settings.environments.len(), 2);\\n\\n        let ci = &config.settings.environments[\\\"ci\\\"];\\n        assert_eq!(ci.detect.len(), 2);\\n        assert_eq!(ci.detect[0].env, \\\"CI\\\");\\n        assert!(ci.detect[0].value.is_none());\\n        assert_eq!(ci.default_workflow, Some(\\\"ci\\\".to_string()));\\n        assert_eq!(ci.provided_requirements, vec![\\\"docker\\\", \\\"node\\\"]);\\n\\n        let staging = &config.settings.environments[\\\"staging\\\"];\\n        assert_eq!(staging.detect.len(), 1);\\n        assert_eq!(staging.detect[0].env, \\\"DEPLOY_ENV\\\");\\n        assert_eq!(staging.detect[0].value, Some(\\\"staging\\\".to_string()));\\n        assert!(staging.default_workflow.is_none());\\n        assert!(staging.provided_requirements.is_empty());\\n    }\\n\\n    #[test]\\n    fn parses_step_environments_override() {\\n        let yaml = r#\\\"\\nsteps:\\n  database:\\n    command: \\\"rails db:setup\\\"\\n    environments:\\n      ci:\\n        command: \\\"rails db:schema:load\\\"\\n        env:\\n          RAILS_ENV: test\\n\\\"#;\\n        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n        let step = &config.steps[\\\"database\\\"];\\n        assert_eq!(step.environments.len(), 1);\\n\\n        let ci_override = &step.environments[\\\"ci\\\"];\\n        assert_eq!(\\n            ci_override.command,\\n            Some(\\\"rails db:schema:load\\\".to_string())\\n        );\\n        assert_eq!(\\n            ci_override.env.get(\\\"RAILS_ENV\\\"),\\n            Some(&Some(\\\"test\\\".to_string()))\\n        );\\n    }\\n\\n    #[test]\\n    fn parses_step_only_environments() {\\n        let yaml = r#\\\"\\nsteps:\\n  seeds:\\n    command: \\\"rails db:seed\\\"\\n    only_environments:\\n      - development\\n      - staging\\n\\\"#;\\n        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n        let step = &config.steps[\\\"seeds\\\"];\\n        assert_eq!(step.only_environments, vec![\\\"development\\\", \\\"staging\\\"]);\\n    }\\n\\n    #[test]\\n    fn step_only_environments_defaults_empty() {\\n        let yaml = r#\\\"\\n            command: \\\"echo hello\\\"\\n        \\\"#;\\n        let config: StepConfig = serde_yaml::from_str(yaml).unwrap();\\n        // Empty means \\\"run in all environments\\\"\\n        assert!(config.only_environments.is_empty());\\n    }\\n\\n    #[test]\\n    fn step_environments_defaults_empty() {\\n        let yaml = r#\\\"\\n            command: \\\"echo hello\\\"\\n        \\\"#;\\n        let config: StepConfig = serde_yaml::from_str(yaml).unwrap();\\n        assert!(config.environments.is_empty());\\n    }\\n\\n    #[test]\\n    fn environment_config_defaults() {\\n        let config: EnvironmentConfig = serde_yaml::from_str(\\\"\\\").unwrap();\\n        assert!(config.detect.is_empty());\\n        assert!(config.default_workflow.is_none());\\n        assert!(config.provided_requirements.is_empty());\\n    }\\n\\n    #[test]\\n    fn parses_nested_composite_checks() {\\n        let yaml = r#\\\"\\nsteps:\\n  complex:\\n    command: \\\"echo complex\\\"\\n    completed_check:\\n      type: all\\n      checks:\\n        - type: file_exists\\n          path: \\\"required.txt\\\"\\n        - type: any\\n          checks:\\n            - type: file_exists\\n              path: \\\"option_a.txt\\\"\\n            - type: file_exists\\n              path: \\\"option_b.txt\\\"\\n\\\"#;\\n        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n        let check = config.steps[\\\"complex\\\"].completed_check.as_ref().unwrap();\\n        if let CompletedCheck::All { checks } = check {\\n            assert_eq!(checks.len(), 2);\\n            assert!(matches!(&checks[1], CompletedCheck::Any { .. }));\\n        } else {\\n            panic!(\\\"Expected All check\\\");\\n        }\\n    }\\n\\n    // --- 7A: Schema override parsing tests ---\\n\\n    #[test]\\n    fn environment_override_depends_on_parses() {\\n        let yaml = r#\\\"\\n            depends_on: [a, b]\\n        \\\"#;\\n        let o: StepEnvironmentOverride = serde_yaml::from_str(yaml).unwrap();\\n        assert_eq!(o.depends_on, Some(vec![\\\"a\\\".to_string(), \\\"b\\\".to_string()]));\\n    }\\n\\n    #[test]\\n    fn environment_override_watches_parses() {\\n        let yaml = r#\\\"\\n            watches: []\\n        \\\"#;\\n        let o: StepEnvironmentOverride = serde_yaml::from_str(yaml).unwrap();\\n        assert_eq!(o.watches, Some(vec![]));\\n    }\\n\\n    #[test]\\n    fn environment_override_title_parses() {\\n        let yaml = r#\\\"\\n            title: \\\"CI Title\\\"\\n        \\\"#;\\n        let o: StepEnvironmentOverride = serde_yaml::from_str(yaml).unwrap();\\n        assert_eq!(o.title, Some(\\\"CI Title\\\".to_string()));\\n    }\\n\\n    // --- Vars parsing tests ---\\n\\n    #[test]\\n    fn parses_static_var() {\\n        let yaml = r#\\\"\\nvars:\\n  name: \\\"bivvy\\\"\\n\\\"#;\\n        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n        assert!(matches!(\\n            config.vars.get(\\\"name\\\"),\\n            Some(VarDefinition::Static(v)) if v == \\\"bivvy\\\"\\n        ));\\n    }\\n\\n    #[test]\\n    fn parses_computed_var() {\\n        let yaml = r#\\\"\\nvars:\\n  v:\\n    command: \\\"echo 1\\\"\\n\\\"#;\\n        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n        assert!(matches!(\\n            config.vars.get(\\\"v\\\"),\\n            Some(VarDefinition::Computed { command }) if command == \\\"echo 1\\\"\\n        ));\\n    }\\n\\n    #[test]\\n    fn parses_mixed_vars() {\\n        let yaml = r#\\\"\\nvars:\\n  app_name: \\\"bivvy\\\"\\n  version:\\n    command: \\\"echo 1.0.0\\\"\\n\\\"#;\\n        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n   