nd: \\\"test $(git branch --show-current) = main\\\"\\n        - type: command_succeeds\\n          command: \\\"git diff --quiet\\\"\\n\\\"#;\\n        let config: BivvyConfig = serde_yaml::from_str(yaml).unwrap();\\n        let step = &config.steps[\\\"release\\\"];\\n        if let Some(CompletedCheck::All { checks }) = &step.precondition {\\n            assert_eq!(checks.len(), 2);\\n        } else {\\n            panic!(\\\"Expected All precondition\\\");\\n        }\\n    }\\n\\n    #[test]\\n    fn precondition_defaults_none() {\\n        let yaml = r#\\\"\\n            command: \\\"echo hello\\\"\\n        \\\"#;\\n        let config: StepConfig = serde_yaml::from_str(yaml).unwrap();\\n        assert!(config.precondition.is_none());\\n    }\\n\\n    #[test]\\n    fn serialize_omits_none_precondition() {\\n        let config: BivvyConfig = serde_yaml::from_str(\\n            r#\\\"\\nsteps:\\n  hello:\\n    command: \\\"echo hello\\\"\\n\\\"#,\\n        )\\n        .unwrap();\\n        let yaml = serde_yaml::to_string(&config).unwrap();\\n        assert!(\\n            !yaml.contains(\\\"precondition\\\"),\\n            \\\"None precondition should be omitted\\\"\\n        );\\n    }\\n\\n    #[test]\\n    fn rejects_unknown_top_level_field() {\\n        let yaml = r#\\\"\\napp_name: \\\"MyApp\\\"\\nbogus_field: true\\n\\\"#;\\n        let result: Result<BivvyConfig, _> = serde_yaml::from_str(yaml);\\n        assert!(result.is_err(), \\\"Unknown top-level field should be rejected\\\");\\n    }\\n\\n    #[test]\\n    fn rejects_unknown_settings_field() {\\n        let yaml = r#\\\"\\nsettings:\\n  default_output: quiet\\n  unknown_option: 42\\n\\\"#;\\n        let result: Result<BivvyConfig, _> = serde_yaml::from_str(yaml);\\n        assert!(result.is_err(), \\\"Unknown settings field should be rejected\\\");\\n    }\\n\\n    #[test]\\n    fn rejects_unknown_step_field() {\\n        let yaml = r#\\\"\\nsteps:\\n  test:\\n    command: \\\"echo test\\\"\\n    un