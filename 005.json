192        &self.args\\n    37\u2192    }\\n    38\u2192}\\n    39\u2192\\n    40\u2192impl Command for ConfigCommand {\\n    41\u2192    fn execute(&self, ui: &mut dyn UserInterface) -> Result<CommandResult> {\\n    42\u2192        // Load configuration\\n    43\u2192        let config = match load_merged_config(&self.project_root) {\\n    44\u2192            Ok(c) => c,\\n    45\u2192            Err(BivvyError::ConfigNotFound { .. }) => {\\n    46\u2192                ui.error(\\\"No configuration found. Run 'bivvy init' first.\\\");\\n    47\u2192                return Ok(CommandResult::failure(2));\\n    48\u2192            }\\n    49\u2192            Err(e) => return Err(e),\\n    50\u2192        };\\n    51\u2192\\n    52\u2192        // Apply config default_output when no CLI flag was explicitly set\\n    53\u2192        if ui.output_mode() == OutputMode::Normal {\\n    54\u2192            ui.set_output_mode(config.settings.default_output.into());\\n    55\u2192        }\\n    56\u2192\\n    57\u2192        // Show config file path(s)\\n    58\u2192        let paths = ConfigPaths::discover(&self.project_root);\\n    59\u2192        let existing: Vec<_> = paths.all_existing();\\n    60\u2192        if !existing.is_empty() {\\n    61\u2192            for path in &existing {\\n    62\u2192                ui.message(&format!(\\\"# {}\\\", path.display()));\\n    63\u2192            }\\n    64\u2192            ui.message(\\\"\\\");\\n    65\u2192        }\\n    66\u2192\\n    67\u2192        // Output format\\n    68\u2192        if self.args.json {\\n    69\u2192            let json =\\n    70\u2192                serde_json::to_string_pretty(&config).map_err(|e| BivvyError::Other(e.into()))?;\\n    71\u2192            ui.message(&json);\\n    72\u2192        } else {\\n    73\u2192            let yaml = serde_yaml::to_string(&config).map_err(|e| BivvyError::Other(e.into()))?;\\n    74\u2192            ui.message(&yaml);\\n    75\u2192        }\\n    76\u2192\\n 