  4\u2192//! the application, and a [`Result`] type alias for convenience.\\n     5\u2192//!\\n     6\u2192//! # Error Handling Strategy\\n     7\u2192//!\\n     8\u2192//! - Use `BivvyError` for domain-specific errors that need distinct handling\\n     9\u2192//! - Use `anyhow::Error` (via `BivvyError::Other`) for unexpected errors\\n    10\u2192//! - All errors should provide actionable messages for users\\n    11\u2192\\n    12\u2192use std::path::PathBuf;\\n    13\u2192use thiserror::Error;\\n    14\u2192\\n    15\u2192/// Core error type for Bivvy operations.\\n    16\u2192#[derive(Debug, Error)]\\n    17\u2192pub enum BivvyError {\\n    18\u2192    /// Configuration file not found at expected location.\\n    19\u2192    #[error(\\\"Configuration not found: {path}\\\")]\\n    20\u2192    ConfigNotFound { path: PathBuf },\\n    21\u2192\\n    22\u2192    /// Failed to parse configuration file.\\n    23\u2192    #[error(\\\"Failed to parse config at {path}: {message}\\\")]\\n    24\u2192    ConfigParseError { path: PathBuf, message: String },\\n    25\u2192\\n    26\u2192    /// Invalid configuration structure or values.\\n    27\u2192    #[error(\\\"Invalid configuration: {message}\\\")]\\n    28\u2192    ConfigValidationError { message: String },\\n    29\u2192\\n    30\u2192    /// Referenced template does not exist.\\n    31\u2192    #[error(\\\"Unknown template: {name}\\\")]\\n    32\u2192    UnknownTemplate { name: String },\\n    33\u2192\\n    34\u2192    /// Step dependency cycle detected.\\n    35\u2192    #[error(\\\"Circular dependency detected: {cycle}\\\")]\\n    36\u2192    CircularDependency { cycle: String },\\n    37\u2192\\n    38\u2192    /// Step execution failed.\\n    39\u2192    #[error(\\\"Step '{step}' failed: {message}\\\")]\\n    40\u2192    StepExecutionError { step: String, message: String },\\n    41\u2192\\n    42\u2192    /// Shell command failed.\\n    43\u2192    #[error(\\\"Command failed with exit code {code:?}: {command}\\\")]\\n    44\u2192    CommandFailed { command: String, code: Option<i32> },\\n    45\u2192\\n    46\u2192    /// A required tool or service is missing and cannot be auto-installed.\\n    47\u2192    #[error(\\\"Missing requirement '{requirement}': {message}\\\")]\\n    48\u2192    RequirementMissing {\\n    49\u2192        requirement: String,\\n    50\u2192        message: String,\\n    51\u2192    },\\n    52\u2192\\n    53\u2192    /// A requirement check failed unexpectedly (e.g., network error during install).\\n    54\u2192    #[error(\\\"Requirement check failed for '{requirement}': {message}\\\")]\\n    55\u2192    RequirementCheckFailed {\\n    56\u2192        requirement: String,\\n    57\u2192        message: String,\\n    58\u2192    },\\n    59\u2192\\n    60\u2192    /// Shell operation failed (e.g., spawning a debug shell).\\n    61\u2192    #[error(\\\"Shell error: {message}\\\")]\\n    62\u2192    ShellError { message: String },\\n    63\u2192\\n    64\u2192    /// IO error wrapper.\\n    65\u2192    #[error(\\\"IO error: {0}\\\")]\\n    66\u2192    Io(#[from] std::io::Error),\\n    67\u2192\\n    68\u2192    /// Generic wrapped error for anyhow interop.\\n    69\u2192    #[error(transparent)]\\n    70\u2192    Other(#[from] anyhow::Error),\\n    71\u2192}\\n    72\u2192\\n    73\u2192/// Result type alias for Bivvy operations.\\n    74\u2192pub type Result<T> = std::result::Result<T, BivvyError>;\\n    75\u2192\\n    76\u2192#[cfg(test)]\\n    77\u2192mod tests {\\n    78\u2192    use super::*;\\n    79\u2192\\n    80\u2192    #[test]\\n    81\u2192    fn config_not_found_displays_path() {\\n    82\u2192        let err = BivvyError::ConfigNotFound {\\n    83\u2192            path: PathBuf::from(\\\"/foo/bar.yml\\\"),\\n    84\u2192        };\\n    85\u2192        assert!(err.to_string().contains(\\\"/foo/bar.yml\\\"));\\n    86\u2192    }\\n    87\u2192\\n    88\u2192    #[test]\\n    89\u2192    fn config_parse_error_displays_path_and_message() {\\n    90\u2192        let err = BivvyError::ConfigParseError {\\n    91\u2192            path: PathBuf::from(\\\"/config.yml\\\"),\\n    92\u2192            message: \\\"invalid syntax\\\".into(),\\n    93\u2192        };\\n    94\u2192        let msg = err.to_string();\\n    95\u2192        assert!(msg.contains(\\\"/config.yml\\\"));\\n    96\u2192        assert!(msg.contains(\\\"invalid syntax\\\"));\\n    97\u2192    }\\n    98\u2192\\n    99\u2192    #[test]\\n   100\u2192    fn config_validation_error_displays_message() {\\n   101\u2192        let err = BivvyError::ConfigValidationError {\\n   102\u2192            message: \\\"missing required field\\\".into(),\\n   103\u2192        };\\n   104\u2192        assert!(err.to_string().contains(\\\"missing required field\\\"));\\n   105\u2192    }\\n   106\u2192\\n   107\u2192    #[test]\\n   108\u2192    fn unknown_template_displays_name() {\\n   109\u2192        let err = BivvyError::UnknownTemplate {\\n   110\u2192            name: \\\"nonexistent\\\".into(),\\n   111\u2192        };\\n   112\u2192        assert!(err.to_string().contains(\\\"nonexistent\\\"));\\n   113\u2192    }\\n   114\u2192\\n   115\u2192    #[test]\\n   116\u2192    fn circular_dependency_displays_cycle() {\\n   117\u2192        let err = BivvyError::CircularDependency {\\n   118\u2192            cycle: \\\"a \u2192 b \u2192 a\\\".into(),\\n   119\u2192        };\\n   120\u2192        assert!(err.to_string().contains(\\\"a \u2192 b \u2192 a\\\"));\\n   121\u2192    }\\n   122\u2192\\n   123\u2192    #[test]\\n   124\u2192    fn step_execution_error_displays_step_and_message() {\\n   125\u2192        let err = BivvyError::StepExecutionError {\\n   126\u2192            step: \\\"install_deps\\\".into(),\\n   127\u2192            message: \\\"npm not found\\\".into(),\\n   128\u2192        };\\n   129\u2192        let msg = err.to_string();\\n   130\u2192        assert!(msg.contains(\\\"install_deps\\\"));\\n   131\u2192        assert!(msg.contains(\\\"npm not found\\\"));\\n   132\u2192    }\\n   133\u2192\\n   134\u2192    #[test]\\n   135\u2192    fn command_failed_displays_command_and_code() {\\n   136\u2192        let err = BivvyError::CommandFailed {\\n   137\u2192            command: \\\"npm install\\\".into(),\\n   138\u2192            code: Some(1),\\n   139\u2192        };\\n   140\u2192        let msg = err.to_string();\\n   141\u2192        assert!(msg.contains(\\\"npm install\\\"));\\n   142\u2192        assert!(msg.contains(\\\"1\\\"));\\n   143\u2192    }\\n   144\u2192\\n   145\u2192    #[test]\\n   146\u2192    fn requirement_missing_displays_requirement_and_message() {\\n   147\u2192        let err = BivvyError::RequirementMissing {\\n   148\u2192            requirement: \\\"ruby\\\".into(),\\n   149\u2192            message: \\\"Not found on PATH\\\".into(),\\n   150\u2192        };\\n   151\u2192        let msg = err.to_string();\\n   152\u2192        assert!(msg.contains(\\\"ruby\\\"));\\n   153\u2192        assert!(msg.contains(\\\"Not found on PATH\\\"));\\n   154\u2192    }\\n   155\u2192\\n   156\u2192    #[test]\\n   157\u2192    fn requirement_check_failed_displays_requirement_and_message() {\\n   158\u2192        let err = BivvyError::RequirementCheckFailed {\\n   159\u2192            requirement: \\\"node\\\".into(),\\n   160\u2192            message: \\\"Install command exited with code 1\\\".into(),\\n   161\u2192        };\\n   162\u2192        let msg = err.to_string();\\n   163\u2192        assert!(msg.contains(\\\"node\\\"));\\n   164\u2192        assert!(msg.contains(\\\"Install command exited with code 1\\\"));\\n   165\u2192    }\\n   166\u2192\\n   167\u2192    #[test]\\n   168\u2192    fn io_error_converts_from_std() {\\n   169\u2192        let io_err = std::io::Error::new(std::io::ErrorKind::NotFound, \\\"file missing\\\");\\n   170\u2192        let err: BivvyError = io_err.into();\\n   171\u2192        assert!(matches!(err, BivvyError::Io(_)));\\n   172\u2192    }\\n   173\u2192\\n   174\u2192    #[test]\\n   175\u2192    fn result_type_alias_works() {\\n   176\u2192        fn returns_error() -> Result<()> {\\n   177\u2192            Err(BivvyError::ConfigValidationError {\\n   178\u2192                message: \\\"test\\\".into(),\\n   179\u2192            })\\n   180\u2192        }\\n   181\u2192        assert!(returns_error().is_err());\\n   182\u2192    }\\n   183\u2192}\\n   184\u2192\"}]},\"parent_tool_use_id\":null,\"session_id\":\"71626d50-8e30-42b0-86de-6cafbf80e23f\",\"uuid\":\"e1fd7097-7b52-4141-a7d5-1155f0ebd521\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/private/var/folders/_q/qzh8_t6s15388qqf3p6n3d200000gp/T/bench-7okzbcvu/src/error.rs\",\"content\":\"//! Error types for Bivvy operations.\\n//!\\n//! This module defines [`BivvyError`], the primary error type used throughout\\n//! the application, and a [`Result`] type alias for convenience.\\n//!\\n//! # Error Handling Strategy\\n//!\\n//! - Use `BivvyError` for domain-specific errors that need distinct handling\\n//! - Use `anyhow::Error` (via `BivvyError::Other`) for unexpected errors\\n//! - All errors should provide actionable messages for users\\n\\nuse std::path::PathBuf;\\nuse thiserror::Error;\\n\\n/// Core error type for Bivvy operations.\\n#[derive(Debug, Error)]\\npub enum BivvyError {\\n    /// Configuration file not found at expected location.\\n    #[error(\\\"Configuration not found: {path}\\\")]\\n    ConfigNotFound { path: PathBuf },\\n\\n    /// Failed to parse configuration file.\\n    #[error(\\\"Failed to parse config at {path}: {message}\\\")]\\n    ConfigParseError { path: PathBuf, message: String },\\n\\n    /// Invalid configuration structure or values.\\n    #[error(\\\"Invalid configuration: {message}\\\")]\\n    ConfigValidationError { message: String },\\n\\n    /// Referenced template does not exist.\\n    #[error(\\\"Unknown template: {name}\\\")]\\n    UnknownTemplate { name: String },\\n\\n    /// Step dependency cycle detected.\\n    #[error(\\\"Circular dependency detected: {cycle}\\\")]\\n    CircularDependency { cycle: String },\\n\\n    /// Step execution failed.\\n    #[error(\\\"Step '{step}' failed: {message}\\\")]\\n    StepExecutionError { step: String, message: String },\\n\\n    /// Shell command failed.\\n    #[error(\\\"Command failed with exit code {code:?}: {command}\\\")]\\n    CommandFailed { command: String, code: Option<i32> },\\n\\n    /// A required tool or service is missing and cannot be auto-installed.\\n    #[error(\\\"Missing requirement '{requirement}': {message}\\\")]\\n    RequirementMissing {\\n        requirement: String,\\n        message: String,\\n    },\\n\\n    /// A requirement check failed unexpectedly (e.g., network error during install).\\n    #[error(\\\"Requirement check failed for '{requirement}': {message}\\\")]\\n    RequirementCheckFailed {\\n        requirement: String,\\n        message: String,\\n    },\\n\\n    /// Shell operation failed (e.g., spawning a debug shell).\\n    #[error(\\\"Shell error: {message}\\\")]\\n    ShellError { message: String },\\n\\n    /// IO error wrapper.\\n    #[error(\\\"IO error: {0}\\\")]\\n    Io(#[from] std::io::Error),\\n\\n    /// Generic wrapped error for anyhow interop.\\n    #[error(transparent)]\\n    Other(#[from] anyhow::Error),\\n}\\n\\n/// Result type alias for Bivvy operations.\\npub type Result<T> = std::result::Result<T, BivvyError>;\\n\\n#[cfg(test)]\\nmod tests {\\n    use super::*;\\n\\n    #[test]\\n    fn config_not_found_displays_path() {\\n        let err = BivvyError::ConfigNotFound {\\n            path: PathBuf::from(\\\"/foo/bar.yml\\\"),\\n        };\\n        assert!(err.to_string().contains(\\\"/foo/bar.yml\\\"));\\n    }\\n\\n    #[test]\\n    fn config_parse_error_displays_path_and_message() {\\n        let err = BivvyError::ConfigParseError {\\n            path: PathBuf::from(\\\"/config.yml\\\"),\\n            message: \\\"invalid syntax\\\".into(),\\n        };\\n        let msg = err.to_string();\\n        assert!(msg.contains(\\\"/config.yml\\\"));\\n        assert!(msg.contains(\\\"invalid syntax\\\"));\\n    }\\n\\n    #[test]\\n    fn config_validation_error_displays_message() {\\n        let err = BivvyError::ConfigValidationError {\\n            message: \\\"missing required field\\\".into(),\\n        };\\n        assert!(err.to_string().contains(\\\"missing required field\\\"));\\n    }\\n\\n    #[test]\\n    fn unknown_template_displays_name() {\\n        let err = BivvyError::UnknownTemplate {\\n            name: \\\"nonexistent\\\".into(),\\n        };\\n        assert!(err.to_string().contains(\\\"nonexistent\\\"));\\n    }\\n\\n    #[test]\\n    fn circular_dependency_displays_cycle() {\\n        let err = BivvyError::CircularDependency {\\n            cycle: \\\"a \u2192 b \u2192 a\\\".into(),\\n        };\\n        assert!(err.to_string().contains(\\\"a \u2192 b \u2192 a\\\"));\\n    }\\n\\n    #[test]\\n    fn step_execution_error_displays_step_and_message() {\\n        let err = BivvyError::StepExecutionError {\\n            step: \\\"install_deps\\\".into(),\\n            message: \\\"npm not found\\\".into(),\\n        };\\n        let msg = err.to_string();\\n        assert!(msg.contains(\\\"install_deps\\\"));\\n        assert!(msg.contains(\\\"npm not found\\\"));\\n    }\\n\\n    #[test]\\n    fn command_failed_displays_command_and_code() {\\n        let err = BivvyError::CommandFailed {\\n            command: \\\"npm install\\\".into(),\\n            code: Some(1),\\n        };\\n        let msg = err.to_string();\\n        assert!(msg.contains(\\\"npm install\\\"));\\n        assert!(msg.contains(\\\"1\\\"));\\n    }\\n\\n    #[test]\\n    fn requirement_missing_displays_requirement_and_message() {\\n        let err = BivvyError::RequirementMissing {\\n            requirement: \\\"ruby\\\".into(),\\n            message: \\\"Not found on PATH\\\".into(),\\n        };\\n        let msg = err.to_string();\\n        assert!(msg.contains(\\\"ruby\\\"));\\n        assert!(msg.contains(\\\"Not found on PATH\\\"));\\n    }\\n\\n    #[test]\\n    fn requirement_check_failed_displays_requirement_and_message() {\\n        let err = BivvyError::RequirementCheckFailed {\\n            requirement: \\\"node\\\".into(),\\n            message: \\\"Install command exited with code 1\\\".into(),\\n        };\\n        let msg = err.to_string();\\n        assert!(msg.contains(\\\"node\\\"));\\n        assert!(msg.contains(\\\"Install command exited with code 1\\\"));\\n    }\\n\\n    #[test]\\n    fn io_error_converts_from_std() {\\n        let io_err = std::io::Error::new(std::io::ErrorKind::NotFound, \\\"file missing\\\");\\n        let err: BivvyError = io_err.into();\\n        assert!(matches!(err, BivvyError::Io(_)));\\n    }\\n\\n    #[test]\\n    fn result_type_alias_works() {\\n        fn returns_error() -> Result<()> {\\n            Err(BivvyError::ConfigValidationError {\\n                message: \\\"test\\\".into(),\\n            })\\n        }\\n        assert!(returns_error().is_err());\\n    }\\n}\\n\",\"numLines\":184,\"startLine\":1,\"totalLines\":184}}}\n{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01EkCjFZVjjzHqeV3EXbbBvf\",\"type\":\"tool_result\",\"content\":\"     1\u2192//! Configuration file discovery and loading.\\n     2\u2192//!\\n     3\u2192//! This module handles finding and loading configuration files from\\n     4\u2192//! various locations in the correct priority order.\\n     5\u2192\\n     6\u2192use crate::config::extends::ExtendsResolver;\\n     7\u2192use crate::config::merger::merge_configs;\\n     8\u2192use crate::config::schema::BivvyConfig;\\n     9\u2192use crate::error::{BivvyError, Result};\\n    10\u2192use std::fs;\\n    11\u2192use std::path::{Path, PathBuf};\\n    12\u2192\\n    13\u2192/// Paths to configuration files in priority order (later overrides earlier).\\n    14\u2192///\\n    15\u2192/// Merge order:\\n    16\u2192/// 1. Remote base configs (from `extends:`)\\n    17\u2192/// 2. User global config (`~/.bivvy/config.yml`)\\n    18\u2192/// 3. Project config (`.bivvy/config.yml`)\\n    19\u2192/// 4. Local overrides (`.bivvy/config.local.yml`)\\n    20\u2192#[derive(Debug, Clone)]\\n    21\u2192pub struct ConfigPaths {\\n    22\u2192    /// Remote base config (if extends: is used)\\n    23\u2192    pub extends: Vec<PathBuf>,\\n    24\u2192\\n    25\u2192    /// User's global config: ~/.bivvy/config.yml\\n    26\u2192    pub user_global: Option<PathBuf>,\\n    27\u2192\\n    28\u2192    /// Project config: .bivvy/config.yml\\n    29\u2192    pub project: Option<PathBuf>,\\n    30\u2192\\n    31\u2192    /// Local overrides: .bivvy/config.local.yml\\n    32\u2192    pub project_local: Option<PathBuf>,\\n    33\u2192}\\n    34\u2192\\n    35\u2192impl ConfigPaths {\\n    36\u2192    /// Discover config files for the given project root.\\n    37\u2192    pub fn discover(project_root: &Path) -> Self {\\n    38\u2192        Self {\\n    39\u2192            extends: Vec::new(), // Populated later after parsing project config\\n    40\u2192            user_global: Self::find_user_global(),\\n    41\u2192            project: Self::find_project_config(project_root),\\n    42\u2192            project_local: Self::find_project_local(project_root),\\n    43\u2192        }\\n    44\u2192    }\\n    45\u2192\\n    46\u2192    /// Find user's global config at ~/.bivvy/config.yml\\n    47\u2192    fn find_user_global() -> Option<PathBuf> {\\n    48\u2192        let path = dirs::home_dir()?.join(\\\".bivvy\\\").join(\\\"config.yml\\\");\\n    49\u2192        if path.exists() {\\n    50\u2192            Some(path)\\n    51\u2192        } else {\\n    52\u2192            None\\n    53\u2192        }\\n    54\u2192    }\\n    55\u2192\\n    56\u2192    /// Find project config at .bivvy/config.yml\\n    57\u2192    fn find_project_config(project_root: &Path) -> Option<PathBuf> {\\n    58\u2192        let path = project_root.join(\\\".bivvy\\\").join(\\\"config.yml\\\");\\n    59\u2192        if path.exists() {\\n    60\u2192            Some(path)\\n    61\u2192        } else {\\n    62\u2192            None\\n    63\u2192        }\\n    64\u2192    }\\n    65\u2192\\n    66\u2192    /// Find local overrides at .bivvy/config.local.yml\\n    67\u2192    fn find_project_local(project_root: &Path) -> Option<PathBuf> {\\n    68\u2192        let path = project_root.join(\\\".bivvy\\\").join(\\\"config.local.yml\\\");\\n    69\u2192        if path.exists() {\\n    70\u2192            Some(path)\\n    71\u2192        } else {\\n    72\u2192            None\\n    73\u2192        }\\n    74\u2192    }\\n    75\u2192\\n    76\u2192    /// Returns all existing config paths in merge order.\\n    77\u2192    pub fn all_existing(&self) -> Vec<&PathBuf> {\\n    78\u2192        let mut paths = Vec::new();\\n    79\u2192\\n    80\u2192        for p in &self.extends {\\n    81\u2192            paths.push(p);\\n    82\u2192        }\\n    83\u2192\\n    84\u2192        if let Some(p) = &self.user_global {\\n    85\u2192            paths.push(p);\\n    86\u2192        }\\n    87\u2192\\n    88\u2192        if let Some(p) = &self.project {\\n    89\u2192            paths.push(p);\\n    90\u2192        }\\n    91\u2192\\n    92\u2192        if let Some(p) = &self.project_local {\\n    93\u2192            paths.push(p);\\n    94\u2192        }\\n    95\u2192\\n    96\u2192        paths\\n    97\u2192    }\\n    98\u2192\\n    99\u2192    /// Check if any project config exists.\\n   100\u2192    pub fn has_project_config(&self) -> bool {\\n   101\u2192        self.project.is_some()\\n   102\u2192    }\\n   103\u2192}\\n   104\u2192\\n   105\u2192/// Find the project root by walking up from current directory.\\n   106\u2192///\\n   107\u2192/// Looks for:\\n   108\u2192/// 1. `.bivvy` directory (primary indicator)\\n   109\u2192/// 2. `.git` directory (fallback)\\n   110\u2192///\\n   111\u2192/// # Returns\\n   112\u2192///\\n   113\u2192/// The path to the project root, or None if not found.\\n   114\u2192pub fn find_project_root(start: &Path) -> Option<PathBuf> {\\n   115\u2192    let mut current = start.to_path_buf();\\n   116\u2192\\n   117\u2192    loop {\\n   118\u2192        // Check for .bivvy directory\\n   119\u2192        if current.join(\\\".bivvy\\\").is_dir() {\\n   120\u2192            return Some(current);\\n   121\u2192        }\\n   122\u2192\\n   123\u2192        // Check for .git directory (fallback)\\n   124\u2192        if current.join(\\\".git\\\").exists() {\\n   125\u2192            return Some(current);\\n   126\u2192        }\\n   127\u2192\\n   128\u2192        // Move up one directory\\n   129\u2192        if !current.pop() {\\n   130\u2192            return None;\\n   131\u2192        }\\n   132\u2192    }\\n   133\u2192}\\n   134\u2192\\n   135\u2192/// Load a single config file and parse it into BivvyConfig.\\n   136\u2192///\\n   137\u2192/// # Errors\\n   138\u2192///\\n   139\u2192/// Returns `ConfigNotFound` if the file doesn't exist.\\n   140\u2192/// Returns `ConfigParseError` if the YAML is invalid.\\n   141\u2192pub fn load_config_file(path: &Path) -> Result<BivvyConfig> {\\n   142\u2192    let content = fs::read_to_string(path).map_err(|e| {\\n   143\u2192        if e.kind() == std::io::ErrorKind::NotFound {\\n   144\u2192            BivvyError::ConfigNotFound {\\n   145\u2192                path: path.to_path_buf(),\\n   146\u2192            }\\n   147\u2192        } else {\\n   148\u2192            BivvyError::Io(e)\\n   149\u2192        }\\n   150\u2192    })?;\\n   151\u2192\\n   152\u2192    parse_config(&content, path)\\n   153\u2192}\\n   154\u2192\\n   155\u2192/// Parse YAML content into BivvyConfig.\\n   156\u2192///\\n   157\u2192/// # Arguments\\n   158\u2192///\\n   159\u2192/// * `content` - The YAML content to parse\\n   160\u2192/// * `source_path` - Path for error reporting\\n   161\u2192pub fn parse_config(content: &str, source_path: &Path) -> Result<BivvyConfig> {\\n   162\u2192    serde_yaml::from_str(content).map_err(|e| BivvyError::ConfigParseError {\\n   163\u2192        path: source_path.to_path_buf(),\\n   164\u2192        message: e.to_string(),\\n   165\u2192    })\\n   166\u2192}\\n   167\u2192\\n   168\u2192/// Load a config file as raw YAML Value (for merging).\\n   169\u2192///\\n   170\u2192/// Returns the raw serde_yaml::Value without deserializing into\\n   171\u2192/// BivvyConfig, which allows for deep merging before final parsing.\\n   172\u2192pub fn load_config_value(path: &Path) -> Result<serde_yaml::Value> {\\n   173\u2192    let content = fs::read_to_string(path).map_err(|e| {\\n   174\u2192        if e.kind() == std::io::ErrorKind::NotFound {\\n   175\u2192            BivvyError::ConfigNotFound {\\n   176\u2192                path: path.to_path_buf(),\\n   177\u2192            }\\n   178\u2192        } else {\\n   179\u2192            BivvyError::Io(e)\\n   180\u2192        }\\n   181\u2192    })?;\\n   182\u2192\\n   183\u2192    serde_yaml::from_str(&content).map_err(|e| BivvyError::ConfigParseError {\\n   184\u2192        path: path.to_path_buf(),\\n   185\u2192        message: e.to_string(),\\n   186\u2192    })\\n   187\u2192}\\n   188\u2192\\n   189\u2192/// Load and merge all config files for a project.\\n   190\u2192///\\n   191\u2192/// Discovers and merges configs in this order:\\n   192\u2192/// 1. Remote base configs (from `extends:`)\\n   193\u2192/// 2. User global config (`~/.bivvy/config.yml`)\\n   194\u2192/// 3. Project config (`.bivvy/config.yml`)\\n   195\u2192/// 4. Local overrides (`.bivvy/config.local.yml`)\\n   196\u2192///\\n   197\u2192/// # Errors\\n   198\u2192///\\n   199\u2192/// Returns `ConfigNotFound` if no project config exists.\\n   200\u2192/// Returns `ConfigParseError` if any config file is invalid.\\n   201\u2192pub fn load_merged_config(project_root: &Path) -> Result<BivvyConfig> {\\n   202\u2192    load_merged_config_with_resolver(project_root, &ExtendsResolver::default())\\n   203\u2192}\\n   204\u2192\\n   205\u2192/// Load and merge configs with a specific extends resolver.\\n   206\u2192///\\n   207\u2192/// This is the implementation behind `load_merged_config`, exposed\\n   208\u2192/// separately to allow injecting a custom resolver for testing.\\n   209\u2192pub fn load_merged_config_with_resolver(\\n   210\u2192    project_root: &Path,\\n   211\u2192    resolver: &ExtendsResolver,\\n   212\u2192) -> Result<BivvyConfig> {\\n   213\u2192    let paths = ConfigPaths::discover(project_root);\\n   214\u2192\\n   215\u2192    if !paths.has_project_config() {\\n   216\u2192        return Err(BivvyError::ConfigNotFound {\\n   217\u2192            path: project_root.join(\\\".bivvy\\\").join(\\\"config.yml\\\"),\\n   218\u2192        });\\n   219\u2192    }\\n   220\u2192\\n   221\u2192    let mut configs = Vec::new();\\n   222\u2192\\n   223\u2192    // Load in merge order\\n   224\u2192    for path in paths.all_existing() {\\n   225\u2192        let value = load_config_value(path)?;\\n   226\u2192        configs.push(value);\\n   227\u2192    }\\n   228\u2192\\n   229\u2192    // Merge all configs\\n   230\u2192    let merged = merge_configs(&configs);\\n   231\u2192\\n   232\u2192    // Parse merged value into typed config\\n   233\u2192    let config: BivvyConfig =\\n   234\u2192        serde_yaml::from_value(merged).map_err(|e| BivvyError::ConfigParseError {\\n   235\u2192            path: project_root.join(\\\".bivvy\\\").join(\\\"config.yml\\\"),\\n   236\u2192            message: format!(\\\"Failed to parse merged config: {}\\\", e),\\n   237\u2192        })?;\\n   238\u2192\\n   239\u2192    // Resolve extends if present\\n   240\u2192    if config.extends.is_some() {\\n   241\u2192        let resolved = resolver.resolve(&config)?;\\n   242\u2192        Ok(resolved)\\n   243\u2192    } else {\\n   244\u2192        Ok(config)\\n   245\u2192    }\\n   246\u2192}\\n   247\u2192\\n   248\u2192/// Load config with optional path override.\\n   249\u2192///\\n   250\u2192/// If `config_override` is provided, loads only that file without merging.\\n   251\u2192/// Otherwise, discovers and merges all config files.\\n   252\u2192pub fn load_config(project_root: &Path, config_override: Option<&Path>) -> Result<BivvyConfig> {\\n   253\u2192    if let Some(override_path) = config_override {\\n   254\u2192        // Direct load of specified file, no merging\\n   255\u2192        load_config_file(override_path)\\n   256\u2192    } else {\\n   257\u2192        load_merged_config(project_root)\\n   258\u2192    }\\n   259\u2192}\\n   260\u2192\\n   261\u2192#[cfg(test)]\\n   262\u2192mod tests {\\n   263\u2192    use super::*;\\n   264\u2192    use crate::config::remote::RemoteFetcher;\\n   265\u2192    use httpmock::prelude::*;\\n   266\u2192    use std::fs;\\n   267\u2192    use std::time::Duration;\\n   268\u2192    use tempfile::TempDir;\\n   269\u2192\\n   270\u2192    #[test]\\n   271\u2192    fn discover_finds_project_config() {\\n   272\u2192        let temp = TempDir::new().unwrap();\\n   273\u2192        let bivvy_dir = temp.path().join(\\\".bivvy\\\");\\n   274\u2192        fs::create_dir_all(&bivvy_dir).unwrap();\\n   275\u2192        fs::write(bivvy_dir.join(\\\"config.yml\\\"), \\\"app_name: test\\\").unwrap();\\n   276\u2192\\n   277\u2192        let paths = ConfigPaths::discover(temp.path());\\n   278\u2192        assert!(paths.project.is_some());\\n   279\u2192        assert!(paths.has_project_config());\\n   280\u2192    }\\n   281\u2192\\n   282\u2192    #[test]\\n   283\u2192    fn discover_finds_local_overrides() {\\n   284\u2192        let temp = TempDir::new().unwrap();\\n   285\u2192        let bivvy_dir = temp.path().join(\\\".bivvy\\\");\\n   286\u2192        fs::create_dir_all(&bivvy_dir).unwrap();\\n   287\u2192        fs::write(bivvy_dir.join(\\\"config.yml\\\"), \\\"\\\").unwrap();\\n   288\u2192        fs::write(bivvy_dir.join(\\\"config.local.yml\\\"), \\\"\\\").unwrap();\\n   289\u2192\\n   290\u2192        let paths = ConfigPaths::discover(temp.path());\\n   291\u2192        assert!(paths.project_local.is_some());\\n   292\u2192    }\\n   293\u2192\\n   294\u2192    #[test]\\n   295\u2192    fn discover_returns_none_for_missing_configs() {\\n   296\u2192        let temp = TempDir::new().unwrap();\\n   297\u2192        let paths = ConfigPaths::discover(temp.path());\\n   298\u2192        assert!(paths.project.is_none());\\n   299\u2192        assert!(paths.project_local.is_none());\\n   300\u2192        assert!(!paths.has_project_config());\\n   301\u2192    }\\n   302\u2192\\n   303\u2192    #[test]\\n   304\u2192    fn find_project_root_finds_bivvy_dir() {\\n   305\u2192        let temp = TempDir::new().unwrap();\\n   306\u2192        let subdir = temp.path().join(\\\"foo\\\").join(\\\"bar\\\");\\n   307\u2192        fs::create_dir_all(&subdir).unwrap();\\n   308\u2192        fs::create_dir_all(temp.path().join(\\\".bivvy\\\")).unwrap();\\n   309\u2192\\n   310\u2192        let root = find_project_root(&subdir);\\n   311\u2192        assert_eq!(root, Some(temp.path().to_path_buf()));\\n   312\u2192    }\\n   313\u2192\\n   314\u2192    #[test]\\n   315\u2192    fn find_project_root_finds_git_dir() {\\n   316\u2192        let temp = TempDir::new().unwrap();\\n   317\u2192        let subdir = temp.path().join(\\\"src\\\");\\n   318\u2192        fs::create_dir_all(&subdir).unwrap();\\n   319\u2192        fs::create_dir_all(temp.path().join(\\\".git\\\")).unwrap();\\n   320\u2192\\n   321\u2192        let root = find_project_root(&subdir);\\n   322\u2192        assert_eq!(root, Some(temp.path().to_path_buf()));\\n   323\u2192    }\\n   324\u2192\\n   325\u2192    #[test]\\n   326\u2192    fn find_project_root_prefers_bivvy_over_git() {\\n   327\u2192        let temp = TempDir::new().unwrap();\\n   328\u2192        let subdir = temp.path().join(\\\"nested\\\").join(\\\"project\\\");\\n   329\u2192        fs::create_dir_all(&subdir).unwrap();\\n   330\u2192        fs::create_dir_all(temp.path().join(\\\".git\\\")).unwrap();\\n   331\u2192        fs::create_dir_all(subdir.join(\\\".bivvy\\\")).unwrap();\\n   332\u2192\\n   333\u2192        let root = find_project_root(&subdir);\\n   334\u2192        assert_eq!(root, Some(subdir));\\n   335\u2192    }\\n   336\u2192\\n   337\u2192    #[test]\\n   338\u2192    fn all_existing_returns_in_merge_order() {\\n   339\u2192        let temp = TempDir::new().unwrap();\\n   340\u2192        let bivvy_dir = temp.path().join(\\\".bivvy\\\");\\n   341\u2192        fs::create_dir_all(&bivvy_dir).unwrap();\\n   342\u2192        fs::write(bivvy_dir.join(\\\"config.yml\\\"), \\\"\\\").unwrap();\\n   343\u2192        fs::write(bivvy_dir.join(\\\"config.local.yml\\\"), \\\"\\\").unwrap();\\n   344\u2192\\n   345\u2192        let paths = ConfigPaths::discover(temp.path());\\n   346\u2192        let all = paths.all_existing();\\n   347\u2192\\n   348\u2192        // Project should come before local\\n   349\u2192        assert!(all.len() >= 2);\\n   350\u2192    }\\n   351\u2192\\n   352\u2192    #[test]\\n   353\u2192    fn load_config_file_parses_valid_yaml() {\\n   354\u2192        let temp = TempDir::new().unwrap();\\n   355\u2192        let config_path = temp.path().join(\\\"config.yml\\\");\\n   356\u2192        fs::write(&config_path, \\\"app_name: TestApp\\\").unwrap();\\n   357\u2192\\n   358\u2192        let config = load_config_file(&config_path).unwrap();\\n   359\u2192        assert_eq!(config.app_name, Some(\\\"TestApp\\\".to_string()));\\n   360\u2192    }\\n   361\u2192\\n   362\u2192    #[test]\\n   363\u2192    fn load_config_file_returns_not_found_error() {\\n   364\u2192        let result = load_config_file(Path::new(\\\"/nonexistent/config.yml\\\"));\\n   365\u2192        assert!(matches!(result, Err(BivvyError::ConfigNotFound { .. })));\\n   366\u2192    }\\n   367\u2192\\n   368\u2192    #[test]\\n   369\u2192    fn parse_config_returns_parse_error_for_invalid_yaml() {\\n   370\u2192        let content = \\\"invalid: yaml: content: [\\\";\\n   371\u2192        let result = parse_config(content, Path::new(\\\"test.yml\\\"));\\n   372\u2192        assert!(matches!(result, Err(BivvyError::ConfigParseError { .. })));\\n   373\u2192    }\\n   374\u2192\\n   375\u2192    #[test]\\n   376\u2192    fn load_config_value_returns_raw_value() {\\n   377\u2192        let temp = TempDir::new().unwrap();\\n   378\u2192        let config_path = temp.path().join(\\\"config.yml\\\");\\n   379\u2192        fs::write(&config_path, \\\"key: value\\\\nnested:\\\\n  inner: 42\\\").unwrap();\\n   380\u2192\\n   381\u2192        let value = load_config_value(&config_path).unwrap();\\n   382\u2192        assert_eq!(value[\\\"key\\\"], \\\"value\\\");\\n   383\u2192        assert_eq!(value[\\\"nested\\\"][\\\"inner\\\"], 42);\\n   384\u2192    }\\n   385\u2192\\n   386\u2192    #[test]\\n   387\u2192    fn load_config_file_handles_empty_file() {\\n   388\u2192        let temp = TempDir::new().unwrap();\\n   389\u2192        let config_path = temp.path().join(\\\"config.yml\\\");\\n   390\u2192        fs::write(&config_path, \\\"\\\").unwrap();\\n   391\u2192\\n   392\u2192        let config = load_config_file(&config_path).unwrap();\\n   393\u2192        assert!(config.app_name.is_none());\\n   394\u2192        assert!(config.steps.is_empty());\\n   395\u2192    }\\n   396\u2192\\n   397\u2192    #[test]\\n   398\u2192    fn load_config_file_parses_full_config() {\\n   399\u2192        let temp = TempDir::new().unwrap();\\n   400\u2192        let config_path = temp.path().join(\\\"config.yml\\\");\\n   401\u2192        fs::write(\\n   402\u2192            &config_path,\\n   403\u2192            r#\\\"\\n   404\u2192app_name: \\\"FullApp\\\"\\n   405\u2192settings:\\n   406\u2192  default_output: quiet\\n   407\u2192steps:\\n   408\u2192  test:\\n   409\u2192    command: \\\"echo test\\\"\\n   410\u2192workflows:\\n   411\u2192  default:\\n   412\u2192    steps: [test]\\n   413\u2192\\\"#,\\n   414\u2192        )\\n   415\u2192        .unwrap();\\n   416\u2192\\n   417\u2192        let config = load_config_file(&config_path).unwrap();\\n   418\u2192        assert_eq!(config.app_name, Some(\\\"FullApp\\\".to_string()));\\n   419\u2192        assert!(config.steps.contains_key(\\\"test\\\"));\\n   420\u2192        assert!(config.workflows.contains_key(\\\"default\\\"));\\n   421\u2192    }\\n   422\u2192\\n   423\u2192    #[test]\\n   424\u2192    fn load_merged_config_merges_project_and_local() {\\n   425\u2192        use crate::config::schema::OutputMode;\\n   426\u2192\\n   427\u2192        let temp = TempDir::new().unwrap();\\n   428\u2192        let bivvy_dir = temp.path().join(\\\".bivvy\\\");\\n   429\u2192        fs::create_dir_all(&bivvy_dir).unwrap();\\n   430\u2192\\n   431\u2192        // Project config\\n   432\u2192        fs::write(\\n   433\u2192            bivvy_dir.join(\\\"config.yml\\\"),\\n   434\u2192            r#\\\"\\n   435\u2192app_name: TestApp\\n   436\u2192settings:\\n   437\u2192  default_output: verbose\\n   438\u2192steps:\\n   439\u2192  test:\\n   440\u2192    command: \\\"echo test\\\"\\n   441\u2192\\\"#,\\n   442\u2192        )\\n   443\u2192        .unwrap();\\n   444\u2192\\n   445\u2192        // Local overrides\\n   446\u2192        fs::write(\\n   447\u2192            bivvy_dir.join(\\\"config.local.yml\\\"),\\n   448\u2192            r#\\\"\\n   449\u2192settings:\\n   450\u2192  default_output: quiet\\n   451\u2192\\\"#,\\n   452\u2192        )\\n   453\u2192        .unwrap();\\n   454\u2192\\n   455\u2192        let config = load_merged_config(temp.path()).unwrap();\\n   456\u2192\\n   457\u2192        assert_eq!(config.app_name, Some(\\\"TestApp\\\".to_string()));\\n   458\u2192        assert_eq!(config.settings.default_output, OutputMode::Quiet);\\n   459\u2192        assert!(config.steps.contains_key(\\\"test\\\"));\\n   460\u2192    }\\n   461\u2192\\n   462\u2192    #[test]\\n   463\u2192    fn load_merged_config_fails_without_project_config() {\\n   464\u2192        let temp = TempDir::new().unwrap();\\n   465\u2192        let result = load_merged_config(temp.path());\\n   466\u2192        assert!(matches!(result, Err(BivvyError::ConfigNotFound { .. })));\\n   467\u2192    }\\n   468\u2192\\n   469\u2192    #[test]\\n   470\u2192    fn load_config_with_override_skips_merge() {\\n   471\u2192        let temp = TempDir::new().unwrap();\\n   472\u2192        let override_path = temp.path().join(\\\"custom.yml\\\");\\n   473\u2192        fs::write(&override_path, \\\"app_name: CustomApp\\\").unwrap();\\n   474\u2192\\n   475\u2192        let config = load_config(temp.path(), Some(&override_path)).unwrap();\\n   476\u2192        assert_eq!(config.app_name, Some(\\\"CustomApp\\\".to_string()));\\n   477\u2192    }\\n   478\u2192\\n   479\u2192    #[test]\\n   480\u2192    fn load_merged_config_preserves_step_definitions() {\\n   481\u2192        let temp = TempDir::new().unwrap();\\n   482\u2192        let bivvy_dir = temp.path().join(\\\".bivvy\\\");\\n   483\u2192        fs::create_dir_all(&bivvy_dir).unwrap();\\n   484\u2192\\n   485\u2192        fs::write(\\n   486\u2192            bivvy_dir.join(\\\"config.yml\\\"),\\n   487\u2192            r#\\\"\\n   488\u2192steps:\\n   489\u2192  deps:\\n   490\u2192    command: \\\"yarn install\\\"\\n   491\u2192    watches:\\n   492\u2192      - package.json\\n   493\u2192  database:\\n   494\u2192    command: \\\"rails db:setup\\\"\\n   495\u2192\\\"#,\\n   496\u2192        )\\n   497\u2192        .unwrap();\\n   498\u2192\\n   499\u2192        fs::write(\\n   500\u2192            bivvy_dir.join(\\\"config.local.yml\\\"),\\n   501\u2192            r#\\\"\\n   502\u2192steps:\\n   503\u2192  deps:\\n   504\u2192    command: \\\"yarn install --frozen-lockfile\\\"\\n   505\u2192\\\"#,\\n   506\u2192        )\\n   507\u2192        .unwrap();\\n   508\u2192\\n   509\u2192        let config = load_merged_config(temp.path()).unwrap();\\n   510\u2192\\n   511\u2192        // deps command should be overridden\\n   512\u2192        assert_eq!(\\n   513\u2192            config.steps[\\\"deps\\\"].command,\\n   514\u2192            Some(\\\"yarn install --frozen-lockfile\\\".to_string())\\n   515\u2192        );\\n   516\u2192        // database should still exist\\n   517\u2192        assert!(config.steps.contains_key(\\\"database\\\"));\\n   518\u2192    }\\n   519\u2192\\n   520\u2192    #[test]\\n   521\u2192    fn load_config_without_override_uses_merge() {\\n   522\u2192        let temp = TempDir::new().unwrap();\\n   523\u2192        let bivvy_dir = temp.path().join(\\\".bivvy\\\");\\n   524\u2192        fs::create_dir_all(&bivvy_dir).unwrap();\\n   525\u2192        fs::write(bivvy_dir.join(\\\"config.yml\\\"), \\\"app_name: Merged\\\").unwrap();\\n   526\u2192\\n   527\u2192        let config = load_config(temp.path(), None).unwrap();\\n   528\u2192        assert_eq!(config.app_name, Some(\\\"Merged\\\".to_string()));\\n   529\u2192    }\\n   530\u2192\\n   531\u2192    // --- Extends pipeline integration tests ---\\n   532\u2192\\n   533\u2192    fn resolver_for_mock(_server: &MockServer) -> ExtendsResolver {\\n   534\u2192        let temp = TempDir::new().unwrap();\\n   535\u2192        let cache_dir = temp.keep().join(\\\"cache\\\");\\n   536\u2192        let fetcher = RemoteFetcher::with_cache_dir(Duration::from_secs(10), cache_dir);\\n   537\u2192        ExtendsResolver::with_fetcher(fetcher)\\n   538\u2192    }\\n   539\u2192\\n   540\u2192    #[test]\\n   541\u2192    fn load_merged_config_resolves_extends() {\\n   542\u2192        let server = MockServer::start();\\n   543\u2192\\n   544\u2192        let base_yaml = r#\\\"\\n   545\u2192steps:\\n   546\u2192  lint:\\n   547\u2192    command: eslint .\\n   548\u2192    title: Lint code\\n   549\u2192\\\"#;\\n   550\u2192\\n   551\u2192        server.mock(|when, then| {\\n   552\u2192            when.method(GET).path(\\\"/base.yml\\\");\\n   553\u2192            then.status(200).body(base_yaml);\\n   554\u2192        });\\n   555\u2192\\n   556\u2192        let temp = TempDir::new().unwrap();\\n   557\u2192        let bivvy_dir = temp.path().join(\\\".bivvy\\\");\\n   558\u2192        fs::create_dir_all(&bivvy_dir).unwrap();\\n   559\u2192        fs::write(\\n   560\u2192            bivvy_dir.join(\\\"config.yml\\\"),\\n   561\u2192            format!(\\n   562\u2192                r#\\\"\\n   563\u2192extends:\\n   564\u2192  - url: {}\\n   565\u2192app_name: MyApp\\n   566\u2192steps:\\n   567\u2192  test:\\n   568\u2192    command: jest\\n   569\u2192\\\"#,\\n   570\u2192                server.url(\\\"/base.yml\\\")\\n   571\u2192            ),\\n   572\u2192        )\\n   573\u2192        .unwrap();\\n   574\u2192\\n   575\u2192        let resolver = resolver_for_mock(&server);\\n   576\u2192        let config = load_merged_config_with_resolver(temp.path(), &resolver).unwrap();\\n   577\u2192\\n   578\u2192        // Local app_name is preserved\\n   579\u2192        assert_eq!(config.app_name, Some(\\\"MyApp\\\".to_string()));\\n   580\u2192        // Base step is merged in\\n   581\u2192        assert!(config.steps.contains_key(\\\"lint\\\"));\\n   582\u2192        assert_eq!(config.steps[\\\"lint\\\"].command, Some(\\\"eslint .\\\".to_string()));\\n   583\u2192        // Local step is preserved\\n   584\u2192        assert!(config.steps.contains_key(\\\"test\\\"));\\n   585\u2192        // Extends is cleared\\n   586\u2192        assert!(config.extends.is_none());\\n   587\u2192    }\\n   588\u2192\\n   589\u2192    #[test]\\n   590\u2192    fn extends_merges_before_local_override() {\\n   591\u2192        let server = MockServer::start();\\n   592\u2192\\n   593\u2192        let base_yaml = r#\\\"\\n   594\u2192app_name: BaseApp\\n   595\u2192settings:\\n   596\u2192  default_output: quiet\\n   597\u2192steps:\\n   598\u2192  install:\\n   599\u2192    command: npm install\\n   600\u2192    title: Base install\\n   601\u2192\\\"#;\\n   602\u2192\\n   603\u2192        server.mock(|when, then| {\\n   604\u2192            when.method(GET).path(\\\"/base.yml\\\");\\n   605\u2192            then.status(200).body(base_yaml);\\n   606\u2192        });\\n   607\u2192\\n   608\u2192        let temp = TempDir::new().unwrap();\\n   609\u2192        let bivvy_dir = temp.path().join(\\\".bivvy\\\");\\n   610\u2192        fs::create_dir_all(&bivvy_dir).unwrap();\\n   611\u2192\\n   612\u2192        // Project config extends base and overrides install command\\n   613\u2192        fs::write(\\n   614\u2192            bivvy_dir.join(\\\"config.yml\\\"),\\n   615\u2192            format!(\\n   616\u2192                r#\\\"\\n   617\u2192extends:\\n   618\u2192  - url: {}\\n   619\u2192app_name: MyApp\\n   620\u2192steps:\\n   621\u2192  install:\\n   622\u2192    command: yarn install\\n   623\u2192\\\"#,\\n   624\u2192                server.url(\\\"/base.yml\\\")\\n   625\u2192            ),\\n   626\u2192        )\\n   627\u2192        .unwrap();\\n   628\u2192\\n   629\u2192        let resolver = resolver_for_mock(&server);\\n   630\u2192        let config = load_merged_config_with_resolver(temp.path(), &resolver).unwrap();\\n   631\u2192\\n   632\u2192        // Local overrides base\\n   633\u2192        assert_eq!(config.app_name, Some(\\\"MyApp\\\".to_string()));\\n   634\u2192        assert_eq!(\\n   635\u2192            config.steps[\\\"install\\\"].command,\\n   636\u2192            Some(\\\"yarn install\\\".to_string())\\n   637\u2192        );\\n   638\u2192    }\\n   639\u2192\\n   640\u2192    #[test]\\n   641\u2192    fn extends_with_local_override_file() {\\n   642\u2192        let server = MockServer::start();\\n   643\u2192\\n   644\u2192        let base_yaml = r#\\\"\\n   645\u2192app_name: BaseApp\\n   646\u2192steps:\\n   647\u2192  install:\\n   648\u2192    command: npm install\\n   649\u2192\\\"#;\\n   650\u2192\\n   651\u2192        server.mock(|when, then| {\\n   652\u2192            when.method(GET).path(\\\"/base.yml\\\");\\n   653\u2192            then.status(200).body(base_yaml);\\n   654\u2192        });\\n   655\u2192\\n   656\u2192        let temp = TempDir::new().unwrap();\\n   657\u2192        let bivvy_dir = temp.path().join(\\\".bivvy\\\");\\n   658\u2192        fs::create_dir_all(&bivvy_dir).unwrap();\\n   659\u2192\\n   660\u2192        // Project config extends base\\n   661\u2192        fs::write(\\n   662\u2192            bivvy_dir.join(\\\"config.yml\\\"),\\n   663\u2192            format!(\\n   664\u2192                r#\\\"\\n   665\u2192extends:\\n   666\u2192  - url: {}\\n   667\u2192app_name: ProjectApp\\n   668\u2192\\\"#,\\n   669\u2192                server.url(\\\"/base.yml\\\")\\n   670\u2192            ),\\n   671\u2192        )\\n   672\u2192        .unwrap();\\n   673\u2192\\n   674\u2192        // Local override file overrides app_name\\n   675\u2192        fs::write(\\n   676\u2192            bivvy_dir.join(\\\"config.local.yml\\\"),\\n   677\u2192            \\\"app_name: LocalOverride\\\\n\\\",\\n   678\u2192        )\\n   679\u2192        .unwrap();\\n   680\u2192\\n   681\u2192        let resolver = resolver_for_mock(&server);\\n   682\u2192        let config = load_merged_config_with_resolver(temp.path(), &resolver).unwrap();\\n   683\u2192\\n   684\u2192        // The extends resolution happens on the merged config,\\n   685\u2192        // so local override takes effect before extends\\n   686\u2192        // But since extends is in config.yml and local overrides app_name,\\n   687\u2192        // the merged config will have app_name=LocalOverride + extends from config.yml\\n   688\u2192        assert_eq!(config.app_name, Some(\\\"LocalOverride\\\".to_string()));\\n   689\u2192        // Base step should be present (extends still works)\\n   690\u2192        assert!(config.steps.contains_key(\\\"install\\\"));\\n   691\u2192    }\\n   692\u2192\\n   693\u2192    #[test]\\n   694\u2192    fn config_without_extends_still_works() {\\n   695\u2192        let temp = TempDir::new().unwrap();\\n   696\u2192        let bivvy_dir = temp.path().join(\\\".bivvy\\\");\\n   697\u2192        fs::create_dir_all(&bivvy_dir).unwrap();\\n   698\u2192        fs::write(bivvy_dir.join(\\\"config.yml\\\"), \\\"app_name: NoExtends\\\").unwrap();\\n   699\u2192\\n   700\u2192        // Using default resolver \u2014 won't make any HTTP calls\\n   701\u2192        let config = load_merged_config(temp.path()).unwrap();\\n   702\u2192        assert_eq!(config.app_name, Some(\\\"NoExtends\\\".to_string()));\\n   703\u2192    }\\n   704\u2192}\\n   705\u2192\"}]},\"parent_tool_use_id\":null,\"session_id\":\"71626d50-8e30-42b0-86de-6cafbf80e23f\",\"uuid\":\"2685939f-00e2-4092-8556-75b24e467b4a\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/private/var/folders/_q/qzh8_t6s15388qqf3p6n3d200000gp/T/bench-7okzbcvu/src/config/loader.rs\",\"content\":\"//! Configuration file discovery and loading.\\n//!\\n//! This module handles finding and loading configuration files from\\n//! various locations in the correct priority order.\\n\\nuse crate::config::extends::ExtendsResolver;\\nuse crate::config::merger::merge_configs;\\nuse crate::config::schema::BivvyConfig;\\nuse crate::error::{BivvyError, Result};\\nuse std::fs;\\nuse std::path::{Path, PathBuf};\\n\\n/// Paths to configuration files in priority order (later overrides earlier).\\n///\\n/// Merge order:\\n/// 1. Remote base configs (from `extends:`)\\n/// 2. User global config (`~/.bivvy/config.yml`)\\n/// 3. Project config (`.bivvy/config.yml`)\\n/// 4. Local overrides (`.bivvy/config.local.yml`)\\n#[derive(Debug, Clone)]\\npub struct ConfigPaths {\\n    /// Remote base config (if extends: is used)\\n    pub extends: Vec<PathBuf>,\\n\\n    /// User's global config: ~/.bivvy/config.yml\\n    pub user_global: Option<PathBuf>,\\n\\n    /// Project config: .bivvy/config.yml\\n    pub project: Option<PathBuf>,\\n\\n    /// Local overrides: .bivvy/config.local.yml\\n    pub project_local: Option<PathBuf>,\\n}\\n\\nimpl ConfigPaths {\\n    /// Discover config files for the given project root.\\n    pub fn discover(project_root: &Path) -> Self {\\n        Self {\\n            extends: Vec::new(), // Populated later after parsing project config\\n            user_global: Self::find_user_global(),\\n            project: Self::find_project_config(project_root),\\n            project_local: Self::find_project_local(project_root),\\n        }\\n    }\\n\\n    /// Find user's global config at ~/.bivvy/config.yml\\n    fn find_user_global() -> Option<PathBuf> {\\n        let path = dirs::home_dir()?.join(\\\".bivvy\\\").join(\\\"config.yml\\\");\\n        if path.exists() {\\n            Some(path)\\n        } else {\\n            None\\n        }\\n    }\\n\\n    /// Find project config at .bivvy/config.yml\\n    fn find_project_config(project_root: &Path) -> Option<PathBuf> {\\n        let path = project_root.join(\\\".bivvy\\\").join(\\\"config.yml\\\");\\n        if path.exists() {\\n            Some(path)\\n        } else {\\n            None\\n        }\\n    }\\n\\n    /// Find local overrides at .bivvy/config.local.yml\\n    fn find_project_local(project_root: &Path) -> Option<PathBuf> {\\n        let path = project_root.join(\\\".bivvy\\\").join(\\\"config.local.yml\\\");\\n        if path.exists() {\\n            Some(path)\\n        } else {\\n            None\\n        }\\n    }\\n\\n    /// Returns all existing config paths in merge order.\\n    pub fn all_existing(&self) -> Vec<&PathBuf> {\\n        let mut paths = Vec::new();\\n\\n        for p in &self.extends {\\n            paths.push(p);\\n        }\\n\\n        if let Some(p) = &self.user_global {\\n            paths.push(p);\\n        }\\n\\n        if let Some(p) = &self.project {\\n            paths.push(p);\\n        }\\n\\n        if let Some(p) = &self.project_local {\\n            paths.push(p);\\n        }\\n\\n        paths\\n    }\\n\\n    /// Check if any project config exists.\\n    pub fn has_project_config(&self) -> bool {\\n        self.project.is_some()\\n    }\\n}\\n\\n/// Find the project root by walking up from current directory.\\n///\\n/// Looks for:\\n/// 1. `.bivvy` directory (primary indicator)\\n/// 2. `.git` directory (fallback)\\n///\\n/// # Returns\\n///\\n/// The path to the project root, or None if not found.\\npub fn find_project_root(start: &Path) -> Option<PathBuf> {\\n    let mut current = start.to_path_buf();\\n\\n    loop {\\n        // Check for .bivvy directory\\n        if current.join(\\\".bivvy\\\").is_dir() {\\n            return Some(current);\\n        }\\n\\n        // Check for .git directory (fallback)\\n        if current.join(\\\".git\\\").exists() {\\n            return Some(current);\\n        }\\n\\n        // Move up one directory\\n        if !current.pop() {\\n            return None;\\n        }\\n    }\\n}\\n\\n/// Load a single config file and parse it into BivvyConfig.\\n///\\n/// # Errors\\n///\\n/// Returns `ConfigNotFound` if the file doesn't exist.\\n/// Returns `ConfigParseError` if the YAML is invalid.\\npub fn load_config_file(path: &Path) -> Result<BivvyConfig> {\\n    let content = fs::read_to_string(path).map_err(|e| {\\n        if e.kind() == std::io::ErrorKind::NotFound {\\n            BivvyError::ConfigNotFound {\\n                path: path.to_path_buf(),\\n            }\\n        } else {\\n            BivvyError::Io(e)\\n        }\\n    })?;\\n\\n    parse_config(&content, path)\\n}\\n\\n/// Parse YAML content into BivvyConfig.\\n///\\n/// # Arguments\\n///\\n/// * `content` - The YAML content to parse\\n/// * `source_path` - Path for error reporting\\npub fn parse_config(content: &str, source_path: &Path) -> Result<BivvyConfig> {\\n    serde_yaml::from_str(content).map_err(|e| BivvyError::ConfigParseError {\\n        path: source_path.to_path_buf(),\\n        message: e.to_string(),\\n    })\\n}\\n\\n/// Load a config file as raw YAML Value (for merging).\\n///\\n/// Returns the raw serde_yaml::Value without deserializing into\\n/// BivvyConfig, which allows for deep merging before final parsing.\\npub fn load_config_value(path: &Path) -> Result<serde_yaml::Value> {\\n    let content = fs::read_to_string(path).map_err(|e| {\\n        if e.kind() == std::io::ErrorKind::NotFound {\\n            BivvyError::ConfigNotFound {\\n                path: path.to_path_buf(),\\n            }\\n        } else {\\n            BivvyError::Io(e)\\n        }\\n    })?;\\n\\n    serde_yaml::from_str(&content).map_err(|e| BivvyError::ConfigParseError {\\n        path: path.to_path_buf(),\\n        message: e.to_string(),\\n    })\\n}\\n\\n/// Load and merge all config files for a project.\\n///\\n/// Discovers and merges configs in this order:\\n/// 1. Remote base configs (from `extends:`)\\n/// 2. User global config (`~/.bivvy/config.yml`)\\n/// 3. Project config (`.bivvy/config.yml`)\\n/// 4. Local overrides (`.bivvy/config.local.yml`)\\n///\\n/// # Errors\\n///\\n/// Returns `ConfigNotFound` if no project config exists.\\n/// Returns `ConfigParseError` if any config file is invalid.\\npub fn load_merged_config(project_root: &Path) -> Result<BivvyConfig> {\\n    load_merged_config_with_resolver(project_root, &ExtendsResolver::default())\\n}\\n\\n/// Load and merge configs with a specific extends resolver.\\n///\\n/// This is the implementation behind `load_merged_config`, exposed\\n/// separately to allow injecting a custom resolver for testing.\\npub fn load_merged_config_with_resolver(\\n    project_root: &Path,\\n    resolver: &ExtendsResolver,\\n) -> Result<BivvyConfig> {\\n    let paths = ConfigPaths::discover(project_root);\\n\\n    if !paths.has_project_config() {\\n        return Err(BivvyError::ConfigNotFound {\\n            path: project_root.join(\\\".bivvy\\\").join(\\\"config.yml\\\"),\\n        });\\n    }\\n\\n    let mut configs = Vec::new();\\n\\n    // Load in merge order\\n    for path in paths.all_existing() {\\n        let value = load_config_value(path)?;\\n        configs.push(value);\\n    }\\n\\n    // Merge all configs\\n    let merged = merge_configs(&configs);\\n\\n    // Parse merged value into typed config\\n    let config: BivvyConfig =\\n        serde_yaml::from_value(merged).map_err(|e| BivvyError::ConfigParseError {\\n            path: project_root.join(\\\".bivvy\\\").join(\\\"config.yml\\\"),\\n            message: format!(\\\"Failed to parse merged config: {}\\\", e),\\n        })?;\\n\\n    // Resolve extends if present\\n    if config.extends.is_some() {\\n        let resolved = resolver.resolve(&config)?;\\n        Ok(resolved)\\n    } else {\\n        Ok(config)\\n    }\\n}\\n\\n/// Load config with optional path override.\\n///\\n/// If `config_override` is provided, loads only that file without merging.\\n/// Otherwise, discovers and merges all config files.\\npub fn load_config(project_root: &Path, config_override: Option<&Path>) -> Result<BivvyConfig> {\\n    if let Some(override_path) = config_override {\\n        // Direct load of specified file, no merging\\n        load_config_file(override_path)\\n    } else {\\n        load_merged_config(project_root)\\n    }\\n}\\n\\n#[cfg(test)]\\nmod tests {\\n    use super::*;\\n    use crate::config::remote::RemoteFetcher;\\n    use httpmock::prelude::*;\\n    use std::fs;\\n    use std::time::Duration;\\n    use tempfile::TempDir;\\n\\n    #[test]\\n    fn discover_finds_project_config() {\\n        let temp = TempDir::new().unwrap();\\n        let bivvy_dir = temp.path().join(\\\".bivvy\\\");\\n        fs::create_dir_all(&bivvy_dir).unwrap();\\n        fs::write(bivvy_dir.join(\\\"config.yml\\\"), \\\"app_name: test\\\").unwrap();\\n\\n        let paths = ConfigPaths::discover(temp.path());\\n        assert!(paths.project.is_some());\\n        assert!(paths.has_project_config());\\n    }\\n\\n    #[test]\\n    fn discover_finds_local_overrides() {\\n        let temp = TempDir::new().unwrap();\\n        let bivvy_dir = temp.path().join(\\\".bivvy\\\");\\n        fs::create_dir_all(&bivvy_dir).unwrap();\\n        fs::write(bivvy_dir.join(\\\"config.yml\\\"), \\\"\\\").unwrap();\\n        fs::write(bivvy_dir.join(\\\"config.local.yml\\\"), \\\"\\\").unwrap();\\n\\n        let paths = ConfigPaths::discover(temp.path());\\n        assert!(paths.project_local.is_some());\\n    }\\n\\n    #[test]\\n    fn discover_returns_none_for_missing_configs() {\\n        let temp = TempDir::new().unwrap();\\n        let paths = ConfigPaths::discover(temp.path());\\n        assert!(paths.project.is_none());\\n        assert!(paths.project_local.is_none());\\n        assert!(!paths.has_project_config());\\n    }\\n\\n    #[test]\\n    fn find_project_root_finds_bivvy_dir() {\\n        let temp = TempDir::new().unwrap();\\n        let subdir = temp.path().join(\\\"foo\\\").join(\\\"bar\\\");\\n        fs::create_dir_all(&subdir).unwrap();\\n        fs::create_dir_all(temp.path().join(\\\".bivvy\\\")).unwrap();\\n\\n        let root = find_project_root(&subdir);\\n        assert_eq!(root, Some(temp.path().to_path_buf()));\\n    }\\n\\n    #[test]\\n    fn find_project_root_finds_git_dir() {\\n        let temp = TempDir::new().unwrap();\\n        let subdir = temp.path().join(\\\"src\\\");\\n        fs::create_dir_all(&subdir).unwrap();\\n        fs::create_dir_all(temp.path().join(\\\".git\\\")).unwrap();\\n\\n        let root = find_project_root(&subdir);\\n        assert_eq!(root, Some(temp.path().to_path_buf()));\\n    }\\n\\n    #[test]\\n    fn find_project_root_prefers_bivvy_over_git() {\\n        let temp = TempDir::new().unwrap();\\n        let subdir = temp.path().join(\\\"nested\\\").join(\\\"project\\\");\\n        fs::create_dir_all(&subdir).unwrap();\\n        fs::create_dir_all(temp.path().join(\\\".git\\\")).unwrap();\\n        fs::create_dir_all(subdir.join(\\\".bivvy\\\")).unwrap();\\n\\n        let root = find_project_root(&subdir);\\n        assert_eq!(root, Some(subdir));\\n    }\\n\\n    #[test]\\n    fn all_existing_returns_in_merge_order() {\\n        let temp = TempDir::new().unwrap();\\n        let bivvy_dir = temp.path().join(\\\".bivvy\\\");\\n        fs::create_dir_all(&bivvy_dir).unwrap();\\n        fs::write(bivvy_dir.join(\\\"config.yml\\\"), \\\"\\\").unwrap();\\n        fs::write(bivvy_dir.join(\\\"config.local.yml\\\"), \\\"\\\").unwrap();\\n\\n        let paths = ConfigPaths::discover(temp.path());\\n        let all = paths.all_existing();\\n\\n        // Project should come before local\\n        assert!(all.len() >= 2);\\n    }\\n\\n    #[test]\\n    fn load_config_file_parses_valid_yaml() {\\n        let temp = TempDir::new().unwrap();\\n        let config_path = temp.path().join(\\\"config.yml\\\");\\n        fs::write(&config_path, \\\"app_name: TestApp\\\").unwrap();\\n\\n        let config = load_config_file(&config_path).unwrap();\\n        assert_eq!(config.app_name, Some(\\\"TestApp\\\".to_string()));\\n    }\\n\\n    #[test]\\n    fn load_config_file_returns_not_found_error() {\\n        let result = load_config_file(Path::new(\\\"/nonexistent/config.yml\\\"));\\n        assert!(matches!(result, Err(BivvyError::ConfigNotFound { .. })));\\n    }\\n\\n    #[test]\\n    fn parse_config_returns_parse_error_for_invalid_yaml() {\\n        let content = \\\"invalid: yaml: content: [\\\";\\n        let result = parse_config(content, Path::new(\\\"test.yml\\\"));\\n        assert!(matches!(result, Err(BivvyError::ConfigParseError { .. })));\\n    }\\n\\n    #[test]\\n    fn load_config_value_returns_raw_value() {\\n        let temp = TempDir::new().unwrap();\\n        let config_path = temp.path().join(\\\"config.yml\\\");\\n        fs::write(&config_path, \\\"key: value\\\\nnested:\\\\n  inner: 42\\\").unwrap();\\n\\n        let value = load_config_value(&config_path).unwrap();\\n        assert_eq!(value[\\\"key\\\"], \\\"value\\\");\\n        assert_eq!(value[\\\"nested\\\"][\\\"inner\\\"], 42);\\n    }\\n\\n    #[test]\\n    fn load_config_file_handles_empty_file() {\\n        let temp = TempDir::new().unwrap();\\n        let config_path = temp.path().join(\\\"config.yml\\\");\\n        fs::write(&config_path, \\\"\\\").unwrap();\\n\\n        let config = load_config_file(&config_path).unwrap();\\n        assert!(config.app_name.is_none());\\n        assert!(config.steps.is_empty());\\n    }\\n\\n    #[test]\\n    fn load_config_file_parses_full_config() {\\n        let temp = TempDir::new().unwrap();\\n        let config_path = temp.path().join(\\\"config.yml\\\");\\n        fs::write(\\n            &config_path,\\n            r#\\\"\\napp_name: \\\"FullApp\\\"\\nsettings:\\n  default_output: quiet\\nsteps:\\n  test:\\n    command: \\\"echo test\\\"\\nworkflows:\\n  default:\\n    steps: [test]\\n\\\"#,\\n        )\\n        .unwrap();\\n\\n        let config = load_config_file(&config_path).unwrap();\\n        assert_eq!(config.app_name, Some(\\\"FullApp\\\".to_string()));\\n        assert!(config.steps.contains_key(\\\"test\\\"));\\n        assert!(config.workflows.contains_key(\\\"default\\\"));\\n    }\\n\\n    #[test]\\n    fn load_merged_config_merges_project_and_local() {\\n        use crate::config::schema::OutputMode;\\n\\n        let temp = TempDir::new().unwrap();\\n        let bivvy_dir = temp.path().join(\\\".bivvy\\\");\\n        fs::create_dir_all(&bivvy_dir).unwrap();\\n\\n        // Project config\\n        fs::write(\\n            bivvy_dir.join(\\\"config.yml\\\"),\\n            r#\\\"\\napp_name: TestApp\\nsettings:\\n  default_output: verbose\\nsteps:\\n  test:\\n    command: \\\"echo test\\\"\\n\\\"#,\\n        )\\n        .unwrap();\\n\\n        // Local overrides\\n        fs::write(\\n            bivvy_dir.join(\\\"config.local.yml\\\"),\\n            r#\\\"\\nsettings:\\n  default_output: quiet\\n\\\"#,\\n        )\\n        .unwrap();\\n\\n        let config = load_merged_config(temp.path()).unwrap();\\n\\n        assert_eq!(config.app_name, Some(\\\"TestApp\\\".to_string()));\\n        assert_eq!(config.settings.default_output, OutputMode::Quiet);\\n        assert!(config.steps.contains_key(\\\"test\\\"));\\n    }\\n\\n    #[test]\\n    fn load_merged_config_fails_without_project_config() {\\n        let temp = TempDir::new().unwrap();\\n        let result = load_merged_config(temp.path());\\n        assert!(matches!(result, Err(BivvyError::ConfigNotFound { .. })));\\n    }\\n\\n    #[test]\\n    fn load_config_with_override_skips_merge() {\\n        let temp = TempDir::new().unwrap();\\n        let override_path = temp.path().join(\\\"custom.yml\\\");\\n        fs::write(&override_path, \\\"app_name: CustomApp\\\").unwrap();\\n\\n        let config = load_config(temp.path(), Some(&override_path)).unwrap();\\n        assert_eq!(config.app_name, Some(\\\"CustomApp\\\".to_string()));\\n    }\\n\\n    #[test]\\n    fn load_merged_config_preserves_step_definitions() {\\n        let temp = TempDir::new().unwrap();\\n        let bivvy_dir = temp.path().join(\\\".bivvy\\\");\\n        fs::create_dir_all(&bivvy_dir).unwrap();\\n\\n        fs::write(\\n            bivvy_dir.join(\\\"config.yml\\\"),\\n            r#\\\"\\nsteps:\\n  deps:\\n    command: \\\"yarn install\\\"\\n    watches:\\n      - package.json\\n  database:\\n    command: \\\"rails db:setup\\\"\\n\\\"#,\\n        )\\n        .unwrap();\\n\\n        fs::write(\\n            bivvy_dir.join(\\\"config.local.yml\\\"),\\n            r#\\\"\\nsteps:\\n  deps:\\n    command: \\\"yarn install --frozen-lockfile\\\"\\n\\\"#,\\n        )\\n        .unwrap();\\n\\n        let config = load_merged_config(temp.path()).unwrap();\\n\\n        // deps command should be overridden\\n        assert_eq!(\\n            config.steps[\\\"deps\\\"].command,\\n            Some(\\\"yarn install --frozen-lockfile\\\".to_string())\\n        );\\n        // database should still exist\\n        assert!(config.steps.contains_key(\\\"database\\\"));\\n    }\\n\\n    #[test]\\n    fn load_config_without_override_uses_merge() {\\n        let temp = TempDir::new().unwrap();\\n        let bivvy_dir = temp.path().join(\\\".bivvy\\\");\\n        fs::create_dir_all(&bivvy_dir).unwrap();\\n        fs::write(bivvy_dir.join(\\\"config.yml\\\"), \\\"app_name: Merged\\\").unwrap();\\n\\n        let config = load_config(temp.path(), None).unwrap();\\n        assert_eq!(config.app_name, Some(\\\"Merged\\\".to_string()));\\n    }\\n\\n    // --- Extends pipeline integration tests ---\\n\\n    fn resolver_for_mock(_server: &MockServer) -> ExtendsResolver {\\n        let temp = TempDir::new().unwrap();\\n        let cache_dir = temp.keep().join(\\\"cache\\\");\\n        let fetcher = RemoteFetcher::with_cache_dir(Duration::from_secs(10), cache_dir);\\n        ExtendsResolver::with_fetcher(fetcher)\\n    }\\n\\n    #[test]\\n    fn load_merged_config_resolves_extends() {\\n        let server = MockServer::start();\\n\\n        let base_yaml = r#\\\"\\nsteps:\\n  lint:\\n    command: eslint .\\n    title: Lint code\\n\\\"#;\\n\\n        server.mock(|when, then| {\\n            when.method(GET).path(\\\"/base.yml\\\");\\n            then.status(200).body(base_yaml);\\n        });\\n\\n        let temp = TempDir::new().unwrap();\\n        let bivvy_dir = temp.path().join(\\\".bivvy\\\");\\n        fs::create_dir_all(&bivvy_dir).unwrap();\\n        fs::write(\\n            bivvy_dir.join(\\\"config.yml\\\"),\\n            format!(\\n                r#\\\"\\nextends:\\n  - url: {}\\napp_name: MyApp\\nsteps:\\n  test:\\n    command: jest\\n\\\"#,\\n                server.url(\\\"/base.yml\\\")\\n            ),\\n        )\\n        .unwrap();\\n\\n        let resolver = resolver_for_mock(&server);\\n        let config = load_merged_config_with_resolver(temp.path(), &resolver).unwrap();\\n\\n        // Local app_name is preserved\\n        assert_eq!(config.app_name, Some(\\\"MyApp\\\".to_string()));\\n        // Base step is merged in\\n        assert!(config.steps.contains_key(\\\"lint\\\"));\\n        assert_eq!(config.steps[\\\"lint\\\"].command, Some(\\\"eslint .\\\".to_string()));\\n        // Local step is preserved\\n        assert!(config.steps.contains_key(\\\"test\\\"));\\n        // Extends is cleared\\n        assert!(config.extends.is_none());\\n    }\\n\\n    #[test]\\n    fn extends_merges_before_local_override() {\\n        let server = MockServer::start();\\n\\n        let base_yaml = r#\\\"\\napp_name: BaseApp\\nsettings:\\n  default_output: quiet\\nsteps:\\n  install:\\n    command: npm install\\n    title: Base install\\n\\\"#;\\n\\n        server.mock(|when, then| {\\n            when.method(GET).path(\\\"/base.yml\\\");\\n            then.status(200).body(base_yaml);\\n        });\\n\\n        let temp = TempDir::new().unwrap();\\n        let bivvy_dir = temp.path().join(\\\".bivvy\\\");\\n        fs::create_dir_all(&bivvy_dir).unwrap();\\n\\n        // Project config extends base and overrides install command\\n        fs::write(\\n            bivvy_dir.join(\\\"config.yml\\\"),\\n            format!(\\n                r#\\\"\\nextends:\\n  - url: {}\\napp_name: MyApp\\nsteps:\\n  install:\\n    command: yarn install\\n\\\"#,\\n                server.url(\\\"/base.yml\\\")\\n            ),\\n        )\\n        .unwrap();\\n\\n        let resolver = resolver_for_mock(&server);\\n        let config = load_merged_config_with_resolver(temp.path(), &resolver).unwrap();\\n\\n        // Local overrides base\\n        assert_eq!(config.app_name, Some(\\\"MyApp\\\".to_string()));\\n        assert_eq!(\\n            config.steps[\\\"install\\\"].command,\\n            Some(\\\"yarn install\\\".to_string())\\n        );\\n    }\\n\\n    #[test]\\n    fn extends_with_local_override_file() {\\n        let server = MockServer::start();\\n\\n        let base_yaml = r#\\\"\\napp_name: BaseApp\\nsteps:\\n  install:\\n    command: npm install\\n\\\"#;\\n\\n        server.mock(|when, then| {\\n            when.method(GET).path(\\\"/base.yml\\\");\\n            then.status(200).body(base_yaml);\\n        });\\n\\n        let temp = TempDir::new().unwrap();\\n        let bivvy_dir = temp.path().join(\\\".bivvy\\\");\\n        fs::create_dir_all(&bivvy_dir).unwrap();\\n\\n        // Project config extends base\\n        fs::write(\\n            bivvy_dir.join(\\\"config.yml\\\"),\\n            format!(\\n                r#\\\"\\nextends:\\n  - url: {}\\napp_name: ProjectApp\\n\\\"#,\\n                server.url(\\\"/base.yml\\\")\\n            ),\\n        )\\n        .unwrap();\\n\\n        // Local override file overrides app_name\\n        fs::write(\\n            bivvy_dir.join(\\\"config.local.yml\\\"),\\n            \\\"app_name: LocalOverride\\\\n\\\",\\n        )\\n        .unwrap();\\n\\n        let resolver = resolver_for_mock(&server);\\n        let config = load_merged_config_with_resolver(temp.path(), &resolver).unwrap();\\n\\n        // The extends resolution happens on the merged config,\\n        // so local override takes effect before extends\\n        // But since extends is in config.yml and local overrides app_name,\\n        // the merged config will have app_name=LocalOverride + extends from config.yml\\n        assert_eq!(config.app_name, Some(\\\"LocalOverride\\\".to_string()));\\n        // Base step should be present (extends still works)\\n        assert!(config.steps.contains_key(\\\"install\\\"));\\n    }\\n\\n    #[test]\\n    fn config_without_extends_still_works() {\\n        let temp = TempDir::new().unwrap();\\n        let bivvy_dir = temp.path().join(\\\".bivvy\\\");\\n        fs::create_dir_all(&bivvy_dir).unwrap();\\n        fs::write(bivvy_dir.join(\\\"config.yml\\\"), \\\"app_name: NoExtends\\\").unwrap();\\n\\n        // Using default resolver \u2014 won't make any HTTP calls\\n        let config = load_merged_config(temp.path()).unwrap();\\n        assert_eq!(config.app_name, Some(\\\"NoExtends\\\".to_string()));\\n    }\\n}\\n\",\"numLines\":705,\"startLine\":1,\"totalLines\":705}}}\n{\"type\":\"assistant\",\"message\":{\"model\":\"claude-opus-4-6\",\"id\":\"msg_01K26y7kt4hBVJSoNdFBDnDt\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"thinking\",\"thinking\":\"Now let me look at the CLI commands to see how they handle config loading errors - specifically to find where the silent fallback to defaults happens.\",\"signature\":\"\"}],\"stop_reason\":null,\"stop_sequence\":null,\"usage\":{\"input_tokens\":2293,\"cache_creation_input_tokens\":9060,\"cache_read_input_tokens\":24735,\"cache_creation\":{\"ephemeral_5m_input_tokens\":9060,\"ephemeral_1h_input_tokens\":0},\"output_tokens\":9,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"71626d50-8e30-42b0-86de-6cafbf80e23f\",\"uuid\":\"54edd7c2-9136-494f-8fa9-3064515054b2\"}\n{\"type\":\"assistant\",\"message\":{\"model\":\"claude-opus-4-6\",\"id\":\"msg_01K26y7kt4hBVJSoNdFBDnDt\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"Now let me look at the CLI commands to find the silent fallback behavior.\"}],\"stop_reason\":null,\"stop_sequence\":null,\"usage\":{\"input_tokens\":2293,\"cache_creation_input_tokens\":9060,\"cache_read_input_tokens\":24735,\"cache_creation\":{\"ephemeral_5m_input_tokens\":9060,\"ephemeral_1h_input_tokens\":0},\"output_tokens\":9,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"71626d50-8e30-42b0-86de-6cafbf80e23f\",\"uuid\":\"440b73aa-f911-42a2-923d-d1f3d91ade5a\"}\n{\"type\":\"assistant\",\"message\":{\"model\":\"c