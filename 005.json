`anyhow::Error` (via `BivvyError::Other`) for unexpected errors\\n    10\u2192//! - All errors should provide actionable messages for users\\n    11\u2192\\n    12\u2192use std::path::PathBuf;\\n    13\u2192use thiserror::Error;\\n    14\u2192\\n    15\u2192/// Core error type for Bivvy operations.\\n    16\u2192#[derive(Debug, Error)]\\n    17\u2192pub enum BivvyError {\\n    18\u2192    /// Configuration file not found at expected location.\\n    19\u2192    #[error(\\\"Configuration not found: {path}\\\")]\\n    20\u2192    ConfigNotFound { path: PathBuf },\\n    21\u2192\\n    22\u2192    /// Failed to parse configuration file.\\n    23\u2192    #[error(\\\"Failed to parse config at {path}: {message}\\\")]\\n    24\u2192    ConfigParseError { path: PathBuf, message: String },\\n    25\u2192\\n    26\u2192    /// Invalid configuration structure or values.\\n    27\u2192    #[error(\\\"Invalid configuration: {message}\\\")]\\n    28\u2192    ConfigValidationError { message: String },\\n    29\u2192\\n    30\u2192    /// Referenced template does not exist.\\n    31\u2192    #[error(\\\"Unknown template: {name}\\\")]\\n    32\u2192    UnknownTemplate { name: String },\\n    33\u2192\\n    34\u2192    /// Step dependency cycle detected.\\n    35\u2192    #[error(\\\"Circular dependency detected: {cycle}\\\")]\\n    36\u2192    CircularDependency { cycle: String },\\n    37\u2192\\n    38\u2192    /// Step execution failed.\\n    39\u2192    #[error(\\\"Step '{step}' failed: {message}\\\")]\\n    40\u2192    StepExecutionError { step: String, message: String },\\n    41\u2192\\n    42\u2192    /// Shell command failed.\\n    43\u2192    #[error(\\\"Command failed with exit code {code:?}: {command}\\\")]\\n    44\u2192    CommandFailed { command: String, code: Option<i32> },\\n    45\u2192\\n    46\u2192    /// A required tool or service is missing and cannot be auto-installed.\\n    47\u2192    #[error(\\\"Missing requirement '{requirement}': {message}\\\")]\\n    48\u2192    RequirementMissing {\\n    49\u2192        requirement: String,\\n    50\u2192        message: String,\\n    51\u2192    },\\n    52\u2192\\n    53\u2192    /// A requirement check failed unexpectedly (e.g., network error during install).\\n    54\u2192    #[error(\\\"Requirement check failed for '{requirement}': {message}\\\")]\\n    55\u2192    RequirementCheckFailed {\\n    56\u2192        requirement: String,\\n    57\u2192        message: String,\\n    58\u2192    },\\n    59\u2192\\n    60\u2192    /// Shell operation failed (e.g., spawning a debug shell).\\n    61\u2192    #[error(\\\"Shell error: {message}\\\")]\\n    62\u2192    ShellError { message: String },\\n    63\u2192\\n    64\u2192    /// IO error wrapper.\\n    65\u2192    #[error(\\\"IO error: {0}\\\")]\\n    66\u2192    Io(#[from] std::io::Error),\\n    67\u2192\\n    68\u2192    /// Generic wrapped error for anyhow interop.\\n    69\u2192    #[error(transparent)]\\n    70\u2192    Other(#[from] anyhow::Error),\\n    71\u2192}\\n    72\u2192\\n    73\u2192/// Result type alias for Bivvy operations.\\n    74\u2192pub type Result<T> = std::result::Result<T, BivvyError>;\\n    75\u2192\\n    76\u2192#[cfg(test)]\\n    77\u2192mod tests {\\n    78\u2192    use super::*;\\n    79\u2192\\n    80\u2192    #[test]\\n    81\u2192    fn config_not_found_displays_path() {\\n    82\u2192        let err = BivvyError::ConfigNotFound {\\n    83\u2192            path: PathBuf::from(\\\"/foo/bar.yml\\\"),\\n    84\u2192        };\\n    85\u2192        assert!(err.to_string().contains(\\\"/foo/bar.yml\\\"));\\n    86\u2192    }\\n    87\u2192\\n    88\u2192    #[test]\\n    89\u2192    fn config_parse_error_displays_path_and_message() {\\n    90\u2192        let err = BivvyError::ConfigParseError {\\n    91\u2192            path: PathBuf::from(\\\"/config.yml\\\"),\\n    92\u2192            message: \\\"invalid syntax\\\".into(),\\n    93\u2192        };\\n    94\u2192        let msg = err.to_string();\\n    95\u2192        assert!(msg.contains(\\\"/config.yml\\\"));\\n    96\u2192        assert!(msg.contains(\\\"invalid syntax\\\"));\\n    97\u2192    }\\n    98\u2192\\n    99\u2192    #[test]\\n   100\u2192    fn config_validation_error_displays_message() {\\n   101\u2192        let err = BivvyError::ConfigValidationError {\\n   102\u2192            message: \\\"missing required field\\\".into(),\\n   103\u2192        };\\n   104\u2192        assert!(err.to_string().contains(\\\"missing required field\\\"));\\n   105\u2192    }\\n   106\u2192\\n   107\u2192    #[test]\\n   108\u2192    fn unknown_template_displays_name() {\\n   109\u2192        let err = BivvyError::UnknownTemplate {\\n   110\u2192            name: \\\"nonexistent\\\".into(),\\n   111\u2192        };\\n   112\u2192        assert!(err.to_string().contains(\\\"nonexistent\\\"));\\n   113\u2192    }\\n   114\u2192\\n   115\u2192    #[test]\\n   116\u2192    fn circular_dependency_displays_cycle() {\\n   117\u2192        let err = BivvyError::CircularDependency {\\n   118\u2192            cycle: \\\"a \u2192 b \u2192 a\\\".into(),\\n   119\u2192        };\\n   120\u2192        assert!(err.to_string().contains(\\\"a \u2192 b \u2192 a\\\"));\\n   121\u2192    }\\n   122\u2192\\n   123\u2192    #[test]\\n   124\u2192    fn step_execution_error_displays_step_and_message() {\\n   125\u2192        let err = BivvyError::StepExecutionError {\\n   126\u2192            step: \\\"install_deps\\\".into(),\\n   127\u2192            message: \\\"npm not found\\\".into(),\\n   128\u2192        };\\n   129\u2192        let msg = err.to_string();\\n   130\u2192        assert!(msg.contains(\\\"install_deps\\\"));\\n   131\u2192        assert!(msg.contains(\\\"npm not found\\\"));\\n   132\u2192    }\\n   133\u2192\\n   134\u2192    #[test]\\n   135\u2192    fn command_failed_displays_command_and_code() {\\n   136\u2192        let err = BivvyError::CommandFailed {\\n   137\u2192            command: \\\"npm install\\\".into(),\\n   138\u2192            code: Some(1),\\n   139\u2192        };\\n   140\u2192        let msg = err.to_string();\\n   141\u2192        assert!(msg.contains(\\\"npm install\\\"));\\n   142\u2192        assert!(msg.contains(\\\"1\\\"));\\n   143\u2192    }\\n   144\u2192\\n   145\u2192    #[test]\\n   146\u2192    fn requirement_missing_displays_requirement_and_message() {\\n   147\u2192        let err = BivvyError::RequirementMissing {\\n   148\u2192            requirement: \\\"ruby\\\".into(),\\n   149\u2192            message: \\\"Not found on PATH\\\".into(),\\n   150\u2192        };\\n   151\u2192        let msg = err.to_string();\\n   152\u2192        assert!(msg.contains(\\\"ruby\\\"));\\n   153\u2192        assert!(msg.contains(\\\"Not found on PATH\\\"));\\n   154\u2192    }\\n   155\u2192\\n   156\u2192    #[test]\\n   157\u2192    fn requirement_check_failed_displays_requirement_and_message() {\\n   158\u2192        let err = BivvyError::RequirementCheckFailed {\\n   159\u2192            requirement: \\\"node\\\".into(),\\n   160\u2192            message: \\\"Install command exited with code 1\\\".into(),\\n   161\u2192        };\\n   162\u2192        let msg = err.to_string();\\n   163\u2192        assert!(msg.contains(\\\"node\\\"));\\n   164\u2192        assert!(msg.contains(\\\"Install command exited with code 1\\\"));\\n   165\u2192    }\\n   166\u2192\\n   167\u2192    #[test]\\n   168\u2192    fn io_error_converts_from_std() {\\n   169\u2192        let io_err = std::io::Error::new(std::io::ErrorKind::NotFound, \\\"file missing\\\");\\n   170\u2192        let err: BivvyError = io_err.into();\\n   171\u2192        assert!(matches!(err, BivvyError::Io(_)));\\n   172\u2192    }\\n   173\u2192\\n   174\u2192    #[test]\\n   175\u2192    fn result_type_alias_works() {\\n   176\u2192        fn returns_error() -> Result<()> {\\n   177\u2192            Err(BivvyError::ConfigValidationError {\\n   178\u2192                message: \\\"test\\\".into(),\\n   179\u2192            })\\n   180\u2192        }\\n   181\u2192        assert!(returns_error().is_err());\\n   182\u2192    }\\n   183\u2192}\\n   184\u2192\"}]},\"parent_tool_use_id\":\"toolu_01MGJbeQUiXKwiNzj6iBEcHL\",\"session_id\":\"71626d50-8e30-42b0-86de-6cafbf80e23f\",\"uuid\":\"391a5fd0-2d0c-4975-8c42-84f296fa1f2f\"}\n{\"type\":\"assistant\",\"message\":{\"model\":\"claude-haiku-4-5-20251001\",\"id\":\"msg_01PyUKJGeAHNYrrZh5TDRdFt\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01WoRGtidQq2eaHsPcdMwibB\",\"name\":\"Read\",\"input\":{\"file_path\":\"/private/var/folders/_q/qzh8_t6s15388qqf3p6n3d200000gp/T/bench-7okzbcvu/src/config/merger.rs\"},\"caller\":{\"type\":\"direct\"}}],\"stop_reason\":null,\"stop_sequence\":null,\"usage\":{\"input_tokens\":7,\"cache_creation_input_tokens\":2716,\"cache_read_input_tokens\":32894,\"cache_creation\":{\"ephemeral_5m_input_tokens\":2716,\"ephemeral_1h_input_tokens\":0},\"output_tokens\":1,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"context_management\":null},\"parent_tool_use_id\":\"toolu_01MGJbeQUiXKwiNzj6iBEcHL\",\"session_id\":\"71626d50-8e30-42b0-86de-6cafbf80e23f\",\"uuid\":\"d3e2582b-fc25-4dca-8773-85a2ea2bdd3c\"}\n{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01WoRGtidQq2eaHsPcdMwibB\",\"type\":\"tool_result\",\"content\":\"     1\u2192//! Deep merge algorithm for YAML configuration values.\\n     2\u2192//!\\n     3\u2192//! Bivvy supports configuration layering where later configs override\\n     4\u2192//! earlier ones. This module implements the merge semantics.\\n     5\u2192//!\\n     6\u2192//! # Merge Rules\\n     7\u2192//!\\n     8\u2192//! - Objects are merged recursively\\n     9\u2192//! - Arrays are replaced entirely (not merged)\\n    10\u2192//! - Null values in overlay delete the corresponding key from base\\n    11\u2192//! - Scalars in overlay replace scalars in base\\n    12\u2192\\n    13\u2192use std::collections::HashSet;\\n    14\u2192\\n    15\u2192use serde_yaml::Value;\\n    16\u2192\\n    17\u2192/// Deep merge two YAML values.\\n    18\u2192///\\n    19\u2192/// Later values override earlier values at the point of conflict.\\n    20\u2192/// Objects are merged recursively. Arrays are replaced entirely.\\n    21\u2192/// Null values in overlay delete the corresponding key from base.\\n    22\u2192///\\n    23\u2192/// # Arguments\\n    24\u2192///\\n    25\u2192/// * `base` - The base configuration\\n    26\u2192/// * `overlay` - The overlay configuration (takes precedence)\\n    27\u2192///\\n    28\u2192/// # Returns\\n    29\u2192///\\n    30\u2192/// A new Value with merged contents\\n    31\u2192pub fn deep_merge(base: &Value, overlay: &Value) -> Value {\\n    32\u2192    deep_merge_with_leaves(base, overlay, &HashSet::new())\\n    33\u2192}\\n    34\u2192\\n    35\u2192/// Deep merge two YAML values with leaf-key awareness.\\n    36\u2192///\\n    37\u2192/// Like `deep_merge`, but keys in `leaf_keys` get special treatment:\\n    38\u2192/// the MAP at that key is merged (entries added/replaced), but each\\n    39\u2192/// entry's VALUE replaces entirely instead of recursing. This is used\\n    40\u2192/// for `environments` blocks where each environment override should\\n    41\u2192/// replace as a whole rather than being field-merged with the base.\\n    42\u2192///\\n    43\u2192/// Null values at the leaf level delete the corresponding entry.\\n    44\u2192///\\n    45\u2192/// # Arguments\\n    46\u2192///\\n    47\u2192/// * `base` - The base configuration\\n    48\u2192/// * `overlay` - The overlay configuration (takes precedence)\\n    49\u2192/// * `leaf_keys` - Keys whose children should replace rather than merge\\n    50\u2192pub fn deep_merge_with_leaves(base: &Value, overlay: &Value, leaf_keys: &HashSet<&str>) -> Value {\\n    51\u2192    match (base, overlay) {\\n    52\u2192        // Both are mappings: merge recursively\\n    53\u2192        (Value::Mapping(base_map), Value::Mapping(overlay_map)) => {\\n    54\u2192            let mut result = base_map.clone();\\n    55\u2192\\n    56\u2192            for (key, overlay_value) in overlay_map {\\n    57\u2192                if overlay_value.is_null() {\\n    58\u2192                    // Null in overlay = delete from result\\n    59\u2192                    result.remove(key);\\n    60\u2192                } else if leaf_keys.contains(key.as_str().unwrap_or(\\\"\\\")) {\\n    61\u2192                    // Leaf key: merge the MAP (add/replace entries) but\\n    62\u2192                    // each entry's VALUE replaces entirely\\n    63\u2192                    if let (Some(base_inner), Value::Mapping(overlay_inner)) =\\n    64\u2192                        (result.get(key).and_then(|v| v.as_mapping()), overlay_value)\\n    65\u2192                    {\\n    66\u2192                        let mut merged_inner = base_inner.clone();\\n    67\u2192                        for (inner_key, inner_value) in overlay_inner {\\n    68\u2192                            if inner_value.is_null() {\\n    69\u2192                                merged_inner.remove(inner_key);\\n    70\u2192                            } else {\\n    71\u2192                                merged_inner.insert(inner_key.clone(), inner_value.clone());\\n    72\u2192                            }\\n    73\u2192                        }\\n    74\u2192                        result.insert(key.clone(), Value::Mapping(merged_inner));\\n    75\u2192                    } else {\\n    76\u2192                        result.insert(key.clone(), overlay_value.clone());\\n    77\u2192                    }\\n    78\u2192                } else if let Some(base_value) = base_map.get(key) {\\n    79\u2192                    // Key exists in both: recurse\\n    80\u2192                    result.insert(\\n    81\u2192                        key.clone(),\\n    82\u2192                        deep_merge_with_leaves(base_value, overlay_value, leaf_keys),\\n    83\u2192                    );\\n    84\u2192                } else {\\n    85\u2192                    // Key only in overlay: insert\\n    86\u2192                    result.insert(key.clone(), overlay_value.clone());\\n    87\u2192                }\\n    88\u2192            }\\n    89\u2192\\n    90\u2192            Value::Mapping(result)\\n    91\u2192        }\\n    92\u2192\\n    93\u2192        // Overlay is not a mapping, or base is not a mapping: overlay wins\\n    94\u2192        (_, overlay) => overlay.clone(),\\n    95\u2192    }\\n    96\u2192}\\n    97\u2192\\n    98\u2192/// Merge multiple configs in order (later overrides earlier).\\n    99\u2192///\\n   100\u2192/// # Arguments\\n   101\u2192///\\n   102\u2192/// * `configs` - Slice of configs in merge order (first is base, last has highest priority)\\n   103\u2192///\\n   104\u2192/// # Returns\\n   105\u2192///\\n   106\u2192/// A single merged Value\\n   107\u2192pub fn merge_configs(configs: &[Value]) -> Value {\\n   108\u2192    let leaf_keys = HashSet::from([\\\"environments\\\"]);\\n   109\u2192    configs\\n   110\u2192        .iter()\\n   111\u2192        .fold(Value::Mapping(Default::default()), |acc, config| {\\n   112\u2192            deep_merge_with_leaves(&acc, config, &leaf_keys)\\n   113\u2192        })\\n   114\u2192}\\n   115\u2192\\n   116\u2192#[cfg(test)]\\n   117\u2192mod tests {\\n   118\u2192    use super::*;\\n   119\u2192\\n   120\u2192    fn yaml(s: &str) -> Value {\\n   121\u2192        serde_yaml::from_str(s).unwrap()\\n   122\u2192    }\\n   123\u2192\\n   124\u2192    #[test]\\n   125\u2192    fn deep_merge_replaces_at_conflict_point() {\\n   126\u2192        let base = yaml(\\n   127\u2192            r#\\\"\\n   128\u2192steps:\\n   129\u2192  database:\\n   130\u2192    command: \\\"rails db:setup\\\"\\n   131\u2192    watches:\\n   132\u2192      - schema.rb\\n   133\u2192\\\"#,\\n   134\u2192        );\\n   135\u2192        let overlay = yaml(\\n   136\u2192            r#\\\"\\n   137\u2192steps:\\n   138\u2192  database:\\n   139\u2192    command: \\\"rails db:prepare\\\"\\n   140\u2192\\\"#,\\n   141\u2192        );\\n   142\u2192\\n   143\u2192        let result = deep_merge(&base, &overlay);\\n   144\u2192\\n   145\u2192        assert_eq!(result[\\\"steps\\\"][\\\"database\\\"][\\\"command\\\"], \\\"rails db:prepare\\\");\\n   146\u2192        // watches should be preserved\\n   147\u2192        assert_eq!(result[\\\"steps\\\"][\\\"database\\\"][\\\"watches\\\"][0], \\\"schema.rb\\\");\\n   148\u2192    }\\n   149\u2192\\n   150\u2192    #[test]\\n   151\u2192    fn arrays_are_replaced_not_merged() {\\n   152\u2192        let base = yaml(\\n   153\u2192            r#\\\"\\n   154\u2192watches:\\n   155\u2192  - a.rb\\n   156\u2192  - b.rb\\n   157\u2192\\\"#,\\n   158\u2192        );\\n   159\u2192        let overlay = yaml(\\n   160\u2192            r#\\\"\\n   161\u2192watches:\\n   162\u2192  - c.rb\\n   163\u2192\\\"#,\\n   164\u2192        );\\n   165\u2192\\n   166\u2192        let result = deep_merge(&base, &overlay);\\n   167\u2192        let watches = result[\\\"watches\\\"].as_sequence().unwrap();\\n   168\u2192\\n   169\u2192        assert_eq!(watches.len(), 1);\\n   170\u2192        assert_eq!(watches[0], \\\"c.rb\\\");\\n   171\u2192    }\\n   172\u2192\\n   173\u2192    #[test]\\n   174\u2192    fn null_removes_inherited_value() {\\n   175\u2192        let base = yaml(\\n   176\u2192            r#\\\"\\n   177\u2192env:\\n   178\u2192  DEBUG: \\\"true\\\"\\n   179\u2192  LOG: verbose\\n   180\u2192\\\"#,\\n   181\u2192        );\\n   182\u2192        let overlay = yaml(\\n   183\u2192            r#\\\"\\n   184\u2192env:\\n   185\u2192  DEBUG: null\\n   186\u2192\\\"#,\\n   187\u2192        );\\n   188\u2192\\n   189\u2192        let result = deep_merge(&base, &overlay);\\n   190\u2192\\n   191\u2192        assert!(result[\\\"env\\\"].get(\\\"DEBUG\\\").is_none());\\n   192\u2192        assert_eq!(result[\\\"env\\\"][\\\"LOG\\\"], \\\"verbose\\\");\\n   193\u2192    }\\n   194\u2192\\n   195\u2192    #[test]\\n   196\u2192    fn nested_objects_merge_recursively() {\\n   197\u2192        let base = yaml(\\n   198\u2192            r#\\\"\\n   199\u2192settings:\\n   200\u2192  output: verbose\\n   201\u2192  logging: true\\n   202\u2192\\\"#,\\n   203\u2192        );\\n   204\u2192        let overlay = yaml(\\n   205\u2192            r#\\\"\\n   206\u2192settings:\\n   207\u2192  output: quiet\\n   208\u2192\\\"#,\\n   209\u2192        );\\n   210\u2192\\n   211\u2192        let result = deep_merge(&base, &overlay);\\n   212\u2192\\n   213\u2192        assert_eq!(result[\\\"settings\\\"][\\\"output\\\"], \\\"quiet\\\");\\n   214\u2192        assert_eq!(result[\\\"settings\\\"][\\\"logging\\\"], true);\\n   215\u2192    }\\n   216\u2192\\n   217\u2192    #[test]\\n   218\u2192    fn empty_overlay_returns_base_unchanged() {\\n   219\u2192        let base = yaml(\\n   220\u2192            r#\\\"\\n   221\u2192app_name: Test\\n   222\u2192settings:\\n   223\u2192  output: verbose\\n   224\u2192\\\"#,\\n   225\u2192        );\\n   226\u2192        // Empty YAML file parses to Null, which we want to treat as \\\"no changes\\\"\\n   227\u2192        // So use an empty mapping instead\\n   228\u2192        let overlay = yaml(\\\"{}\\\");\\n   229\u2192\\n   230\u2192        let result = deep_merge(&base, &overlay);\\n   231\u2192\\n   232\u2192        assert_eq!(result[\\\"app_name\\\"], \\\"Test\\\");\\n   233\u2192        assert_eq!(result[\\\"settings\\\"][\\\"output\\\"], \\\"verbose\\\");\\n   234\u2192    }\\n   235\u2192\\n   236\u2192    #[test]\\n   237\u2192    fn merge_configs_merges_multiple_in_order() {\\n   238\u2192        let configs = vec![yaml(\\\"a: 1\\\\nb: 2\\\"), yaml(\\\"b: 3\\\\nc: 4\\\"), yaml(\\\"c: 5\\\")];\\n   239\u2192\\n   240\u2192        let result = merge_configs(&configs);\\n   241\u2192\\n   242\u2192        assert_eq!(result[\\\"a\\\"], 1);\\n   243\u2192        assert_eq!(result[\\\"b\\\"], 3);\\n   244\u2192        assert_eq!(result[\\\"c\\\"], 5);\\n   245\u2192    }\\n   246\u2192\\n   247\u2192    #[test]\\n   248\u2192    fn scalar_overlay_replaces_mapping_base() {\\n   249\u2192        let base = yaml(\\n   250\u2192            r#\\\"\\n   251\u2192settings:\\n   252\u2192  output: verbose\\n   253\u2192\\\"#,\\n   254\u2192        );\\n   255\u2192        let overlay = yaml(\\n   256\u2192            r#\\\"\\n   257\u2192settings: disabled\\n   258\u2192\\\"#,\\n   259\u2192        );\\n   260\u2192\\n   261\u2192        let result = deep_merge(&base, &overlay);\\n   262\u2192        assert_eq!(result[\\\"settings\\\"], \\\"disabled\\\");\\n   263\u2192    }\\n   264\u2192\\n   265\u2192    #[test]\\n   266\u2192    fn deeply_nested_merge() {\\n   267\u2192        let base = yaml(\\n   268\u2192            r#\\\"\\n   269\u2192a:\\n   270\u2192  b:\\n   271\u2192    c:\\n   272\u2192      d: 1\\n   273\u2192      e: 2\\n   274\u2192\\\"#,\\n   275\u2192        );\\n   276\u2192        let overlay = yaml(\\n   277\u2192            r#\\\"\\n   278\u2192a:\\n   279\u2192  b:\\n   280\u2192    c:\\n   281\u2192      d: 10\\n   282\u2192\\\"#,\\n   283\u2192        );\\n   284\u2192\\n   285\u2192        let result = deep_merge(&base, &overlay);\\n   286\u2192        assert_eq!(result[\\\"a\\\"][\\\"b\\\"][\\\"c\\\"][\\\"d\\\"], 10);\\n   287\u2192        assert_eq!(result[\\\"a\\\"][\\\"b\\\"][\\\"c\\\"][\\\"e\\\"], 2);\\n   288\u2192    }\\n   289\u2192\\n   290\u2192    #[test]\\n   291\u2192    fn merge_empty_configs_returns_empty() {\\n   292\u2192        let result = merge_configs(&[]);\\n   293\u2192        assert!(result.as_mapping().unwrap().is_empty());\\n   294\u2192    }\\n   295\u2192\\n   296\u2192    #[test]\\n   297\u2192    fn leaf_key_replaces_entry_values() {\\n   298\u2192        let leaf_keys: HashSet<&str> = [\\\"environments\\\"].iter().copied().collect();\\n   299\u2192\\n   300\u2192        let base = yaml(\\n   301\u2192            r#\\\"\\n   302\u2192steps:\\n   303\u2192  db:\\n   304\u2192    environments:\\n   305\u2192      ci:\\n   306\u2192        command: \\\"pg_isready\\\"\\n   307\u2192        env:\\n   308\u2192          A: \\\"1\\\"\\n   309\u2192\\\"#,\\n   310\u2192        );\\n   311\u2192        let overlay = yaml(\\n   312\u2192            r#\\\"\\n   313\u2192steps:\\n   314\u2192  db:\\n   315\u2192    environments:\\n   316\u2192      ci:\\n   317\u2192        env:\\n   318\u2192          FOO: \\\"1\\\"\\n   319\u2192\\\"#,\\n   320\u2192        );\\n   321\u2192\\n   322\u2192        let result = deep_merge_with_leaves(&base, &overlay, &leaf_keys);\\n   323\u2192\\n   324\u2192        // Overlay's ci block replaces base's entirely\\n   325\u2192        assert!(result[\\\"steps\\\"][\\\"db\\\"][\\\"environments\\\"][\\\"ci\\\"][\\\"env\\\"][\\\"FOO\\\"] == \\\"1\\\");\\n   326\u2192        // Base's command should be gone (replaced, not merged)\\n   327\u2192        assert!(result[\\\"steps\\\"][\\\"db\\\"][\\\"environments\\\"][\\\"ci\\\"]\\n   328\u2192            .get(\\\"command\\\")\\n   329\u2192            .is_none());\\n   330\u2192        // Base's env.A should be gone\\n   331\u2192        assert!(result[\\\"steps\\\"][\\\"db\\\"][\\\"environments\\\"][\\\"ci\\\"][\\\"env\\\"]\\n   332\u2192            .get(\\\"A\\\")\\n   333\u2192            .is_none());\\n   334\u2192    }\\n   335\u2192\\n   336\u2192    #[test]\\n   337\u2192    fn leaf_key_adds_new_entries() {\\n   338\u2192        let leaf_keys: HashSet<&str> = [\\\"environments\\\"].iter().copied().collect();\\n   339\u2192\\n   340\u2192        let base = yaml(\\n   341\u2192            r#\\\"\\n   342\u2192environments:\\n   343\u2192  ci:\\n   344\u2192    command: \\\"ci-cmd\\\"\\n   345\u2192\\\"#,\\n   346\u2192        );\\n   347\u2192        let overlay = yaml(\\n   348\u2192            r#\\\"\\n   349\u2192environments:\\n   350\u2192  staging:\\n   351\u2192    command: \\\"staging-cmd\\\"\\n   352\u2192\\\"#,\\n   353\u2192        );\\n   354\u2192\\n   355\u2192        let result = deep_merge_with_leaves(&base, &overlay, &leaf_keys);\\n   356\u2192\\n   357\u2192        // ci preserved\\n   358\u2192        assert_eq!(result[\\\"environments\\\"][\\\"ci\\\"][\\\"command\\\"], \\\"ci-cmd\\\");\\n   359\u2192        // staging added\\n   360\u2192        assert_eq!(result[\\\"environments\\\"][\\\"staging\\\"][\\\"command\\\"], \\\"staging-cmd\\\");\\n   361\u2192    }\\n   362\u2192\\n   363\u2192    #[test]\\n   364\u2192    fn leaf_key_null_removes_entry() {\\n   365\u2192        let leaf_keys: HashSet<&str> = [\\\"environments\\\"].iter().copied().collect();\\n   366\u2192\\n   367\u2192        let base = yaml(\\n   368\u2192            r#\\\"\\n   369\u2192environments:\\n   370\u2192  ci:\\n   371\u2192    command: \\\"ci-cmd\\\"\\n   372\u2192  staging:\\n   373\u2192    command: \\\"staging-cmd\\\"\\n   374\u2192\\\"#,\\n   375\u2192        );\\n   376\u2192        let overlay = yaml(\\n   377\u2192            r#\\\"\\n   378\u2192environments:\\n   379\u2192  ci: null\\n   380\u2192\\\"#,\\n   381\u2192        );\\n   382\u2192\\n   383\u2192        let result = deep_merge_with_leaves(&base, &overlay, &leaf_keys);\\n   384\u2192\\n   385\u2192        // ci removed\\n   386\u2192        assert!(result[\\\"environments\\\"].get(\\\"ci\\\").is_none());\\n   387\u2192        // staging preserved\\n   388\u2192        assert_eq!(result[\\\"environments\\\"][\\\"staging\\\"][\\\"command\\\"], \\\"staging-cmd\\\");\\n   389\u2192    }\\n   390\u2192\\n   391\u2192    #[test]\\n   392\u2192    fn leaf_key_preserves_unmentioned_entries() {\\n   393\u2192        let leaf_keys: HashSet<&str> = [\\\"environments\\\"].iter().copied().collect();\\n   394\u2192\\n   395\u2192        let base = yaml(\\n   396\u2192            r#\\\"\\n   397\u2192environments:\\n   398\u2192  ci:\\n   399\u2192    command: \\\"ci-cmd\\\"\\n   400\u2192  staging:\\n   401\u2192    command: \\\"staging-cmd\\\"\\n   402\u2192\\\"#,\\n   403\u2192        );\\n   404\u2192        let overlay = yaml(\\n   405\u2192            r#\\\"\\n   406\u2192environments:\\n   407\u2192  ci:\\n   408\u2192    command: \\\"new-ci-cmd\\\"\\n   409\u2192\\\"#,\\n   410\u2192        );\\n   411\u2192\\n   412\u2192        let result = deep_merge_with_leaves(&base, &overlay, &leaf_keys);\\n   413\u2192\\n   414\u2192        // ci replaced with overlay value\\n   415\u2192        assert_eq!(result[\\\"environments\\\"][\\\"ci\\\"][\\\"command\\\"], \\\"new-ci-cmd\\\");\\n   416\u2192        // staging untouched\\n   417\u2192        assert_eq!(result[\\\"environments\\\"][\\\"staging\\\"][\\\"command\\\"], \\\"staging-cmd\\\");\\n   418\u2192    }\\n   419\u2192\\n   420\u2192    #[test]\\n   421\u2192    fn deep_merge_without_leaves_behaves_as_before() {\\n   422\u2192        // Verify deep_merge (convenience wrapper) still works identically\\n   423\u2192        let base = yaml(\\n   424\u2192            r#\\\"\\n   425\u2192a:\\n   426\u2192  b:\\n   427\u2192    c: 1\\n   428\u2192    d: 2\\n   429\u2192\\\"#,\\n   430\u2192        );\\n   431\u2192        let overlay = yaml(\\n   432\u2192            r#\\\"\\n   433\u2192a:\\n   434\u2192  b:\\n   435\u2192    c: 10\\n   436\u2192\\\"#,\\n   437\u2192        );\\n   438\u2192\\n   439\u2192        let result = deep_merge(&base, &overlay);\\n   440\u2192        assert_eq!(result[\\\"a\\\"][\\\"b\\\"][\\\"c\\\"], 10);\\n   441\u2192        assert_eq!(result[\\\"a\\\"][\\\"b\\\"][\\\"d\\\"], 2);\\n   442\u2192    }\\n   443\u2192}\\n   444\u2192\"}]},\"parent_tool_use_id\":\"toolu_01MGJbeQUiXKwiNzj6iBEcHL\",\"session_id\":\"71626d50-8e30-42b0-86de-6cafbf80e23f\",\"uuid\":\"44d4b8ae-a6b7-4697-b32c-7f0993789033\"}\n{\"type\":\"assistant\",\"message\":{\"model\":\"claude-haiku-4-5-20251001\",\"id\":\"msg_01PyUKJGeAHNYrrZh5TDRdFt\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_016rakybxcB6fNvep1ZVGTxJ\",\"name\":\"Read\",\"input\":{\"file_path\":\"/private/var/folders/_q/qzh8_t6s15388qqf3p6n3d200000gp/T/bench-7okzbcvu/src/config/extends.rs\",\"limit\":150},\"caller\":{\"type\":\"direct\"}}],\"stop_reason\":null,\"stop_sequence\":null,\"usage\":{\"input_tokens\":7,\"cache_creation_input_tokens\":2716,\"cache_read_input_tokens\":32894,\"cache_creation\":{\"ephemeral_5m_input_tokens\":2716,\"ephemeral_1h_input_tokens\":0},\"output_tokens\":1,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"context_management\":null},\"parent_tool_use_id\":\"toolu_01MGJbeQUiXKwiNzj6iBEcHL\",\"session_id\":\"71626d50-8e30-42b0-86de-6cafbf80e23f\",\"uuid\":\"aa4e799c-70d6-4b16-9b9b-78b9322ccdac\"}\n{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_016rakybxcB6fNvep1ZVGTxJ\",\"type\":\"tool_result\",\"content\":\"     1\u2192//! Configuration inheritance resolution.\\n     2\u2192//!\\n     3\u2192//! This module handles the `extends:` configuration feature, which allows\\n     4\u2192//! configs to inherit from remote base configurations.\\n     5\u2192\\n     6\u2192use std::collections::HashSet;\\n     7\u2192use std::time::Duration;\\n     8\u2192\\n     9\u2192use anyhow::{anyhow, Result};\\n    10\u2192\\n    11\u2192use super::merger::deep_merge_with_leaves;\\n    12\u2192use super::remote::RemoteFetcher;\\n    13\u2192use super::schema::{BivvyConfig, ExtendsConfig};\\n    14\u2192\\n    15\u2192/// Resolves configuration inheritance chain.\\n    16\u2192///\\n    17\u2192/// # Example\\n    18\u2192///\\n    19\u2192/// ```no_run\\n    20\u2192/// use bivvy::config::{BivvyConfig, ExtendsResolver};\\n    21\u2192///\\n    22\u2192/// let resolver = ExtendsResolver::new();\\n    23\u2192///\\n    24\u2192/// // Resolve a config that extends a remote base\\n    25\u2192/// let config: BivvyConfig = serde_yaml::from_str(r#\\\"\\n    26\u2192/// extends:\\n    27\u2192///   - url: https://example.com/base-config.yml\\n    28\u2192/// app_name: MyApp\\n    29\u2192/// \\\"#).unwrap();\\n    30\u2192///\\n    31\u2192/// let resolved = resolver.resolve(&config).unwrap();\\n    32\u2192/// ```\\n    33\u2192pub struct ExtendsResolver {\\n    34\u2192    fetcher: RemoteFetcher,\\n    35\u2192    max_depth: usize,\\n    36\u2192}\\n    37\u2192\\n    38\u2192impl ExtendsResolver {\\n    39\u2192    /// Create a resolver with default settings.\\n    40\u2192    pub fn new() -> Self {\\n    41\u2192        Self {\\n    42\u2192            fetcher: RemoteFetcher::new(Duration::from_secs(30)),\\n    43\u2192            max_depth: 10,\\n    44\u2192        }\\n    45\u2192    }\\n    46\u2192\\n    47\u2192    /// Create a resolver with a custom fetcher.\\n    48\u2192    pub fn with_fetcher(fetcher: RemoteFetcher) -> Self {\\n    49\u2192        Self {\\n    50\u2192            fetcher,\\n    51\u2192            max_depth: 10,\\n    52\u2192        }\\n    53\u2192    }\\n    54\u2192\\n    55\u2192    /// Create a resolver with custom max depth.\\n    56\u2192    pub fn with_max_depth(max_depth: usize) -> Self {\\n    57\u2192        Self {\\n    58\u2192            fetcher: RemoteFetcher::default(),\\n    59\u2192            max_depth,\\n    60\u2192        }\\n    61\u2192    }\\n    62\u2192\\n    63\u2192    /// Resolve all extends references and merge configs.\\n    64\u2192    pub fn resolve(&self, config: &BivvyConfig) -> Result<BivvyConfig> {\\n    65\u2192        self.resolve_with_visited(config, &mut HashSet::new(), 0)\\n    66\u2192    }\\n    67\u2192\\n    68\u2192    fn resolve_with_visited(\\n    69\u2192        &self,\\n    70\u2192        config: &BivvyConfig,\\n    71\u2192        visited: &mut HashSet<String>,\\n    72\u2192        depth: usize,\\n    73\u2192    ) -> Result<BivvyConfig> {\\n    74\u2192        if depth > self.max_depth {\\n    75\u2192            return Err(anyhow!(\\n    76\u2192                \\\"Config extends depth exceeds maximum of {}\\\",\\n    77\u2192                self.max_depth\\n    78\u2192            ));\\n    79\u2192        }\\n    80\u2192\\n    81\u2192        // If no extends, return config as-is\\n    82\u2192        let extends = match &config.extends {\\n    83\u2192            Some(e) if !e.is_empty() => e,\\n    84\u2192            _ => return Ok(config.clone()),\\n    85\u2192        };\\n    86\u2192\\n    87\u2192        // Convert current config to Value for merging\\n    88\u2192        let config_value = serde_yaml::to_value(config)?;\\n    89\u2192\\n    90\u2192        // Environment override blocks should replace entirely, not field-merge\\n    91\u2192        let leaf_keys = std::collections::HashSet::from([\\\"environments\\\"]);\\n    92\u2192\\n    93\u2192        // Start with empty Value\\n    94\u2192        let mut merged = serde_yaml::Value::Mapping(serde_yaml::Mapping::new());\\n    95\u2192\\n    96\u2192        // Process each base config in order\\n    97\u2192        for ext in extends {\\n    98\u2192            // Check for cycles\\n    99\u2192            if visited.contains(&ext.url) {\\n   100\u2192                return Err(anyhow!(\\\"Circular extends detected: {}\\\", ext.url));\\n   101\u2192            }\\n   102\u2192            visited.insert(ext.url.clone());\\n   103\u2192\\n   104\u2192            // Fetch and parse base config\\n   105\u2192            let content = self.fetcher.fetch(&ext.url)?;\\n   106\u2192            let base_config: BivvyConfig = serde_yaml::from_str(&content)?;\\n   107\u2192\\n   108\u2192            // Recursively resolve base's extends\\n   109\u2192            let resolved_base = self.resolve_with_visited(&base_config, visited, depth + 1)?;\\n   110\u2192\\n   111\u2192            // Convert to Value and merge\\n   112\u2192            let base_value = serde_yaml::to_value(&resolved_base)?;\\n   113\u2192            merged = deep_merge_with_leaves(&merged, &base_value, &leaf_keys);\\n   114\u2192        }\\n   115\u2192\\n   116\u2192        // Finally merge the current config on top\\n   117\u2192        let final_value = deep_merge_with_leaves(&merged, &config_value, &leaf_keys);\\n   118\u2192\\n   119\u2192        // Deserialize back to BivvyConfig\\n   120\u2192        let mut final_config: BivvyConfig = serde_yaml::from_value(final_value)?;\\n   121\u2192\\n   122\u2192        // Clear extends from final config (already resolved)\\n   123\u2192        final_config.extends = None;\\n   124\u2192\\n   125\u2192        Ok(final_config)\\n   126\u2192    }\\n   127\u2192\\n   128\u2192    /// Get the maximum extends depth.\\n   129\u2192    pub fn max_depth(&self) -> usize {\\n   130\u2192        self.max_depth\\n   131\u2192    }\\n   132\u2192}\\n   133\u2192\\n   134\u2192impl Default for ExtendsResolver {\\n   135\u2192    fn default() -> Self {\\n   136\u2192        Self::new()\\n   137\u2192    }\\n   138\u2192}\\n   139\u2192\\n   140\u2192/// Known private/internal hostnames that should be blocked for SSRF prevention.\\n   141\u2192const BLOCKED_HOSTS: &[&str] = &[\\\"localhost\\\", \\\"127.0.0.1\\\", \\\"0.0.0.0\\\", \\\"[::1]\\\"];\\n   142\u2192\\n   143\u2192/// Known cloud metadata IP addresses.\\n   144\u2192const BLOCKED_IPS: &[&str] = &[\\\"169.254.169.254\\\", \\\"100.100.100.200\\\"];\\n   145\u2192\\n   146\u2192/// Extract the host from an HTTP/HTTPS URL.\\n   147\u2192fn extract_host(url: &str) -> Option<String> {\\n   148\u2192    // Strip scheme\\n   149\u2192    let without_scheme = url\\n   150\u2192        .strip_prefix(\\\"https://\\\")\"}]},\"parent_tool_use_id\":\"toolu_01MGJbeQUiXKwiNzj6iBEcHL\",\"session_id\":\"71626d50-8e30-42b0-86de-6cafbf80e23f\",\"uuid\":\"7c81501a-daf8-4be7-8122-1f559379a21c\"}\n{\"type\":\"assistant\",\"message\":{\"model\":\"claude-haiku-4-5-20251001\",\"i