lf.project_root\\n    41\u2192    }\\n    42\u2192\\n    43\u2192    /// Get the command arguments.\\n    44\u2192    pub fn args(&self) -> &StatusArgs {\\n    45\u2192        &self.args\\n    46\u2192    }\\n    47\u2192\\n    48\u2192    /// Resolve the target environment using the priority chain.\\n    49\u2192    fn resolve_environment(&self, config: &crate::config::BivvyConfig) -> ResolvedEnvironment {\\n    50\u2192        ResolvedEnvironment::resolve_from_config(self.args.env.as_deref(), &config.settings)\\n    51\u2192    }\\n    52\u2192}\\n    53\u2192\\n    54\u2192impl Command for StatusCommand {\\n    55\u2192    fn execute(&self, ui: &mut dyn UserInterface) -> Result<CommandResult> {\\n    56\u2192        // Load configuration\\n    57\u2192        let config = match load_merged_config(&self.project_root) {\\n    58\u2192            Ok(c) => c,\\n    59\u2192            Err(BivvyError::ConfigNotFound { .. }) => {\\n    60\u2192                ui.error(\\\"No configuration found. Run 'bivvy init' first.\\\");\\n    61\u2192                return Ok(CommandResult::failure(2));\\n    62\u2192            }\\n    63\u2192            Err(e) => return Err(e),\\n    64\u2192        };\\n    65\u2192\\n    66\u2192        // Apply config default_output when no CLI flag was explicitly set\\n    67\u2192        if ui.output_mode() == OutputMode::Normal {\\n    68\u2192            ui.set_output_mode(config.settings.default_output.into());\\n    69\u2192        }\\n    70\u2192\\n    71\u2192        // Get project identity\\n    72\u2192        let project_id = ProjectId::from_path(&self.project_root)?;\\n    73\u2192\\n    74\u2192        // Load state\\n    75\u2192        let state = StateStore::load(&project_id)?;\\n    76\u2192\\n    77\u2192        let theme = BivvyTheme::new();\\n    78\u2192\\n    79\u2192        // Resolve environment\\n    80\u2192        let resolved_env = self.resolve_environment(&config);\\n    81\u2192\\n    82\u2192        // Show header: \u26fa AppName \u2014 Status\\n    83\u2192        let app_name = config.app_name.as_deref().unwrap_or(\\\"Bivvy Setup\\\");\\n    84\u2192        ui.message(&format!(\\n    85\u2192            \\\"\\\\n  {} {} {} {}\\\\n\\\",\\n    86\u2192            theme.header.apply_to(\\\"\u26fa\\\"),\\n    87\u2192            theme.highlight.apply_to(app_name),\\n    88\u2192            theme.dim.apply_to(\\\"\u2014\\\"),\\n    89\u2192            theme.dim.apply_to(\\\"Status\\\"),\\n    90\u2192        ));\\n    91\u2192\\n    92\u2192        // Show environment info\\n    93\u2192        ui.message(&format!(\\n    94\u2192            \\\"  {} {} ({})\\\",\\n    95\u2192            theme.key.apply_to(\\\"Environment:\\\"),\\n    96\u2192            theme.highlight.apply_to(&resolved_env.name),\\n    97\u2192            theme.dim.apply_to(resolved_env.source.to_string()),\\n    98\u2192        ));\\n    99\u2192        ui.message(\\\"\\\");\\n   100\u2192\"}]},\"parent_tool_use_id\":\"toolu_01MGJbeQUiXKwiNzj6iBEcHL\",\"session_id\":\"71626d50-8e30-42b0-86de-6cafbf80e23f\",\"uuid\":\"ade683b0-c250-4426-b855-2b2ecb583d58\"}\n{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01MGJbeQUiXKwiNzj6iBEcHL\",\"type\":\"tool_result\",\"content\":[{\"type\":\"text\",\"text\":\"Perfect! Now I have a comprehensive understanding of the config system. Let me create a final summary document:\\n\\n## Comprehensive Config Loading Analysis\\n\\nBased on my thorough exploration of the Bivvy codebase, here's the complete picture of how config loading and error handling works:\\n\\n### 1. **Config File Loading & Parsing**\\n\\n**Location:** `/private/var/folders/_q/qzh8_t6s15388qqf3p6n3d200000gp/T/bench-7okzbcvu/src/config/loader.rs`\\n\\n**Key Functions:**\\n- `load_merged_config(project_root: &Path)` - Main entry point that discovers and merges all config files\\n- `load_config_file(path: &Path)` - Loads a single file and parses it\\n- `parse_config(content: &str, source_path: &Path)` - YAML parsing to BivvyConfig struct\\n- `load_config_value(path: &Path)` - Loads as raw serde_yaml::Value for merging\\n\\n**Config File Discovery Order (ConfigPaths::discover):**\\n1. Remote base configs (from `extends:`) - handled separately\\n2. User global config (`~/.bivvy/config.yml`) - if exists\\n3. Project config (`.bivvy/config.yml`) - REQUIRED\\n4. Local overrides (`.bivvy/config.local.yml`) - if exists\\n\\n### 2. **Error Handling Infrastructure**\\n\\n**Location:** `/private/var/folders/_q/qzh8_t6s15388qqf3p6n3d200000gp/T/bench-7okzbcvu/src/error.rs`\\n\\n**Error Types Defined:**\\n- `ConfigNotFound { path }` - File doesn't exist at expected location\\n- `ConfigParseError { path, message }` - YAML parsing failed (wraps serde_yaml error)\\n- `ConfigValidationError { message }` - Invalid structure or values\\n- `UnknownTemplate { name }` - Referenced template doesn't exist\\n- `CircularDependency { cycle }` - Step dependency cycle detected\\n- `Io(std::io::Error)` - File I/O errors\\n- `Other(anyhow::Error)` - Generic wrapped errors\\n\\n**Result Type:** `type Result<T> = std::result::Result<T, BivvyError>;`\\n\\n### 3. **Parsing & Validation Flow**\\n\\n**Location:** `/private/var/folders/_q/qzh8_t6s15388qqf3p6n3d200000gp/T/bench-7okzbcvu/src/config/validator.rs`\\n\\n**Validation Rules (validate_config):**\\n- Steps must have either `template` or `command`\\n- `depends_on` must reference existing steps\\n- Workflows must reference existing steps\\n- No circular dependencies allowed\\n\\n**Validation Returns:**\\n- Collects ALL errors (not just first one) in `Vec<ValidationError>`\\n- Each error has: rule ID, human-readable message, step/workflow context\\n- `validate()` function converts to `Result` - returns `ConfigValidationError` if any errors\\n\\n### 4. **Deep Merge Logic**\\n\\n**Location:** `/private/var/folders/_q/qzh8_t6s15388qqf3p6n3d200000gp/T/bench-7okzbcvu/src/config/merger.rs`\\n\\n**Merge Rules:**\\n- Objects are merged recursively\\n- Arrays are REPLACED entirely (not merged)\\n- Null values in overlay DELETE the key from base\\n- Scalars in overlay replace scalars in base\\n- Leaf keys (like `environments`) have special handling - entries replace entirely instead of field-merging\\n\\n**Functions:**\\n- `deep_merge(base, overlay)` - Basic merge\\n- `deep_merge_with_leaves(base, overlay, leaf_keys)` - With leaf key awareness\\n- `merge_configs(configs: &[Value])` - Merge multiple in order (later overrides earlier)\\n\\n### 5. **Extends Resolution**\\n\\n**Location:** `/private/var/folders/_q/qzh8_t6s15388qqf3p6n3d200000gp/T/bench-7okzbcvu/src/config/extends.rs`\\n\\n**ExtendsResolver:**\\n- Resolves remote base configs from `extends:` field\\n- Fetches via HTTP/HTTPS (with 30-second timeout default)\\n- Max depth: 10 to prevent infinite chains\\n- Circular reference detection via URL tracking\\n- Merges remote bases first, then project config, clears `extends` from final result\\n\\n**Error Flow:**\\n- Network errors wrapped as `anyhow::Error`\\n- Parse errors from fetched content propagate up\\n\\n### 6. **Current Error Handling in Commands**\\n\\n**Location:** Various command files in `/src/cli/commands/`\\n\\n**Pattern Used in RunCommand, LintCommand, ConfigCommand, ListCommand, StatusCommand:**\\n\\n```rust\\nlet config = match load_merged_config(&project_root) {\\n    Ok(c) => c,\\n    Err(BivvyError::ConfigNotFound { .. }) => {\\n        ui.error(\\\"No configuration found. Run 'bivvy init' first.\\\");\\n        return Ok(CommandResult::failure(2));\\n    }\\n    Err(BivvyError::ConfigParseError { path, message }) => {  // ONLY LintCommand does this\\n        ui.error(&format!(\\\"Parse error in {}: {}\\\", path.display(), message));\\n        return Ok(CommandResult::failure(1));\\n    }\\n    Err(e) => return Err(e),  // All other errors propagate up\\n};\\n```\\n\\n**Key Observations:**\\n- ConfigNotFound is handled gracefully with user-friendly message (exit code 2)\\n- ConfigParseError is ONLY explicitly handled in LintCommand\\n- Other commands let parse errors propagate as Err(e) to main.rs\\n- No explicit handling for ConfigValidationError in commands\\n- Main.rs catches any Err and shows generic error message + exit(1)\\n\\n### 7. **NO FALLBACK TO DEFAULT CONFIG**\\n\\n**Critical Finding:** There is NO fallback to default config. If `.bivvy/config.yml` doesn't exist:\\n- `ConfigPaths::has_project_config()` returns false\\n- `load_merged_config()` returns `BivvyError::ConfigNotFound`\\n- Commands all require an explicit config file\\n- User must run `bivvy init` to create one\\n\\n### 8. **Environment Variable Handling**\\n\\n**Location:** `/private/var/folders/_q/qzh8_t6s15388qqf3p6n3d200000gp/T/bench-7okzbcvu/src/config/environment.rs`\\n\\n**Functions:**\\n- `load_env_file(path)` - Loads dotenv files, returns error if missing\\n- `load_env_file_optional(path)` - Returns empty map if missing (fallback)\\n- `load_system_env()` - Loads from system environment\\n- `merge_env(base, overlay)` - Merges environment variables\\n- Built-in SECRET_PATTERNS for masking sensitive values\\n\\n### 9. **Existing Warning/Error Infrastructure**\\n\\n**Config Module:**\\n- Tracing (via tracing crate) for debug logging\\n- ValidationError struct with categorized errors\\n- Comprehensive error types with context (paths, step names, etc.)\\n\\n**Lint Module** (`/src/lint/`):\\n- Rule-based diagnostics system\\n- Multiple formatters: Human, JSON, SARIF\\n- Severity levels for lint errors\\n\\n**No explicit warning system** for:\\n- Failed extends resolution (continues without base)\\n- Partial parse errors\\n- Deprecated config fields\\n- Type mismatches (fails hard instead)\\n\\n### 10. **File Structure Summary**\\n\\n```\\nsrc/config/\\n\u251c\u2500\u2500 mod.rs                 # Module docs & re-exports\\n\u251c\u2500\u2500 loader.rs             # File discovery & loading (PRIMARY)\\n\u251c\u2500\u2500 schema.rs             # 