 file format.\\n\\nuse serde::{Deserialize, Serialize};\\nuse std::collections::HashMap;\\nuse std::path::PathBuf;\\n\\n/// Root configuration structure for bivvy.yml\\n#[derive(Debug, Clone, Default, Serialize, Deserialize)]\\n#[serde(default)]\\npub struct BivvyConfig {\\n    /// Application name (for display purposes)\\n    #[serde(skip_serializing_if = \\\"Option::is_none\\\")]\\n    pub app_name: Option<String>,\\n\\n    /// Global settings\\n    pub settings: Settings,\\n\\n    /// Remote template sources\\n    #[serde(default, skip_serializing_if = \\\"Vec::is_empty\\\")]\\n    pub template_sources: Vec<TemplateSource>,\\n\\n    /// Step definitions\\n    #[serde(default)]\\n    pub steps: HashMap<String, StepConfig>,\\n\\n    /// Workflow definitions\\n    #[serde(default)]\\n    pub workflows: HashMap<String, WorkflowConfig>,\\n\\n    /// Secrets configuration\\n    #[serde(default, skip_serializing_if = \\\"HashMap::is_empty\\\")]\\n    pub secrets: HashMap<String, SecretConfig>,\\n\\n    /// Config inheritance\\n    #[serde(skip_serializing_if = \\\"Option::is_none\\\")]\\n    pub extends: Option<Vec<ExtendsConfig>>,\\n\\n    /// Custom requirement definitions\\n    #[serde(default, skip_serializing_if = \\\"HashMap::is_empty\\\")]\\n    pub requirements: HashMap<String, CustomRequirement>,\\n\\n    /// User-defined variables for interpolation.\\n    #[serde(default, skip_serializing_if = \\\"HashMap::is_empty\\\")]\\n    pub vars: HashMap<String, VarDefinition>,\\n}\\n\\n/// Global settings that apply to all workflows and steps\\n#[derive(Debug, Clone, Serialize, Deserialize)]\\n#[serde(default)]\\npub struct Settings {\\n    /// Default output mode: verbose, quiet, silent\\n    #[serde(default = \\\"default_output\\\")]\\n    pub default_output: OutputMode,\\n\\n    /// Enable logging to file\\n    #[serde(default, skip_serializing_if = \\\"is_false\\\")]\\n    pub logging: bool,\\n\\n    /// Log file path (relative to project root)\\n    #[serde(skip_serializing_if = \\\"Option::is_none\\\")]\\n    pub log_path: Option<PathBuf>,\\n\\n    /// Global environment variables\\n    #[serde(default, skip_serializing_if = \\\"HashMap::is_empty\\\")]\\n    pub env: HashMap<String, String>,\\n\\n    /// Global env file to load\\n    #[serde(skip_serializing_if = \\\"Option::is_none\\\")]\\n    pub env_file: Option<PathBuf>,\\n\\n    /// Additional secret patterns to mask\\n    #[serde(default, skip_serializing_if = \\\"Vec::is_empty\\\")]\\n    pub secret_env: Vec<String>,\\n\\n    /// Enable parallel execution\\n    #[serde(default, skip_serializing_if = \\\"is_false\\\")]\\n    pub parallel: bool,\\n\\n    /// Maximum concurrent steps\\n    #[serde(\\n        default = \\\"default_max_parallel\\\",\\n        skip_serializing_if = \\\"is_default_max_parallel\\\"\\n    )]\\n    pub max_parallel: usize,\\n\\n    /// History retention count\\n    #[serde(\\n        default = \\\"default_history_retention\\\",\\n        skip_serializing_if = \\\"is_default_history_retention\\\"\\n    )]\\n    pub history_retention: usize,\\n\\n    /// Default environment name (used when no --env flag and no auto-detection)\\n    #[serde(skip_serializing_if = \\\"Option::is_none\\\")]\\n    pub default_environment: Option<String>,\\n\\n    /// Named environment configurations\",\"numLines\":100,\"startLine\":1,\"totalLines\":1682}}}\n{\"type\":\"assistant\",\"message\":{\"model\":\"claude-opus-4-6\",\"id\":\"msg_013NYdhZv4zNhFweKzMQKHse\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"thinking\",\"thinking\":\"Now I can see the issue clearly. `BivvyConfig` has `#[serde(default)]` at the struct level. This means that when `serde_yaml` deserializes the YAML, if a field is invalid or unknown, serde will just use the default value. This is the silent fallback behavior the user is complaining about.\\n\\nBut wait, `#[serde(default)]` doesn't actually ignore unknown fields - it provides defaults for MISSING fields. Unknown fields are ignored by serde by default (you need `#[serde(deny_unknown_fields)]` to reject them).\\n\\nSo the issue is twofold:\\n\\n\\n- Unknown or misspelled fields get silently ignored by serde\\n- Missing fields get default values because of `#[serde(default)]`\\n\\nThis combination means typos in field names like `app-name` instead of `app_name` will be ignored, and the correctly-named fields will just use their defaults, resulting in a config that looks valid but is actually broken. The fix is to add `#[serde(deny_unknown_fields)]` to catch these mistakes.\\n\\nThough I'm second-guessing whether that's too strict. Looking at this more carefully, there are really two separate issues here: the config parsing silently succeeds with defaults when it shouldn't, and the error handling in the commands doesn't give users a clear message when something does go wrong. The user's complaint specifically mentions the config falls back to defaults without warning, which means the parsing isn't actually failing\u2014it's succeeding with a default config because of how serde handles unknown and missing fields.\\n\\nThe most likely culprit is case 2: the user has valid YAML syntax but with typos or field names that don't match what bivvy expects, so serde just ignores them and uses defaults instead of raising an error.\\n\\nI should add `#[serde(deny_unknown_fields)]` to `BivvyConfig` and its nested structs to catch these typos, and make sure parse errors are properly reported in all commands. The merger already loads as raw `Value` before parsing into `BivvyConfig`, so the denial would happen at the right step. Though I should check if this would be too strict for custom extensions or other use cases.\\n\\nLooking at the actual file path\u2014the user said `.bivvy.yml` but the schema shows `.bivvy/config.yml`, so they might just be referring to the config file by a different name. The real fix is adding the deny_unknown_fields attribute to key structs like `BivvyConfig`, `Settings`, and `StepConfig`, then ensuring all commands handle parse errors with user-friendly messages like `lint.rs` already does.\\n\\nBut I need to think about this more carefully\u2014applying deny_unknown_fields to deeply nested structs could get messy, so `BivvyConfig` is the logical starting point. Actually, let me step back and think about what \\\"invalid\\\" really means here. The schema uses `#[serde(default)]` on both the struct and many fields, which combined with serde's default behavior of ignoring unknown fields means a typo like `stesp` instead of `steps` would silently parse as an empty HashMap instead of erroring out.\\n\\nThe solution is to add `#[serde(deny_unknown_fields)]` to catch these typos and make sure parse errors surface properly. Let me follow the TDD approach from CLAUDE.md\u2014write tests first, then implement. I should examine the full schema to see which structs need this attribute applied.\",\"signature\":\"\"}],\"stop_reason\":null,\"stop_sequence\":null,\"usage\":{\"input_tokens\":1,\"cache_creation_input_tokens\":2351,\"cache_read_input_tokens\":42204,\"cache_creation\":{\"ephemeral_5m_input_tokens\":2351,\"ephemeral_1h_input_tokens\":0},\"output_tokens\":13,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"71626d50-8e30-42b0-86de-6cafbf80e23f\",\"uuid\":\"34372b8c-3f3e-4bb5-9827-80808fb110fb\"}\n{\"type\":\"assistant\",\"message\":{\"model\":\"claude-opus-4-6\",\"id\":\"msg_013NYdhZv4zNhFweKzMQKHse\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"Now I understand the issue. `BivvyConfig` and its nested structs all use `#[serde(default)]` and serde silently ignores unknown fields by default. So if a user has typos in their config (e.g. `stesp` instead of `steps`), serde ignores the unknown fields and uses defaults for the \\\"missing\\\" correctly-named fields \u2014 silently producing a default config.\