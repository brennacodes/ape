<?xml version="1.0" encoding="UTF-8"?>
<ape version="0.2.2" xmlns="https://ape-lang.dev/schema/0">

  <meta>
    <name>Project Development Workflow</name>
    <description>A structured development workflow that enforces skills-first execution, intent classification, planning for large changes, test-driven development, and verification. Designed for an AI agent working with a human developer.</description>
  </meta>

  <constraint>NEVER create separate documentation files (README, markdown docs) as part of this workflow.</constraint>
  <constraint>NEVER create throwaway test scripts or ad hoc verification files.</constraint>
  <constraint>ALWAYS prefer established libraries and existing project utilities over custom solutions.</constraint>
  <constraint>ALWAYS keep changes minimal and intentional.</constraint>

  <rules>
    <rule>Prefer highly modular code that separates concerns into focused, single-responsibility modules.</rule>
    <rule>Prefer composition over monoliths.</rule>
    <rule>Keep module boundaries clear with minimal public API surface.</rule>
    <rule>Extract shared functionality into dedicated modules as the codebase grows.</rule>
    <rule>Keep functions small, well-named, and focused; break up complex functions.</rule>
    <rule>Use docstrings and type hints for public APIs, complex logic, non-obvious constraints, edge cases, and "why/how" decisions.</rule>
    <rule>Avoid over-documenting trivial functions.</rule>
    <rule>Documentation belongs inside the code (docstrings and type hints), not in separate files.</rule>
  </rules>

  <anti-patterns>
    <anti-pattern>Creating separate documentation pages (README/markdown docs) instead of inline docstrings and type hints.</anti-pattern>
    <anti-pattern>Building custom solutions when a proven library already solves the problem.</anti-pattern>
    <anti-pattern>Writing throwaway test scripts instead of proper tests in the existing test suite.</anti-pattern>
    <anti-pattern>Documenting "what" instead of "why" or "how".</anti-pattern>
  </anti-patterns>

  <steps>

    <step number="1" id="skills-check">
      <title>Skills Protocol</title>
      <goal>Ensure available skills are evaluated before any work begins.</goal>

      <instructions>
        <instruction>
          <constraint>If you catch yourself rationalizing skipping the skills check ("this is simple", "I'll do one quick thing first"), stop and run the checklist again.</constraint>
          <action>Review all available skills and determine whether any match the current request.</action>
        </instruction>
        <instruction>
          <conditional on="{{ skill_match }}">
            <case value="true">
              <action>Announce which skill matches and execute it using the Skill tool. Follow the skill exactly.</action>
            </case>
            <case value="false">
              <action>No skill matches. Proceed to intake.</action>
            </case>
          </conditional>
        </instruction>
      </instructions>

      <gate>
        <criteria>All available skills have been reviewed against the current request, and a matching skill has been used or confirmed absent.</criteria>
        <on-fail retry="true" max="1" then="halt">Skills checklist was not completed before proceeding.</on-fail>
      </gate>
    </step>

    <step number="2" id="intake">
      <prerequisite ref="skills-check" goto="skills-check">Skills protocol must be completed first. If not, return to skills-check.</prerequisite>
      <title>Intake and Intent Confirmation</title>
      <goal>Understand what the user is asking for and classify the task size to determine whether planning is required.</goal>

      <instructions>
        <instruction>
          Identify the task outcome, constraints, and expected format from the user's request.
        </instruction>
        <instruction>
          Classify the task size: a multi-file refactor, new subsystem, or broad API change is "large"; everything else is "small".

          <conditional on="{{ task_size }}">
            <case value="large" goto="plan" />
            <case value="small" goto="implement" />
            <default>
              <ask-user-question var="task_size" type="choice">
                Is this task large (multi-file refactor, new subsystem, broad API change) or small?
                <option value="large">Large</option>
                <option value="small">Small</option>
              </ask-user-question>
            </default>
          </conditional>
        </instruction>
      </instructions>

      <gate>
        <criteria>The request is understood well enough to plan or execute without guessing, and the task size is classified.</criteria>
        <on-fail retry="true" max="1" then="halt">Request or task size still unclear.</on-fail>
      </gate>
    </step>

    <step number="3" id="plan">
      <prerequisite ref="intake" goto="implement">Task must be classified as large. If not, skip to implement.</prerequisite>
      <title>Plan Large Changes</title>
      <goal>Define a concrete plan for large changes and get approval before implementation.</goal>

      <instruction>
        <plan-mode>
          Explain the concrete plan: scope, steps, risks, and test strategy. Present the plan for approval before proceeding.
        </plan-mode>

        <ask-user-question var="plan_approved" type="confirm">Approve this plan to proceed with implementation?</ask-user-question>
      </instruction>

      <gate>
        <criteria>A concrete plan covering scope, steps, risks, and test strategy has been presented and approved by the developer.</criteria>
        <on-fail retry="true" max="2" then="halt">Plan not approved. Revise based on feedback.</on-fail>
      </gate>
    </step>

    <step number="4" id="implement">
      <prerequisite ref="intake" goto="intake">Task must be classified and understood. If not, return to intake.</prerequisite>
      <title>Test-Driven Implementation</title>
      <goal>Implement the requested change using test-driven development: write failing tests first, then implement until tests pass.</goal>

      <instructions>
        <instruction>
          <action>Write or update proper tests in the existing test suite for the new behavior. Run tests and confirm the new or updated tests fail for the right reasons.</action>
        </instruction>
        <instruction>
          Implement the change until tests pass. Ensure coverage for critical paths and edge cases (empty inputs, invalid types, large datasets).
          <note>Add brief test docstrings or comments where they clarify edge cases and expectations.</note>
        </instruction>
      </instructions>

      <gate>
        <criteria>Tests exist for new behavior, validate critical paths and edge cases, and all tests pass.</criteria>
        <on-fail retry="true" max="3" then="halt">Tests missing or failing.</on-fail>
      </gate>
    </step>

    <step number="5" id="verify">
      <prerequisite ref="implement" goto="implement">Implementation and tests must be complete. If not, return to implement.</prerequisite>
      <title>Verify and Finish</title>
      <goal>Confirm that the implementation is correct and deliver a summary of changes.</goal>

      <instructions>
        <instruction>
          <action>Run the standard build and test commands to confirm everything passes.</action>
        </instruction>
        <instruction>
          Confirm the result matches the requested behavior. Provide a concise summary of what changed, why, and where tests were added or updated.
        </instruction>
      </instructions>

      <gate>
        <criteria>Build and tests are green, behavior matches the request, and a summary has been delivered.</criteria>
        <on-fail goto="implement">Build or tests failing. Return to implementation to fix.</on-fail>
      </gate>
    </step>

  </steps>

  <principles>
    <principle name="Skills-first">Always evaluate available skills before starting any work.</principle>
    <principle name="Plan-before-act">Large changes require an approved plan before implementation begins.</principle>
    <principle name="Test-driven">Write failing tests first, then implement until they pass.</principle>
    <principle name="Modular">Separate concerns into focused modules with clear boundaries and minimal public APIs.</principle>
    <principle name="Minimal">Keep changes intentional and avoid scope creep. Do what was asked.</principle>
  </principles>

</ape>
