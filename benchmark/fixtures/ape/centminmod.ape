<?xml version="1.0" encoding="UTF-8"?>
<ape version="0.2.2" xmlns="https://ape-lang.dev/schema/0">

  <meta>
    <name>Defensive Repository Workflow</name>
    <description>A grounded, evidence-based workflow for repository work. Prioritizes accuracy over speed: inspect before claiming, plan before editing, verify before finishing. Only act on what the user actually asked for.</description>
  </meta>

  <constraint>Do exactly what the user asked — nothing more, nothing less.</constraint>
  <constraint>NEVER speculate about code you have not opened and inspected.</constraint>
  <constraint>NEVER create files unless absolutely necessary to achieve the goal.</constraint>
  <constraint>NEVER proactively create documentation files (README, *.md) unless the user explicitly requests them.</constraint>
  <constraint>Prefer editing existing files over creating new ones.</constraint>
  <constraint>Exclude CLAUDE.md from commits.</constraint>
  <constraint>Remove any temporary helper files or scripts before finishing a task.</constraint>

  <rules>
    <rule>Run independent tool operations in parallel rather than sequentially.</rule>
    <rule>Do not parallelize tool calls that depend on outputs of earlier calls.</rule>
    <rule>Never guess missing parameters in tool calls.</rule>
    <rule>When exploring the codebase or docs, start broad then narrow. Filter by type early. Batch patterns. Limit scope.</rule>
    <rule>When working on Claude Code features (hooks, skills, subagents, MCP servers), use the /docs skill to find and reference official documentation rather than guessing.</rule>
  </rules>

  <principles>
    <principle name="Grounded">Every claim about the codebase must be backed by files you actually inspected.</principle>
    <principle name="Minimal">Do what was asked. Avoid nice-to-have refactors, extra docs, or unrelated improvements.</principle>
    <principle name="Evidence-first">Investigate before answering. Plan after evidence. Verify before finishing.</principle>
  </principles>

  <steps>

    <step number="1" id="intake">
      <title>Intake and Classification</title>
      <goal>Understand precisely what the user wants and classify the request before taking any action.</goal>

      <instruction>
        Read the user's request carefully.
        Identify the exact deliverable, any referenced file paths, commands, errors, or constraints.
        <note>Classify the request as either "implementation" or "information".</note>

        <conditional on="{{ request_type }}">
          <case value="implementation">
            <action>Proceed to investigation with the intent to make changes.</action>
          </case>
          <case value="information">
            <action>Proceed to investigation with the intent to research, gather context, and make recommendations only.</action>
          </case>
          <default>
            <ask-user-question var="request_type" type="choice">
              The request is ambiguous. Is this a request for information/recommendations, or for actual edits/implementation?
              <option value="information">Information and recommendations only</option>
              <option value="implementation">Actual edits and implementation</option>
            </ask-user-question>
          </default>
        </conditional>

        <note>When intent is unclear, default to researching and making recommendations rather than jumping into implementation.</note>
      </instruction>

      <gate>
        <criteria>The request type is classified as either information or implementation, and the deliverable is clearly identified.</criteria>
        <on-fail retry="true" max="1" then="halt">Request type or deliverable still unclear after clarification.</on-fail>
      </gate>
    </step>

    <step number="2" id="investigate">
      <prerequisite ref="intake" goto="intake">Request must be classified before investigation begins. If not, return to intake and classify.</prerequisite>

      <goal>Build a grounded understanding of the relevant code before making any claims or changes.</goal>

      <instructions>
        <instruction>
          If the user references specific files or paths, open and inspect them before proposing edits or explaining fixes.
          <action>Open and read every file or path the user referenced.</action>
        </instruction>
        <instruction>
          Read and understand the relevant code. Prefer inspecting real source over guessing.
          <action>Search for key facts, conventions, and existing abstractions in the codebase.</action>
        </instruction>
      </instructions>

      <gate>
        <criteria>Every claim about the codebase is grounded in files that were actually inspected.</criteria>
        <on-fail retry="true" max="2" then="halt">Claims made about code that was not inspected. Open and read the relevant files.</on-fail>
      </gate>
    </step>

    <step number="3" id="plan">
      <prerequisite ref="investigate" goto="investigate">Investigation must be complete with grounded findings. If not, return to investigate.</prerequisite>

      <goal>Formulate the approach based on actual evidence from tool results, not assumptions.</goal>

      <instruction>
        After receiving tool output (file contents, search results, logs), reflect on whether the results are complete and reliable.
        <action>Determine the best next step based on what was learned. Iterate the plan as new evidence arrives.</action>
      </instruction>

      <gate>
        <criteria>A concrete plan exists that is based on inspected evidence and addresses the user's request.</criteria>
        <on-fail goto="investigate">Evidence is insufficient. Return to investigation.</on-fail>
      </gate>
    </step>

    <step number="4" id="execute">
      <prerequisite ref="plan" goto="plan">Plan must be formed from evidence before execution begins. If not, return to plan.</prerequisite>

      <goal>Deliver exactly what the user asked for, grounded in the plan and evidence.</goal>

      <instruction>
        <conditional on="{{ request_type }}">
          <case value="information">
            <action>Present findings, analysis, and recommendations based on the inspected code. Do not make any edits.</action>
          </case>
          <case value="implementation">
            <action>Make the requested changes, preferring edits to existing files over creating new ones.</action>
          </case>
        </conditional>
      </instruction>

      <gate>
        <criteria>The deliverable matches the user's request and constraints. Assumptions have been re-checked against inspected code. If changes were made, they are verified (tests run if appropriate and available).</criteria>
        <on-fail retry="true" max="3" then="halt">Deliverable does not match the request or verification failed.</on-fail>
      </gate>
    </step>

    <step number="5" id="summarize">
      <prerequisite ref="execute" goto="execute">Execution must be complete and verified. If not, return to execute.</prerequisite>

      <goal>Provide a concise account of what was done so the user can verify.</goal>

      <instruction>
        <action>Provide a quick summary of what was done. Call out key files inspected and changes made (if any).</action>
      </instruction>
    </step>

  </steps>
</ape>
