<?xml version="1.0" encoding="UTF-8"?>
<ape version="0.2.2" xmlns="https://ape-lang.dev/schema/0">

  <meta>
    <name>Engineering Standards Workflow</name>
    <description>Standards-driven development workflow enforcing code quality, testing discipline, and review rigor across every project and every change. Covers the full cycle from planning through PR creation, with a separate review evaluation workflow.</description>

    <variables>
      <var name="max_function_lines" type="number" default="100" />
      <var name="max_cyclomatic_complexity" type="number" default="8" />
      <var name="max_positional_params" type="number" default="5" />
      <var name="max_line_length" type="number" default="100" />
      <var name="max_commit_subject_length" type="number" default="72" />
      <var name="dependabot_cooldown_days" type="number" default="7" />
    </variables>

    <commands>
      <command id="fetch-origin" shell="bash">git fetch origin</command>
    </commands>

  </meta>

  <constraint>Do not add features, flags, or configuration unless users actively need them.</constraint>
  <constraint>Do not create utilities until the same code has been written three times.</constraint>
  <constraint>Treat every dependency as attack surface and maintenance burden. Add only with a clear reason.</constraint>
  <constraint>Do not document or validate features that are not implemented.</constraint>
  <constraint>When a new implementation replaces an old one, remove the old one entirely. Do not add shims, dual config formats, or migration paths. Proactively flag dead code.</constraint>
  <constraint>Fix every warning from every tool (linters, type checkers, compilers, tests). If a warning truly cannot be fixed, add an inline ignore with a justification comment. Never leave warnings unaddressed.</constraint>
  <constraint>No commented-out code. Delete it.</constraint>
  <constraint>Never swallow exceptions silently.</constraint>
  <constraint>Never amend or rebase commits already pushed to shared branches.</constraint>
  <constraint>Never push directly to main. Use feature branches and PRs.</constraint>
  <constraint>Never commit secrets or credentials. Use .env (gitignored) and environment variables.</constraint>
  <constraint>Absolute imports only. No relative ".." paths.</constraint>
  <constraint>Every bash script must start with: set -euo pipefail</constraint>

  <rules>
    <rule>Functions must be &lt;= {{ max_function_lines }} lines.</rule>
    <rule>Cyclomatic complexity must be &lt;= {{ max_cyclomatic_complexity }}.</rule>
    <rule>No more than {{ max_positional_params }} positional parameters per function.</rule>
    <rule>Line length must be &lt;= {{ max_line_length }} characters.</rule>
    <rule>Google-style docstrings for non-trivial public APIs.</rule>
    <rule>Prefer explicit, readable code over dense one-liners.</rule>
    <rule>If a comment is needed to explain WHAT code does, refactor for clarity instead.</rule>
    <rule>Fail fast with clear, actionable error messages. Include context: operation, input, and suggested fix.</rule>
  </rules>

  <rules>
    <rule>Test behavior, not implementation. If a refactor breaks tests but behavior is unchanged, the tests were wrong.</rule>
    <rule>Test edges and errors, not only the happy path: empty inputs, boundaries, malformed data, missing files, network failures.</rule>
    <rule>Every handled error path must have a test that triggers it.</rule>
    <rule>Mock only slow (network/filesystem), non-deterministic (time/randomness), or external services you do not control. Do not mock internal logic.</rule>
    <rule>Verify tests catch failures: break the code, confirm the test fails, then fix.</rule>
  </rules>

  <rules>
    <rule>When adding dependencies, CI actions, or tool versions, look up the current stable version. Do not assume versions from memory.</rule>
    <rule>Pin GitHub Actions to full SHA with a version comment: actions/checkout@&lt;full-sha&gt;  # vX.Y.Z</rule>
    <rule>Use persist-credentials: false in GitHub Actions.</rule>
    <rule>Configure Dependabot with {{ dependabot_cooldown_days }}-day cooldowns and grouped updates.</rule>
  </rules>

  <rules>
    <rule>Add automated guardrails first: linters, type checkers, pre-commit hooks, tests.</rule>
    <rule>Prefer structure-aware tools (AST/LSP/compilers) over text pattern matching.</rule>
    <rule>Review your own output critically. Assume every layer will miss something.</rule>
  </rules>

  <anti-patterns>
    <anti-pattern>Adding speculative features no user has asked for.</anti-pattern>
    <anti-pattern>Abstracting prematurely from fewer than three concrete examples.</anti-pattern>
    <anti-pattern>Documenting or validating features that do not exist yet.</anti-pattern>
    <anti-pattern>Leaving deprecated code alongside its replacement instead of removing it.</anti-pattern>
    <anti-pattern>Including discarded approaches or prior iterations in PR descriptions.</anti-pattern>
    <anti-pattern>Using hype words in PRs: critical, crucial, essential, significant, comprehensive, robust, elegant.</anti-pattern>
  </anti-patterns>

  <steps>

    <step number="1" id="plan">
      <goal>Establish the goal, constraints, and reversibility before writing code.</goal>

      <instructions>
        <instruction>
          <action>Restate the goal and constraints.</action>
        </instruction>
        <instruction>
          Identify what is reversible versus what commits to an interface, data model, or architecture.

          <conditional on="{{ commits_to_interface_or_architecture }}" default="proceed">
            <case value="true">
              <ask-user-question var="architecture_approval" type="confirm">This change commits to an interface, data model, or architecture. Approve before proceeding?</ask-user-question>
            </case>
          </conditional>

          <conditional on="{{ touches_external_services_destructively }}" default="proceed">
            <case value="true">
              <ask-user-question var="destructive_approval" type="confirm">This change involves destructive or write operations on external services. Approve before proceeding?</ask-user-question>
            </case>
          </conditional>
        </instruction>
      </instructions>

      <gate>
        <criteria>Goal and constraints are restated. Reversibility is assessed. Approval has been obtained for any interface, data model, architecture, or destructive external service changes.</criteria>
        <on-fail retry="true" max="1" then="halt">Goal or constraints unclear, or approval not obtained for committed decisions.</on-fail>
      </gate>
    </step>

    <step number="2" id="implement">
      <prerequisite ref="plan" goto="plan">Plan must be approved before implementation begins. If not, return to plan.</prerequisite>
      <goal>Make minimal, focused changes tied directly to the request with no speculative scope.</goal>

      <instructions>
        <instruction>
          <constraint>Do not introduce speculative features or premature abstractions.</constraint>
          <constraint>Keep within hard limits. If a function exceeds {{ max_function_lines }} lines or complexity exceeds {{ max_cyclomatic_complexity }}, refactor.</constraint>
          Keep changes minimal and directly tied to the request.
        </instruction>
        <instruction>
          <action>Add or adjust tests that validate behavior and error paths. Ensure error handling is actionable and contextual.</action>
        </instruction>
      </instructions>

      <gate>
        <criteria>Changes are minimal, directly tied to the request, within hard limits, and accompanied by tests covering behavior and error paths.</criteria>
        <on-fail retry="true" max="3" then="halt">Implementation exceeds scope, violates hard limits, or lacks test coverage.</on-fail>
      </gate>
    </step>

    <step number="3" id="verify">
      <prerequisite ref="implement" goto="implement">Implementation must be complete before verification. If not, return to implement.</prerequisite>
      <goal>Confirm the change is correct, clean, and ready to commit through multi-layer verification.</goal>

      <instructions>
        <instruction>
          <action>Run the relevant linters and type checker. Fix all warnings.</action>
        </instruction>
        <instruction>
          Run relevant tests that cover the change and its edge cases.
          <note>Run relevant tests, not necessarily the full suite.</note>
        </instruction>
        <instruction>
          <action>Review your own diff for unnecessary complexity, redundancy, and naming clarity.</action>
        </instruction>
      </instructions>

      <gate>
        <criteria>Linters and type checker produce zero warnings. Relevant tests pass. Diff has been reviewed for complexity, redundancy, and naming clarity.</criteria>
        <on-fail goto="implement">Warnings, test failures, or quality issues found. Fix and re-verify.</on-fail>
      </gate>
    </step>

    <step number="4" id="commit">
      <prerequisite ref="verify" goto="verify">Verification must pass before committing. If not, return to verify.</prerequisite>
      <goal>Create a clean, atomic commit with a clear message after final verification.</goal>

      <instructions>
        <instruction>
          <action>Re-read changes for unnecessary complexity, redundant code, and unclear naming. Run relevant tests. Run linters and type checker. Fix everything before committing.</action>
        </instruction>
        <instruction>
          Create one commit per logical change.

          <rules>
            <rule>Imperative mood subject line, &lt;= {{ max_commit_subject_length }} characters.</rule>
            <rule>One logical change per commit.</rule>
          </rules>
        </instruction>
        <instruction>
          <conditional on="{{ using_parallel_subagents }}" default="proceed">
            <case value="true">
              <action>Each subagent must use its own worktree. Never share working directories with parallel subagents.</action>
            </case>
          </conditional>
        </instruction>
      </instructions>

      <gate>
        <criteria>Commit contains one logical change. Subject line uses imperative mood and is &lt;= {{ max_commit_subject_length }} characters. No secrets or credentials are included. Linters and tests pass.</criteria>
        <on-fail goto="verify">Pre-commit checks failed. Return to verification.</on-fail>
      </gate>
    </step>

    <step number="5" id="pull-request">
      <prerequisite ref="commit" goto="commit">Changes must be committed before opening a PR. If not, return to commit.</prerequisite>
      <goal>Open a PR with a factual description of what the code does now.</goal>

      <instruction>
        Create a pull request. Describe what the code does now based on what is in the diff.

        <rules>
          <rule>Use plain, factual language.</rule>
          <rule>Do not include discarded approaches or prior iterations.</rule>
          <rule>Do not use hype words: critical, crucial, essential, significant, comprehensive, robust, elegant.</rule>
        </rules>
      </instruction>

      <gate>
        <criteria>PR description accurately reflects the diff. Language is factual. No discarded approaches, prior iterations, or hype words are included.</criteria>
        <on-fail retry="true" max="2" then="halt">PR description does not meet standards.</on-fail>
      </gate>
    </step>

  </steps>

  <steps>

    <step number="1" id="review-sync">
      <goal>Ensure the review is based on the latest remote state.</goal>

      <instruction>
        <action>
          Sync to the latest remote before reviewing.
          <command ref="fetch-origin" />
        </action>
      </instruction>

      <gate>
        <criteria>Local state is synced to the latest remote via git fetch origin.</criteria>
        <on-fail retry="true" max="2" then="halt">Failed to sync to remote.</on-fail>
      </gate>
    </step>

    <step number="2" id="review-evaluate">
      <prerequisite ref="review-sync" goto="review-sync">Must be synced to latest remote before evaluating. If not, return to review-sync.</prerequisite>
      <goal>Evaluate the change systematically in priority order: architecture, code quality, tests, performance.</goal>

      <instruction>
        Evaluate in this order: architecture, then code quality, then tests, then performance.

        For each issue found:
        <action>
          Describe the issue concretely with file:line references.
        </action>
        <action>
          Provide options with tradeoffs when the fix is not obvious. Recommend one option.
        </action>
        <action>
          <ask-user-question var="review_proceed" type="confirm">Proceed with the recommended fix?</ask-user-question>
        </action>
      </instruction>

      <gate>
        <criteria>All issues are described with file:line references. Options with tradeoffs are provided where the fix is not obvious. Developer approval is obtained before proceeding with each fix.</criteria>
        <on-fail retry="true" max="3" then="halt">Review issues not adequately described or developer approval not obtained.</on-fail>
      </gate>
    </step>

  </steps>

  <principles>
    <principle name="No Speculative Features">Do not add features, flags, or configuration unless users actively need them.</principle>
    <principle name="No Premature Abstraction">Do not create utilities until you have written the same code three times.</principle>
    <principle name="Clarity Over Cleverness">Prefer explicit, readable code over dense one-liners.</principle>
    <principle name="Justify New Dependencies">Treat every dependency as attack surface and maintenance burden. Add only with a clear reason.</principle>
    <principle name="No Phantom Features">Do not document or validate features that are not implemented.</principle>
    <principle name="Replace Dont Deprecate">When a new implementation replaces an old one, remove the old one entirely. No shims, dual config formats, or migration paths.</principle>
    <principle name="Verify At Every Level">Add automated guardrails first. Prefer structure-aware tools over text pattern matching. Review your own output critically.</principle>
    <principle name="Bias Toward Action">Decide and move on anything easily reversible, stating your assumption. Ask before committing to interfaces, data models, architecture, or destructive operations.</principle>
    <principle name="Finish The Job">Handle visible edge cases, clean up what you touched, flag adjacent breakage. Do not gold-plate or create new scope.</principle>
    <principle name="Agent-Native By Default">Design so agents can achieve any outcome users can. Tools are atomic primitives; features are outcomes described in prompts. Prefer file-based state for transparency and portability.</principle>
  </principles>

</ape>
