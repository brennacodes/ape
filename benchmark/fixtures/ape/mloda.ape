<?xml version="1.0" encoding="UTF-8"?>
<ape version="0.2.4" xmlns="https://ape-lang.dev/schema/0">

  <meta>
    <name>TDD Orchestrator Workflow</name>
    <description>Operating rules for a TDD Orchestrator pattern using Claude Code. The main agent coordinates the TDD loop end-to-end, delegating test writing to a Red Agent and implementation to a Green Agent. Specialized subagents do the hands-on work while the orchestrator validates phase transitions.</description>

    <actors>
      <actor id="orchestrator" type="agent">
        <description>Primary AI agent acting as TDD Orchestrator. Coordinates the TDD loop end-to-end.</description>
        <responsibilities>
          <responsibility>Coordinate the TDD loop end-to-end</responsibility>
          <responsibility>Specify requirements and delegate to subagents</responsibility>
          <responsibility>Validate phase completion by running tests</responsibility>
          <responsibility>Detect deadlocks and report to user</responsibility>
          <responsibility>Track phase completion in todo.md</responsibility>
        </responsibilities>
      </actor>
      <actor id="red-agent" type="subagent">
        <description>Subagent responsible for writing tests that encode requirements. Produces failing tests during the Red Phase.</description>
      </actor>
      <actor id="green-agent" type="subagent">
        <description>Subagent responsible for writing the minimum implementation to satisfy failing tests during the Green Phase.</description>
      </actor>
      <actor id="developer" type="human">
        <description>Human developer who intervenes when deadlocks occur and decides how to proceed.</description>
      </actor>
    </actors>

    <resources>
      <resource id="test-runner" type="executable">
        <description>The project's test command used to validate Red and Green phases</description>
      </resource>
      <resource id="todo-md" type="file" path="./todo.md" access="read,write">
        <description>Phase completion tracking file with checkboxes for each requirement</description>
      </resource>
      <resource id="red-agent-config" type="file" path="./.claude/agents/red-agent.md" access="read,write">
        <description>Red Agent configuration and instructions</description>
      </resource>
      <resource id="green-agent-config" type="file" path="./.claude/agents/green-agent.md" access="read,write">
        <description>Green Agent configuration and instructions</description>
      </resource>
      <resource id="claude-md" type="file" path="./CLAUDE.md" access="read,write">
        <description>Orchestration rules and workflow guidance document</description>
      </resource>
    </resources>

    <commands>
      <command id="run-tests" actor="orchestrator">Run the project's test command using the test runner</command>
      <command id="stage-changes" actor="orchestrator">Stage all changes with git</command>
    </commands>
  </meta>

  <constraint>The orchestrator must never write tests or implementation code directly. All code work is delegated to subagents.</constraint>
  <constraint>Never retry the same failing operation more than twice.</constraint>
  <constraint>Do not continue the TDD cycle while deadlocked.</constraint>

  <rules>
    <rule>Do not put code into auto-generated files or files with special naming conventions (e.g., __init__.py)</rule>
    <rule>Keep documentation to only what is necessary</rule>
    <rule>Always run tests after creation or changes using the appropriate test command</rule>
    <rule>Avoid try/except blocks unless explicitly required by the requirement</rule>
  </rules>

  <steps>

    <step number="1" id="red-phase" actor="orchestrator">
      <title>Red Phase</title>
      <goal>Specify the requirement and delegate test creation to the Red Agent so that failing tests encode the requirement.</goal>

      <instructions>
        <instruction>
          Specify the current requirement clearly for the Red Agent.
          <action actor="orchestrator">
            Delegate to the Red Agent with the requirement specification. The Red Agent must write tests that encode the requirement.
          </action>
        </instruction>
        <instruction>
          <note>The Red Agent writes tests that should fail before implementation exists. The output expectation is that tests exist and fail for the correct reason.</note>
          <action actor="red-agent">
            Write tests that encode the specified requirement. Tests must fail because the requirement is not yet implemented.
          </action>
        </instruction>
      </instructions>

      <gate>
        <criteria>New tests have been created by the Red Agent that encode the current requirement</criteria>
        <on-fail retry="true" max="2" then="halt">Red Agent failed to produce valid tests. Deadlock detected.</on-fail>
      </gate>
    </step>

    <step number="2" id="validate-red" actor="orchestrator" uses="test-runner, todo-md">
      <title>Validate Red Phase</title>
      <goal>Confirm that the new tests fail for the correct reason, proving the requirement is not yet implemented.</goal>

      <prerequisite ref="red-phase">Tests created by the Red Agent</prerequisite>

      <instructions>
        <instruction>
          <action actor="orchestrator">
            <command ref="run-tests" />
          </action>
        </instruction>
        <instruction>
          <action actor="orchestrator">
            Confirm the new or updated tests fail for the correct reason: the requirement is not implemented yet. Failures must be related to the missing implementation, not unrelated issues.
          </action>
        </instruction>
      </instructions>

      <gate>
        <criteria>New tests fail for the correct reason (requirement not yet implemented) and no unrelated failures are present</criteria>
        <on-fail goto="red-phase">
          <reason>Test failures are unrelated to the requirement. Send tests back to Red Agent to refine.</reason>
        </on-fail>
        <on-fail retry="true" max="2" then="halt">Red Agent failed the same refinement task twice. Deadlock detected.</on-fail>
      </gate>
    </step>

    <step number="3" id="green-phase" actor="orchestrator">
      <title>Green Phase</title>
      <goal>Delegate implementation to the Green Agent to satisfy the failing tests with a minimal change.</goal>

      <prerequisite ref="validate-red">Tests confirmed to fail for the correct reason</prerequisite>

      <constraint>Green Agent must implement the minimum change needed to satisfy the failing tests. Do not add extra features.</constraint>

      <instruction>
        <action actor="green-agent">
          Implement the minimum change needed to make the failing tests pass. Do not add extra features or functionality beyond what the tests require.
        </action>
      </instruction>

      <gate>
        <criteria>Green Agent has produced an implementation targeting the failing tests</criteria>
        <on-fail retry="true" max="2" then="halt">Green Agent failed to produce implementation. Deadlock detected.</on-fail>
      </gate>
    </step>

    <step number="4" id="validate-green" actor="orchestrator" uses="test-runner, todo-md">
      <title>Validate Green Phase</title>
      <goal>Confirm all tests pass including existing suites, ensuring no regressions were introduced.</goal>

      <prerequisite ref="green-phase">Implementation produced by the Green Agent</prerequisite>

      <instructions>
        <instruction>
          <action actor="orchestrator">
            <command ref="run-tests" />
          </action>
        </instruction>
        <instruction>
          <action actor="orchestrator">
            Confirm all tests pass, including existing test suites. There must be no regressions.
          </action>
        </instruction>
        <instruction>
          <action actor="orchestrator">
            Mark the phase complete by ticking the checkbox in todo.md.
            <write ref="todo-md" />
          </action>
        </instruction>
        <instruction>
          <action actor="orchestrator">
            <command ref="stage-changes" />
          </action>
          <note>Each completed phase ends with all tests passing and changes staged.</note>
        </instruction>
      </instructions>

      <gate>
        <criteria>All tests pass with no regressions and the phase is marked complete in todo.md</criteria>
        <on-fail goto="green-phase">
          <reason>Tests are failing. Send back to Green Agent to fix issues before proceeding.</reason>
        </on-fail>
        <on-fail retry="true" max="2" then="halt">Green Agent failed the same fix task twice. Deadlock detected.</on-fail>
      </gate>
    </step>

    <step number="5" id="cycle-transition" actor="orchestrator">
      <title>Cycle Transition</title>
      <goal>Transition to the next requirement and restart the TDD loop, or handle deadlock if detected.</goal>

      <prerequisite ref="validate-green">All tests passing and changes staged</prerequisite>

      <instruction>
        <action actor="orchestrator">
          Move to the next requirement. If all requirements are complete, the workflow ends. Otherwise restart the TDD loop at the Red Phase.
        </action>
      </instruction>

      <gate>
        <criteria>Next requirement is identified and ready for the Red Phase, or all requirements are complete</criteria>
        <on-pass goto="red-phase">Start the next TDD cycle with the new requirement</on-pass>
        <on-fail halt="true">All requirements have been completed or workflow must stop</on-fail>
      </gate>
    </step>

    <step number="6" id="deadlock-recovery" actor="orchestrator">
      <title>Deadlock Recovery</title>
      <goal>When a deadlock is detected (an agent fails the same task twice), stop and report to the user for a decision.</goal>

      <description>This step is entered when deadlock protection is triggered. The orchestrator must explain the failure clearly and wait for the user to decide how to proceed.</description>

      <instructions>
        <instruction>
          <action actor="orchestrator">
            Report to the user what failed, what was attempted, and what evidence was observed (errors, test output summary).
          </action>
        </instruction>
        <instruction>
          <ask-user-question var="deadlock-resolution" type="choice">
            A deadlock has been detected. How would you like to proceed?
            <option value="modify-approach">Modify the approach</option>
            <option value="update-instructions">Update agent instructions</option>
            <option value="manual-intervention">Manually intervene</option>
            <option value="skip-step">Skip the problematic step</option>
          </ask-user-question>
        </instruction>
        <instruction>
          <when>
            <if test="{{ deadlock-resolution }} == 'update-instructions'">
              <action actor="orchestrator">
                Update the appropriate agent configuration file to refine instructions, constraints, and workflow details.
                <write ref="red-agent-config" />
                <write ref="green-agent-config" />
              </action>
              <action actor="orchestrator">
                Document what was learned and why the change improves behavior.
              </action>
            </if>
          </when>
        </instruction>
      </instructions>

      <gate>
        <criteria>User has chosen a resolution and the orchestrator has acted on it</criteria>
        <on-pass goto="red-phase">Resume the TDD cycle</on-pass>
        <on-fail halt="true">Unable to resolve deadlock</on-fail>
      </gate>
    </step>

    <step number="7" id="self-improvement" actor="orchestrator" uses="red-agent-config, green-agent-config, claude-md">
      <title>Self-Improvement</title>
      <goal>When agent behavior is unexpected or incorrect, update configurations and document learnings to improve future behavior.</goal>

      <description>This step is triggered when agent behavior deviates from expectations during any phase. It updates agent configurations and orchestration rules.</description>

      <instructions>
        <instruction>
          <action actor="orchestrator">
            Create or modify agent configuration files to refine instructions, constraints, and workflow details.
            <write ref="red-agent-config" />
            <write ref="green-agent-config" />
          </action>
        </instruction>
        <instruction>
          <action actor="orchestrator">
            Update CLAUDE.md to clarify orchestration rules or add missing guidance.
            <write ref="claude-md" />
          </action>
        </instruction>
        <instruction>
          <action actor="orchestrator">
            Document what was learned and why the change improves behavior.
          </action>
        </instruction>
      </instructions>

      <gate>
        <criteria>Agent configurations and workflow guidance have been updated with documented learnings</criteria>
        <on-pass goto="red-phase">Resume the TDD cycle with improved configurations</on-pass>
        <on-fail halt="true">Unable to update configurations</on-fail>
      </gate>
    </step>

  </steps>

  <principles>
    <principle name="Orchestration Only">The main agent coordinates but never writes code. All implementation and test writing is delegated to specialized subagents.</principle>
    <principle name="Red-Green Discipline">Every requirement goes through the full Red-Green cycle: failing tests first, then minimal implementation to pass them.</principle>
    <principle name="Deadlock Protection">If any agent fails the same task twice, stop immediately and involve the human developer. Never silently loop.</principle>
    <principle name="Minimal Implementation">The Green Agent implements only what is needed to pass the failing tests. No extra features, no gold-plating.</principle>
    <principle name="Continuous Improvement">When agent behavior is unexpected, update configurations and document learnings to prevent recurrence.</principle>
  </principles>

</ape>
