<?xml version="1.0" encoding="UTF-8"?>
<ape version="0.2.2" xmlns="https://ape-lang.dev/schema/0">

  <meta>
    <name>TDD Orchestrator Workflow</name>
    <description>A test-driven development workflow where a main orchestrator agent coordinates Red and Green subagents through a repeating TDD cycle. The orchestrator never writes code directly — it delegates test authoring to the Red Agent and implementation to the Green Agent, validating each phase before proceeding.</description>

    <actors>
      <actor id="orchestrator" type="agent">
        <description>TDD Orchestrator. Coordinates the TDD loop end-to-end. Does not write tests or implementation code.</description>
        <responsibilities>
          <responsibility>Specify requirements and delegate to subagents</responsibility>
          <responsibility>Run test commands and validate phase outcomes</responsibility>
          <responsibility>Detect deadlocks and report to the user</responsibility>
        </responsibilities>
      </actor>
      <actor id="red-agent" type="subagent">
        <description>Writes tests that encode requirements. Output: failing tests.</description>
      </actor>
      <actor id="green-agent" type="subagent">
        <description>Implements the minimum change needed to satisfy failing tests.</description>
      </actor>
      <actor id="developer" type="human">
        <description>Intervenes when deadlocks occur or agent behavior needs correction. Decides next action: modify approach, update agent instructions, manually intervene, or skip.</description>
      </actor>
    </actors>

    <resources>
      <resource id="todo-md" type="file" path="todo.md" access="read,write" />
      <resource id="red-agent-config" type="file" path=".claude/agents/red-agent.md" access="read,write" />
      <resource id="green-agent-config" type="file" path=".claude/agents/green-agent.md" access="read,write" />
    </resources>

    <commands>
      <command id="run-tests" set="test_result">Run the project's test command</command>
    </commands>
  </meta>

  <constraint>The orchestrator must NEVER write tests or implementation code directly.</constraint>
  <constraint>The orchestrator must NEVER retry the same failing operation more than twice.</constraint>
  <constraint>Do not put code into auto-generated files or files with special naming conventions (e.g., __init__.py).</constraint>
  <constraint>Avoid try/except blocks unless explicitly required by the requirement.</constraint>
  <constraint>ALWAYS run tests after creating or changing code.</constraint>

  <rules>
    <rule>Keep documentation to only what is necessary.</rule>
    <rule>When reviewing agent output, verify it does not violate coding rules before accepting.</rule>
  </rules>

  <steps>

    <step number="1" id="red-phase">
      <goal>Delegate test writing to the Red Agent so that tests encoding the current requirement exist and are expected to fail.</goal>

      <instruction>
        Specify the requirement clearly, then delegate to the Red Agent to write tests that encode it.
        <action actor="red-agent">Write tests that encode the specified requirement. Tests must fail before implementation exists.</action>
      </instruction>

      <gate>
        <criteria>New tests exist that encode the current requirement.</criteria>
        <on-fail retry="true" max="2" then="deadlock-recovery">Red Agent failed to produce tests for the requirement.</on-fail>
      </gate>
    </step>

    <step number="2" id="red-validation" uses="todo-md">
      <prerequisite ref="red-phase" goto="red-phase">Tests must be written before they can be validated. If not, return to red-phase.</prerequisite>

      <goal>Confirm the new tests fail for the correct reason — the requirement is not yet implemented.</goal>

      <instructions>
        <instruction>
          <action>
            Run the test suite and capture the results.
            <command ref="run-tests" />
          </action>
        </instruction>
        <instruction>
          Verify the new or updated tests fail because the requirement is not implemented yet, not for an unrelated reason.
        </instruction>
      </instructions>

      <gate>
        <criteria>New tests fail for the correct reason: the requirement is not yet implemented. No unrelated failures.</criteria>
        <on-fail goto="red-phase">
          <reason>Tests did not fail as expected. Either they pass prematurely or fail for unrelated reasons.</reason>
          <action>Send the tests back to the Red Agent to refine.</action>
        </on-fail>
      </gate>
    </step>

    <step number="3" id="green-phase">
      <prerequisite ref="red-validation" goto="red-validation">Tests must be validated as correctly failing before implementation begins. If not, return to red-validation.</prerequisite>

      <goal>Delegate implementation to the Green Agent to satisfy the failing tests with minimal code.</goal>

      <instruction>
        <constraint>Minimal implementation only — do not add extra features beyond what the failing tests require.</constraint>
        Delegate to the Green Agent with the failing tests as context.
        <action actor="green-agent">Implement the minimum change needed to make the failing tests pass. Do not add extra features.</action>
      </instruction>

      <gate>
        <criteria>The Green Agent has produced an implementation targeting the failing tests.</criteria>
        <on-fail retry="true" max="2" then="deadlock-recovery">Green Agent failed to produce an implementation.</on-fail>
      </gate>
    </step>

    <step number="4" id="green-validation" uses="todo-md">
      <prerequisite ref="green-phase" goto="green-phase">Implementation must be delivered before validation. If not, return to green-phase.</prerequisite>

      <goal>Confirm all tests pass — both the new tests and the existing suite — with no regressions.</goal>

      <instructions>
        <instruction>
          <action>
            Run the full test suite.
            <command ref="run-tests" />
          </action>
        </instruction>
        <instruction>
          Confirm all tests pass, including existing suites. There must be no regressions.
        </instruction>
        <instruction>
          On success, mark the phase complete by ticking the checkbox in todo.md. Stage all changes.
          <action>
            <edit path="todo.md">Tick the checkbox for the completed requirement.</edit>
          </action>
        </instruction>
      </instructions>

      <gate>
        <criteria>All tests pass with no regressions. Changes are staged.</criteria>
        <on-pass goto="red-phase">Proceed to the next requirement and restart the TDD cycle.</on-pass>
        <on-fail goto="green-phase">
          <reason>Tests are failing or regressions detected.</reason>
          <action>Return to the Green Agent to fix the implementation.</action>
        </on-fail>
      </gate>
    </step>

    <step number="5" id="deadlock-recovery" uses="red-agent-config,green-agent-config">
      <goal>When a subagent fails the same task twice, halt the cycle and involve the developer to decide the next action.</goal>

      <instructions>
        <instruction>
          Explain to the developer what failed, what was attempted, and what evidence was observed (errors, test output summary).
          <action>
            <ask-user-question var="recovery_action" type="choice" actor="developer">
              A deadlock has been detected. How should we proceed?
              <option value="modify">Modify the approach</option>
              <option value="update-agents">Update agent instructions</option>
              <option value="intervene">Manually intervene</option>
              <option value="skip">Skip the problematic step</option>
            </ask-user-question>
          </action>
        </instruction>
        <instruction>
          <conditional on="{{ recovery_action }}">
            <case value="update-agents">
              <action>
                Update agent configuration files to prevent recurrence. Document what was learned and why the change improves behavior.
                <edit path=".claude/agents/red-agent.md">Refine instructions, constraints, and workflow details based on the failure.</edit>
                <edit path=".claude/agents/green-agent.md">Refine instructions, constraints, and workflow details based on the failure.</edit>
              </action>
            </case>
            <case value="intervene">
              <action>
                <ask-user-question actor="developer">Please describe the manual intervention or provide corrected code.</ask-user-question>
              </action>
            </case>
            <case value="skip">
              <action>Mark the problematic requirement as skipped and prepare to move on.</action>
            </case>
            <default>
              <action>Adjust the approach based on the developer's guidance.</action>
            </default>
          </conditional>
        </instruction>
      </instructions>

      <gate>
        <criteria>The developer's chosen recovery action has been applied.</criteria>
        <on-pass goto="red-phase">Resume the TDD cycle.</on-pass>
        <on-fail halt="true">Unable to recover from deadlock.</on-fail>
      </gate>
    </step>

  </steps>

  <principles>
    <principle name="Orchestration-only">The main agent coordinates — it never writes tests or production code itself.</principle>
    <principle name="Red-Green discipline">Every requirement passes through failing tests (Red) before implementation (Green). No shortcuts.</principle>
    <principle name="Deadlock awareness">If a subagent fails the same task twice, stop immediately and involve the user rather than looping endlessly.</principle>
    <principle name="Continuous improvement">When agent behavior is unexpected, update agent configuration files and orchestration rules, then document what was learned.</principle>
  </principles>

</ape>
