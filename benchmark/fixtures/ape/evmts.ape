<?xml version="1.0" encoding="UTF-8"?>
<ape version="0.2.2" xmlns="https://ape-lang.dev/schema/0">

  <meta>
    <name>Mission-Critical TDD Workflow</name>
    <description>A zero-tolerance, TDD-first workflow for mission-critical infrastructure. Defensive by default: no broken builds, no stubs, no swallowed errors, no placeholders. Every change follows a strict red-green-verify loop from the repository root.</description>
  </meta>

  <constraint>NEVER proceed with broken builds or failing tests.</constraint>
  <constraint>NEVER use stub or placeholder implementations (raise NotImplementedError, throw new Error("not implemented"), "Coming soon", dummy outputs, or any fallback that pretends to work).</constraint>
  <constraint>NEVER leave commented-out code — use Git history instead.</constraint>
  <constraint>NEVER skip or comment out tests.</constraint>
  <constraint>NEVER swallow errors (empty catch blocks, bare except: pass, rescue => nil).</constraint>
  <constraint>If you cannot implement something correctly, STOP and ask for help rather than stubbing.</constraint>

  <constraint>ALWAYS run commands from the repository root directory.</constraint>
  <constraint>NEVER use "cd" unless explicitly debugging a submodule.</constraint>
  <constraint>When proposing a change in architecture or approach, present a proposal and wait for approval from the developer before implementing.</constraint>
  <constraint>If your plan fails or you hit uncertainty, STOP, explain what happened and what you learned, and wait for guidance from the developer.</constraint>

  <rules>
    <rule>Prefer minimal "else" statements in control flow.</rule>
    <rule>Use descriptive variable names (top, value, operand — not a, b).</rule>
    <rule>Use direct imports; no aliases.</rule>
    <rule>Assertions must include descriptive messages.</rule>
    <rule>Always pair resource acquisition with cleanup or release.</rule>
  </rules>

  <rules>
    <rule>Tests must be self-contained: no abstractions for test setup, no helper functions; copy/paste setup is preferred.</rule>
    <rule>Always print test results.</rule>
    <rule>Only failed tests should produce output; if tests produce no output, they passed.</rule>
    <rule>Any test failure must be fixed immediately before continuing.</rule>
  </rules>

  <rules>
    <rule>If a bug is not obvious, improve visibility first (instrumentation, logs, asserts, targeted prints) before changing logic.</rule>
    <rule>Use evidence-based debugging only: form a hypothesis, add observability to validate it, confirm with test output, then fix and re-run.</rule>
  </rules>

  <anti-patterns>
    <anti-pattern>Changing logic before understanding the root cause.</anti-pattern>
    <anti-pattern>Debugging without a hypothesis.</anti-pattern>
  </anti-patterns>

  <steps>

    <step number="1" id="security-check">
      <title>Security and Safety Gate</title>
      <goal>Ensure no sensitive data is present and establish crash-handling policy before touching any code.</goal>

      <instructions>
        <instruction>
          Scan the prompt and any referenced inputs for API keys, passwords, tokens, or other sensitive data.

          <conditional on="{{ sensitive_data_detected }}">
            <case value="true">
              <stop>Sensitive data detected. Aborting. Explain what was found and request a sanitized prompt before continuing.</stop>
            </case>
            <case value="false">
              <action>No sensitive data detected. Proceed.</action>
            </case>
          </conditional>
        </instruction>
        <instruction>
          <constraint>Any unhandled crash is a severe bug. The application must return errors gracefully and must never crash.</constraint>
          <constraint>If a crash occurs: FIRST fix the validation or error-handling path that allowed the crash, THEN fix the bug that originally triggered it.</constraint>
        </instruction>
      </instructions>

      <gate>
        <criteria>No sensitive data is present in the prompt or inputs, and crash-handling policy is acknowledged.</criteria>
        <on-fail halt="true">Sensitive data detected or safety preconditions not met. Cannot proceed.</on-fail>
      </gate>
    </step>

    <step number="2" id="specify">
      <prerequisite ref="security-check" goto="security-check">Security gate must pass before any code changes. If not, return to security-check.</prerequisite>
      <title>Specify (Tests First)</title>
      <goal>Define the intended behavior by writing or updating tests before any implementation.</goal>

      <instruction>
        <constraint>Prefer direct, explicit setup in tests.</constraint>
        Write or update tests that define the intended behavior for this change (feature, refactor, or bug fix). Tests are the contract.
      </instruction>

      <gate>
        <criteria>New or updated tests exist that specify the intended behavior for the current change.</criteria>
        <on-fail retry="true" max="2" then="halt">Tests not written or do not specify new behavior. Write the tests first.</on-fail>
      </gate>
    </step>

    <step number="3" id="prove-failure">
      <prerequisite ref="specify" goto="specify">Tests must be written before proving failure. If not, return to specify.</prerequisite>
      <title>Prove Tests Fail</title>
      <goal>Confirm new or changed tests fail for the right reason before implementing, ensuring they actually specify new behavior.</goal>

      <instruction>
        <action>Run the tests from the repository root. Confirm the new or changed tests FAIL before implementing.</action>
        <note>If they pass unexpectedly, the test is not specifying new behavior — fix the test.</note>
      </instruction>

      <gate>
        <criteria>New or changed tests fail, and they fail for the expected reason (missing functionality, not a test error).</criteria>
        <on-fail goto="specify">Tests passed unexpectedly or failed for the wrong reason. Return to specification and fix the tests.</on-fail>
      </gate>
    </step>

    <step number="4" id="implement">
      <prerequisite ref="prove-failure" goto="prove-failure">Tests must be proven to fail before implementation begins. If not, return to prove-failure.</prerequisite>
      <goal>Implement the behavior completely with no placeholders, no stubs, and no swallowed errors.</goal>

      <instruction>
        <constraint>Do not add stubs or "temporary" implementations.</constraint>
        <constraint>Do not ignore errors — every error must be handled explicitly or propagated.</constraint>
        <constraint>Always pair resource acquisition with cleanup or release.</constraint>
        Implement the behavior completely to make the failing tests pass.
      </instruction>

      <gate>
        <criteria>Implementation is complete with no stubs, no placeholder code, no swallowed errors, and all resource acquisitions paired with cleanup.</criteria>
        <on-fail retry="true" max="3" then="halt">Implementation contains stubs, placeholders, or swallowed errors. Fix before proceeding.</on-fail>
      </gate>
    </step>

    <step number="5" id="verify">
      <prerequisite ref="implement" goto="implement">Implementation must be complete before verification. If not, return to implement.</prerequisite>
      <title>Verify Build and Tests</title>
      <goal>Confirm the build succeeds and all tests pass from the repository root before considering work done.</goal>

      <instruction>
        Run the build and the full test suite from the repository root. Do not consider work done until build and tests are green.
        <note>Exception: documentation-only .md changes may skip build and test verification, but must not introduce code changes.</note>
      </instruction>

      <gate>
        <criteria>Build succeeds and all tests pass from the repository root.</criteria>
        <on-pass goto="specify">Build and tests green. Begin the next change cycle.</on-pass>
        <on-fail goto="implement">Build or tests failing. Fix immediately — this is top priority. Stop new work, fix the failure, and re-verify.</on-fail>
      </gate>
    </step>

  </steps>

  <principles>
    <principle name="Zero Tolerance">No broken builds, no stubs, no swallowed errors, no placeholders. If you cannot implement it correctly, stop and ask.</principle>
    <principle name="TDD First">Tests define the contract. Write them first, prove they fail, then implement.</principle>
    <principle name="Evidence-Based">Debug with hypotheses and observability, not guesswork. Improve visibility before changing logic.</principle>
    <principle name="Defensive">This is mission-critical infrastructure where mistakes cause business loss. Default to caution.</principle>
  </principles>

</ape>
